\input regression-test
\documentclass[standalone,doctype=script,lang=de]{osglecture}
\begin{document}
\START
\begin{presitemize}
  \longform{\TYPE{de-longform=true}}
  \slides{\TYPE{de-slides=true}}
  \item Die Übersetzung \finite{funktioniert}
  \anditem Das Programm \finite{liefert} das Ergebnis
  \butitem Wir \finite{haben} etwas geschummelt
  \thereforeitem Wir \finite{müssen}
    % \finite prints nothing when it defers the verb, so the list must show
    % exactly one glue (space) here, not two: one from before the call and
    % one from after, landing back to back. Read from the actual node list
    % rather than a typeset width, since box measurements taken mid-item
    % (while the item body is still being replayed for case-adjustment)
    % have proven unreliable for this.
    \directlua{
      local tail = nil
      for x in node.traverse(tex.nest[tex.nest.ptr].head) do tail = x end
      local kinds = {}
      local cur = tail
      for i = 1, 2 do
        if cur == nil then break end
        table.insert(kinds, 1, node.type(cur.id))
        cur = node.prev(cur)
      end
      tex.sprint("\\TYPE{finite-tail-nodes=" .. table.concat(kinds, ",") .. "}")
    }
    \ExplSyntaxOn
    \TYPE{de-language=\tl_use:N\l__osglecture_pres_language_tl}
    \TYPE{de-relation=\tl_use:N\l__osglecture_pres_relation_tl}
    \TYPE{de-finite=\tl_use:N\l__osglecture_pres_finite_tl}
    \ExplSyntaxOff
    den Text untersuchen
  \commaitem weitere Daten \finite{folgen}
  \colonitem ein Beispiel \finite{genügt}
\end{presitemize}
\begin{presitemize}[language=en]
  \presitem[relation=sentence,initial=keep]
    \TYPE{key-sentence-body=true}The translation \finite{works}
  \presitem[relation=and] The program \finite{delivers} the result
  \presitem[relation=comma] more data \finite{follows}
  \presitem[relation=colon] one example \finite{suffices}
  \presitem[relation=therefore] We \finite{must}
    \ExplSyntaxOn
    \TYPE{en-language=\tl_use:N\l__osglecture_pres_language_tl}
    \TYPE{en-relation=\tl_use:N\l__osglecture_pres_relation_tl}
    \tl_if_empty:NTF \l__osglecture_pres_finite_tl
      {\TYPE{en-finite=inplace}}
      {\TYPE{en-finite=stored}}
    \ExplSyntaxOff
    inspect the text
\end{presitemize}
\begin{presitemize}[language=fr,punctuation=manual]
  \presitem[relation=sentence] La traduction fonctionne.
  \presitem[relation=but,initial=keep]
    \TYPE{key-keep-body=true}Mais le texte reste lisible.
  \ExplSyntaxOn
  \TYPE{fr-language=\tl_use:N\l__osglecture_pres_language_tl}
  \bool_if:NTF \l__osglecture_pres_auto_punctuation_bool
    {\TYPE{fr-punctuation=auto}}
    {\TYPE{fr-punctuation=manual}}
  \ExplSyntaxOff
\end{presitemize}
\END
\end{document}
