    \iow_term:e
      {
        TAG~#1 = \seq_item:Nn \g__tag_struct_tag_stack_seq { 1 }
        ~in~ \seq_item:Nn \g__tag_struct_tag_stack_seq { 2 }
      }
  }
\ExplSyntaxOff
