  {
    \__olref_target_set:nnn {#2}{#3}{ref}
    \IfBooleanTF{#1}
      { \exp_args:NV \__olref_ref_star:n \l__olref_label_tl }
      { \exp_args:NV \__olref_ref:n \l__olref_label_tl }
