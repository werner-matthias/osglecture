\ProvidesFile{osglecture-profile-beamer.def}
  [2026/07/29 v0.1.0 osglecture Beamer profile]
\DeclareOsgLectureProfile{beamer}
  {
    backend = beamer,
    capabilities = {presentation,print},
    class = beamer,
    document-metadata = forbidden,
    doctypes = {slides,handout},
    course-target = subtitle,
    event-target = subtitle
  }
\DeclareOsgLectureProfileClassOptions{beamer}{handout}{handout}
