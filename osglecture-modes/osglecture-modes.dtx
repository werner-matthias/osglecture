\msg_new:nnn { osglecture_modes_ltxtalk } { unknown-filter-profile }
  { Unknown~ltxtalk~filter~profile~'#1'. }
\msg_new:nnn { osglecture_modes_ltxtalk } { filter-profile-unknown-parent }
  { Filter~profile~'#1'~has~unknown~parent~'#2'. }
\msg_new:nnn { osglecture_modes_ltxtalk } { filter-profile-cycle }
  { Filter~profile~parent~cycle~detected~at~'#1'. }
\msg_new:nnn { osglecture_modes_ltxtalk } { conflicting-filter-profiles }
  { Active~leaf~modes~select~both~filter~profile~'#1'~and~'#2'. }

