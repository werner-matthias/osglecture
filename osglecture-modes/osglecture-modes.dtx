        \osglecture_modes_spec_if_native_shape:nTF {#1}
          { \clist_put_right:Nn \l_osglecture_modes_spec_parts_clist {#1} }
          { \bool_set_false:N \l_osglecture_modes_spec_qual_bool }
      }
  }

\cs_new_protected:Npn \osglecture_modes_spec_segment_colon:n #1
  {
    \seq_set_split:NVn \l_osglecture_modes_spec_colon_seq \c_colon_str {#1}
    \seq_pop_left:NN \l_osglecture_modes_spec_colon_seq
      \l_osglecture_modes_spec_mode_tl
    \tl_set:Nx \l_osglecture_modes_spec_rest_tl
      { \seq_use:NV \l_osglecture_modes_spec_colon_seq \c_colon_str }
    \tl_trim_spaces:N \l_osglecture_modes_spec_mode_tl
    \tl_trim_spaces:N \l_osglecture_modes_spec_rest_tl
    \osglecture_modes_resolve:VN \l_osglecture_modes_spec_mode_tl
      \l_osglecture_modes_spec_resolved_tl
    \seq_if_in:NVTF \g_osglecture_modes_known_seq
      \l_osglecture_modes_spec_resolved_tl
      {
        \osglecture_modes_if_active:VT \l_osglecture_modes_spec_resolved_tl
          {
            \clist_put_right:NV \l_osglecture_modes_spec_parts_clist
              \l_osglecture_modes_spec_rest_tl
          }
      }
      { \bool_set_false:N \l_osglecture_modes_spec_qual_bool }
  }

\cs_new_protected:Npn \osglecture_modes_spec_segment:n #1
  {
    \bool_if:NT \l_osglecture_modes_spec_qual_bool
      {
        \tl_set:Nn \l_osglecture_modes_spec_mode_tl {#1}
        \tl_trim_spaces:N \l_osglecture_modes_spec_mode_tl
        \tl_if_empty:NF \l_osglecture_modes_spec_mode_tl
          {
            \exp_args:NV \str_if_in:nnTF \l_osglecture_modes_spec_mode_tl { : }
              {
                \exp_args:NV \osglecture_modes_spec_segment_colon:n
                  \l_osglecture_modes_spec_mode_tl
              }
              {
                \exp_args:NV \osglecture_modes_spec_segment_bare:n
                  \l_osglecture_modes_spec_mode_tl
              }
          }
      }
  }

\cs_new_protected:Npn \osglecture_modes_classify:n #1
  {
    \tl_clear:N \l_osglecture_modes_native_tl
    \osglecture_modes_spec_if_portable:nTF {#1}
      {
        \osglecture_modes_if_active:nTF {#1}
          { \tl_set:Nn \l_osglecture_modes_action_tl { show } }
          { \tl_set:Nn \l_osglecture_modes_action_tl { hide } }
      }
      {
        \bool_set_true:N \l_osglecture_modes_spec_qual_bool
        \clist_clear:N \l_osglecture_modes_spec_parts_clist
        \seq_set_split:Nnn \l_osglecture_modes_spec_segs_seq { | } {#1}
        \seq_map_inline:Nn \l_osglecture_modes_spec_segs_seq
          { \osglecture_modes_spec_segment:n {##1} }
        \bool_if:NTF \l_osglecture_modes_spec_qual_bool
          {
            \clist_if_empty:NTF \l_osglecture_modes_spec_parts_clist
              { \tl_set:Nn \l_osglecture_modes_action_tl { hide } }
              {
                \tl_set:Nn \l_osglecture_modes_action_tl { native }
                \tl_set:Nx \l_osglecture_modes_native_tl
                  { \clist_use:Nn \l_osglecture_modes_spec_parts_clist { , } }
              }
          }
          {
            \tl_set:Nn \l_osglecture_modes_action_tl { native }
            \tl_set:Nn \l_osglecture_modes_native_tl {#1}
          }
      }
  }

% Content shows unless a portable expression is present and evaluates false;
% a native or unrecognised specification degrades to "show" where no overlay
% backend can honour it.
\prg_new_protected_conditional:Npnn \osglecture_modes_if_reveal:n #1
  { T, F, TF }
  {
    \osglecture_modes_classify:n {#1}
    \str_if_eq:VnTF \l_osglecture_modes_action_tl { hide }
      { \prg_return_false: } { \prg_return_true: }
  }

% Defaults describe semantics, not a backend choice.
\DeclareLectureMode{presentation}
\DeclareLectureMode[parents=presentation]{beamer}
\DeclareLectureMode[parents=presentation]{projector}
\DeclareLectureMode[parents={presentation,print}]{handout}
\DeclareLectureMode[parents=presentation]{trans}
\DeclareLectureMode{longform}
\DeclareLectureMode[parents={longform,print}]{article}
\DeclareLectureMode[parents=article]{script}
\DeclareLectureMode{print}
\DeclareLectureMode[parents=longform]{web}
\DeclareLectureModeAlias{slides}{projector}

% Resolve the compatibility option, so metadata in the preamble sees the
% selected mode. osglecture should pass an explicit leaf mode. Deferred: a
% class doing its own leaf resolution before \LoadClass skips this entirely.
\cs_new_protected:Npn \__osglecture_modes_resolve_leaf:
  {
\tl_if_eq:NnTF \g_osglecture_modes_option_mode_tl {auto}
  {
    \@ifclassloaded{beamer}
      {
        \str_if_eq:eeTF { \use:c { beamer@currentmode } } {handout}
          {
          \SetLectureModes{handout,beamer}
          }
          { \SetLectureModes{slides,beamer} }
      }
      {
        \@ifclassloaded{ltx-talk}
          {
            \cs_if_exist:NTF \l__talk_mode_str
              {
                \str_case:VnF \l__talk_mode_str
                  {
                    { handout }  { \SetLectureModes{handout} }
                    { article }  { \SetLectureModes{article} }
                    { projector }{ \SetLectureModes{slides} }
                  }
                  {
                    \seq_if_in:NVTF \g_osglecture_modes_known_seq \l__talk_mode_str
                      { \exp_args:NV \SetLectureModes \l__talk_mode_str }
                      { \SetLectureModes{slides} }
                  }
              }
              { \SetLectureModes{slides} }
          }
          { \SetLectureModes{article} }
      }
  }
  { \exp_args:NV \SetLectureModes \g_osglecture_modes_option_mode_tl }
  }

% Wire portable mode expressions into the loaded overlay backend. Needs the
% base class present, so a deferred load runs this from
% \LectureModesActivateOverlays after \LoadClass rather than now. The body is
% kept in a separate file so its command-parameter tokens are not reparsed
% one nesting level too deep inside a wrapper definition.
\cs_new_protected:Npn \__osglecture_modes_patch_overlays:
  { \file_input:n { osglecture-modes-overlays.code.tex } }
\NewDocumentCommand \LectureModesActivateOverlays { }
  { \__osglecture_modes_patch_overlays: }

% A normal \usepackage load happens after \documentclass, so the base class
% is already present: resolve and patch straight away. A deferred load waits
% for the class to call \LectureModesActivateOverlays.
\bool_if:NF \g_osglecture_modes_deferred_bool
  {
    \__osglecture_modes_resolve_leaf:
    \__osglecture_modes_patch_overlays:
  }

\AddToHook{begindocument/before}{\osglecture_modes_finalize_commands:}
%</package>

%<*overlays>
% Wired into the loaded overlay backend by
% \__osglecture_modes_patch_overlays:; runs in expl3 syntax provided by its
% caller.
% Let the native overlay decoders recognize a pure portable mode expression.
% Everything else, especially mixed mode/overlay syntax, remains untouched.
\bool_if:NT \g_osglecture_modes_patch_overlays_bool
  {
    \cs_if_exist:NT \beamer@masterdecode
      {
        \cs_new_eq:NN \osglecture_modes_native_beamer_masterdecode
          \beamer@masterdecode
        \cs_set_protected:Npn \beamer@masterdecode #1
          {
            \osglecture_modes_classify:n {#1}
            \str_case:Vn \l_osglecture_modes_action_tl
              {
                { show } { \osglecture_modes_native_beamer_masterdecode {all} }
                { hide } { \osglecture_modes_native_beamer_masterdecode {0} }
                { native }
                  {
                    \exp_args:NV \osglecture_modes_native_beamer_masterdecode
                      \l_osglecture_modes_native_tl
                  }
              }
          }
      }
    \cs_if_exist:NT \__talk_decode_parse:n
      {
        \cs_new_eq:NN \osglecture_modes_native_talk_decode_parse:n
          \__talk_decode_parse:n
        \cs_set_protected:Npn \__talk_decode_parse:n #1
          {
            \osglecture_modes_classify:n {#1}
            \str_case:Vn \l_osglecture_modes_action_tl
              {
                { show }
                  { \osglecture_modes_native_talk_decode_parse:n {all} }
                { hide }
                  {
                    \str_if_eq:VnTF \l__talk_mode_str {article}
                      { \osglecture_modes_native_talk_decode_parse:n {projector} }
                      { \osglecture_modes_native_talk_decode_parse:n {article} }
                  }
                { native }
                  {
                    \exp_args:NV \osglecture_modes_native_talk_decode_parse:n
                      \l_osglecture_modes_native_tl
                  }
              }
          }
      }
  }

% Add portable inline modes to an existing backend without taking over its
% switching syntax or unknown/complex overlay specifications.
\cs_if_exist:NTF \mode
  {
    \bool_if:NT \g_osglecture_modes_patch_overlays_bool
      {
        \cs_new_eq:NN \osglecture_modes_native_mode \mode
        \RenewDocumentCommand \mode { s d<> }
          {
            \IfBooleanTF {#1}
              { \osglecture_modes_native_mode * }
              {
                \IfNoValueTF {#2}
                  { \osglecture_modes_native_mode }
                  {
                    \peek_meaning:NTF \c_group_begin_token
                      { \osglecture_modes_mode_inline:n {#2} }
                      { \osglecture_modes_native_mode <#2> }
                  }
              }
          }
        \cs_new_protected:Npn \osglecture_modes_mode_native:nn #1#2
          { \osglecture_modes_native_mode <#1> {#2} }
        \cs_new_protected:Npn \osglecture_modes_mode_inline:n #1#2
          {
            \osglecture_modes_classify:n {#1}
            \str_case:Vn \l_osglecture_modes_action_tl
              {
                { show } {#2}
                { hide } { }
                { native }
                  {
                    \exp_args:NV \osglecture_modes_mode_native:nn
                      \l_osglecture_modes_native_tl {#2}
                  }
              }
          }
      }
  }
  {
    \NewDocumentCommand \mode { d<> +m }
      {
        \IfNoValueTF {#1}
          {#2}
          { \osglecture_modes_if_reveal:nT {#1} {#2} }
      }
  }

% \cs{only} is implemented specially by both beamer and ltx-talk and does not
% pass through their common overlay decoders in every case, so it needs its
% own adapter rather than sharing \cs{mode}'s. Mirrors \cs{mode}'s two-branch
% shape above: where \cs{only} already exists (beamer, ltx-talk), bind it
% through the signature-aware adapter so portable modes are handled directly
% while native overlay specifications are delegated unchanged; where it does
% not exist (article, scrbook, book, ...), define a portable-only \cs{only}
% so shared source can still use it.
\cs_if_exist:NTF \only
  {
    \bool_if:NT \g_osglecture_modes_patch_overlays_bool
      { \MakeOverlayAwareCommand[arguments={+m}]{\only} }
  }
  {
    \NewDocumentCommand \only { d<> +m }
      {
        \IfNoValueTF {#1}
          {#2}
          { \osglecture_modes_if_reveal:nT {#1} {#2} }
      }
  }

% Unlike \cs{only} and \cs{mode}, \cs{uncover}, \cs{visible}, \cs{onslide},
% \cs{invisible}, and \cs{alt} route through beamer's and ltx-talk's common
% overlay decoders (patched above), so a portable mode spec already reaches
% them correctly there without adapting each command individually --
% \cs{alt} additionally serves as the decoder fallback's own native-spec
% judge just below, so wrapping it here would make that judge call back
% into itself. Only a base class that lacks the command natively (article,
% scrbook, book, ...) needs a portable-only definition.
\cs_if_exist:NF \uncover
  {
    \NewDocumentCommand \uncover { d<> +m }
      {
        \IfNoValueTF {#1}
          {#2}
          { \osglecture_modes_if_reveal:nT {#1} {#2} }
      }
  }
\cs_if_exist:NF \visible
  {
    \NewDocumentCommand \visible { d<> +m }
      {
        \IfNoValueTF {#1}
          {#2}
          { \osglecture_modes_if_reveal:nT {#1} {#2} }
      }
  }
\cs_if_exist:NF \onslide
  {
    \NewDocumentCommand \onslide { d<> +m }
      {
        \IfNoValueTF {#1}
          {#2}
          { \osglecture_modes_if_reveal:nT {#1} {#2} }
      }
  }

% \cs{invisible} inverts the polarity: content shows everywhere except in
% the given mode.  A native or unrecognised specification degrades to
% "show" like the positive commands.
\cs_if_exist:NF \invisible
  {
    \NewDocumentCommand \invisible { d<> +m }
      {
        \IfNoValueTF {#1}
          {#2}
          {
            \osglecture_modes_classify:n {#1}
            \str_if_eq:VnF \l_osglecture_modes_action_tl { show } {#2}
          }
      }
  }

% \cs{alt} takes two content arguments (active branch, inactive branch)
% instead of \cs{only}'s single one; the fallback mirrors that shape and
% treats a native or unrecognised specification as the active branch.
\cs_if_exist:NF \alt
  {
    \NewDocumentCommand \alt { d<> +m +m }
      {
        \IfNoValueTF {#1}
          {#2}
          {
            \osglecture_modes_classify:n {#1}
            \str_if_eq:VnTF \l_osglecture_modes_action_tl { hide } {#3} {#2}
          }
      }
  }

% \cs{pause} marks a live-reveal point with no content to select, and
% \cs{temporal}'s before/during/after split assumes an ordered overlay
% range, which named portable modes do not have -- neither maps onto
% content selection by mode the way the commands above do. Base classes
% without their own \cs{pause}/\cs{temporal} still get a definition so
% shared source compiles: \cs{pause} does nothing, and \cs{temporal}
% always shows its "`during"' argument, the state a static, non-overlay
% rendering settles on.
\cs_if_exist:NF \pause
  { \NewDocumentCommand \pause { O{} } { } }
\cs_if_exist:NF \temporal
  { \NewDocumentCommand \temporal { d<> +m +m +m } {#3} }
%</overlays>

%<*ltxtalk>
\ProvidesExplPackage{osglecture-modes-ltxtalk}
{2026-08-02}
{v0.4.0}
{ltx-talk adapter with ignore-non-frame-text}

\RequirePackage{osglecture-modes}

\ExplSyntaxOn

\bool_new:N  \g_osglecture_modes_ltxtalk_ignore_bool
\bool_new:N  \g_osglecture_modes_ltxtalk_scanner_active_bool
\bool_new:N  \g_osglecture_modes_ltxtalk_after_structure_bool
\clist_new:N \g_osglecture_modes_ltxtalk_raw_skip_envs_clist
\clist_new:N \g_osglecture_modes_ltxtalk_keep_envs_clist
\clist_new:N \g_osglecture_modes_ltxtalk_hooked_envs_clist

\msg_new:nnn { osglecture_modes_ltxtalk } { unknown-environment }
  { Environment~'#1'~is~not~defined. }

\clist_gset:Nn \g_osglecture_modes_ltxtalk_raw_skip_envs_clist
  {
    verbatim,
    Verbatim,
    lstlisting,
    minted,
    comment
  }

\keys_define:nn { osglecture_modes_ltxtalk }
  {
    mode .code:n =
      { \SetLectureModes{#1} },

    ignorenonframetext .bool_gset:N =
      \g_osglecture_modes_ltxtalk_ignore_bool,

    ignorenonframetext .default:n = true,

    raw-skip-envs .clist_gset:N =
      \g_osglecture_modes_ltxtalk_raw_skip_envs_clist,
  }

\ProcessKeyOptions [ osglecture_modes_ltxtalk ]

\sys_if_engine_luatex:TF
  {
    \directlua{require("osglecture-modes-ltxtalk.lua")}
  }
  {
    \bool_if:NT \g_osglecture_modes_ltxtalk_ignore_bool
      {
        \PackageWarning
          {osglecture_modes_ltxtalk}
          {ignorenonframetext with raw-skip support needs LuaLaTeX}
      }
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_lua_raw_skip:n #1
  {
    \sys_if_engine_luatex:T
      {
        \directlua{
          osglecture_modes_ltxtalk.start_raw_skip("\luaescapestring{#1}")
        }
      }
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_peek_if_exist:NTF #1#2#3
  {
    \cs_if_exist:NTF #1
      { \peek_meaning_remove:NTF #1 {#2} {#3} }
      {#3}
  }
  
% With no filter profile ever selected for the active leaf modes, this is
% exactly the original trigger: scan only under "presentation". A selected
% profile (see \cs{osglecture_modes_ltxtalk_apply_profile:} further below)
% overrides that -- scanning then also engages for document types (e.g. an
% exam target) that have nothing to do with "presentation" at all.
\cs_new_protected:Npn \osglecture_modes_ltxtalk_start_scan:
  {
    \bool_if:NT \g_osglecture_modes_ltxtalk_ignore_bool
    {
      \bool_if:NT \g_osglecture_modes_ltxtalk_scanner_active_bool
        {
          \osglecture_modes_ltxtalk_apply_profile:
          \tl_if_empty:NTF \l_osglecture_modes_ltxtalk_selected_profile_tl
            { \osglecture_modes_if_active:nT { presentation }
                { \osglecture_modes_ltxtalk_scan: } }
            { \osglecture_modes_ltxtalk_scan: }
        }
      }
  }

% Explicit spaces are stripped here, once, before any peek: an undelimited
% parameter (which is how every peeked branch below ultimately grabs its
% token) skips leading spaces on its own, so a space reaching one of those
% branches unstripped would vanish together with the unrelated token after
% it, silently dropping whatever follows a line break.
\cs_new_protected:Npn \osglecture_modes_ltxtalk_scan:
  {
    \peek_remove_spaces:n
      {
        \peek_meaning:NTF \begin
          { \osglecture_modes_ltxtalk_scan_begin: }
          {
            \peek_meaning:NTF \end
              { \osglecture_modes_ltxtalk_scan_end: }
              { \osglecture_modes_ltxtalk_scan_token: }
          }
      }
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_scan_begin:
  {
    \peek_meaning_remove:NT \begin
    \osglecture_modes_ltxtalk_scan_begin_aux:n
  }

  
\cs_new_protected:Npn \osglecture_modes_ltxtalk_scan_begin_aux:n #1
  {
    \clist_if_in:NnTF \g_osglecture_modes_ltxtalk_keep_envs_clist {#1}
      {
        \begin{#1}
      }
      {
        \clist_if_in:NnTF \g_osglecture_modes_ltxtalk_raw_skip_envs_clist {#1}
          {
            \osglecture_modes_ltxtalk_lua_raw_skip:n {#1}
            \osglecture_modes_ltxtalk_scan:
          }
          {
            \osglecture_modes_ltxtalk_skip_environment:n {#1}
            \osglecture_modes_ltxtalk_scan:
          }
      }
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_scan_end:
  {
    \peek_meaning_remove:NT \end
    \osglecture_modes_ltxtalk_scan_end_aux:n
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_scan_end_aux:n #1
  {
    \str_if_eq:nnTF {#1} {document}
      {
        \end{document}
      }
      {
        % fremdes \cs{end}\code{\{...\}} außerhalb von frames ignorieren
        \osglecture_modes_ltxtalk_scan:
      }
  }
  
\cs_new_protected:Npn \osglecture_modes_ltxtalk_skip_environment:n #1
  {
    \cs_set_protected:Npn \osglecture_modes_ltxtalk_skip:w ##1 \end ##2
      {
        \str_if_eq:nnF {#1} {##2}
          { \osglecture_modes_ltxtalk_skip:w }
      }
    \osglecture_modes_ltxtalk_skip:w
  }

% A "kept" environment is entered normally; the closing \cs{end} therefore
% reaches the base class unchanged, and only the hook below re-arms the
% scanner for what follows. The hook is registered once per environment
% name, independently of any filter profile, since the same environment
% may end up listed in several profiles. \cs{frame} and \cs{frame*} are
% declared as baseline defaults below; project-specific environments (a
% task environment, a title page, ...) register through the same
% mechanism, either unconditionally (baseline, always kept) or scoped to
% a single filter profile (kept only while that profile is selected; see
% \cs{DeclareLtxtalkFilterProfile} further below).
\cs_new_protected:Npn \osglecture_modes_ltxtalk_ensure_env_hook:n #1
  {
    \cs_if_exist:cTF {#1}
      {
        \clist_if_in:NnF \g_osglecture_modes_ltxtalk_hooked_envs_clist {#1}
          {
            \clist_gput_right:Nn \g_osglecture_modes_ltxtalk_hooked_envs_clist {#1}
            \AddToHook{env/#1/after}{ \osglecture_modes_ltxtalk_start_scan: }
          }
      }
      { \msg_error:nnn { osglecture_modes_ltxtalk } { unknown-environment } {#1} }
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_declare_keep_environment:nn #1#2
  {
    \osglecture_modes_ltxtalk_ensure_env_hook:n {#1}
    \tl_if_empty:nTF {#2}
      {
        \clist_if_in:NnF \g_osglecture_modes_ltxtalk_keep_envs_clist {#1}
          { \clist_gput_right:Nn \g_osglecture_modes_ltxtalk_keep_envs_clist {#1} }
      }
      {
        \seq_if_in:NnTF \g_osglecture_modes_ltxtalk_profile_known_seq {#2}
          {
            \osglecture_modes_ltxtalk_profile_if_mutable:nTF {#2}
              { \clist_gput_right:cn { osglecture_modes_ltxtalk_profile_own_envs_ #2 _clist } {#1} }
              { }
          }
          { \msg_error:nnn { osglecture_modes_ltxtalk } { unknown-filter-profile } {#2} }
      }
  }
\cs_generate_variant:Nn \osglecture_modes_ltxtalk_declare_keep_environment:nn { nV }

\NewDocumentCommand \DeclareLtxtalkKeepEnvironment { O{} m }
  {
    \tl_clear:N \l_osglecture_modes_ltxtalk_keep_profile_tl
    \keys_set:nn { osglecture_modes_ltxtalk / keep } {#1}
    \clist_map_inline:nn {#2}
      {
        \osglecture_modes_ltxtalk_declare_keep_environment:nV
          {##1} \l_osglecture_modes_ltxtalk_keep_profile_tl
      }
  }

% \cs{frame}/\cs{frame*} come from the presentation class, not this
% package, so their absence (this adapter loaded without ltx-talk, or
% loaded before the class defines them) is silently tolerated here; a
% project-declared environment that is missing is still an error above.
\cs_if_exist:cT { frame }
