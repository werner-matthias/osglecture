\cs_generate_variant:Nn \clist_map_inline:Nn { c }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_profile_union_dispatch:nn #1#2
  { % copies #1(closed)'s effective dispatch entries into #2's effective dispatch
    \prop_map_inline:cn { osglecture_modes_ltxtalk_profile_eff_dispatch_ #1 _prop }
      { \prop_gput:cnn { osglecture_modes_ltxtalk_profile_eff_dispatch_ #2 _prop } {##1} {##2} }
  }
\cs_new_protected:Npn \osglecture_modes_ltxtalk_profile_union_envs:nn #1#2
  { % copies #1(closed)'s effective kept environments into #2's effective set
    \clist_map_inline:cn { osglecture_modes_ltxtalk_profile_eff_envs_ #1 _clist }
      { \clist_gput_right:cn { osglecture_modes_ltxtalk_profile_eff_envs_ #2 _clist } {##1} }
  }

\prop_new:N \l_osglecture_modes_ltxtalk_profile_visiting_prop
\prop_new:N \l_osglecture_modes_ltxtalk_profile_visited_prop

% Post-order DFS: every parent is fully closed (recursively) before its
% entries are unioned into the current profile, and the current profile's
% own entries are added last so they can shadow an inherited handler
% registered for the same command or environment name.
\cs_new_protected:Npn \osglecture_modes_ltxtalk_profile_visit:n #1
  {
    \prop_if_in:NnTF \l_osglecture_modes_ltxtalk_profile_visiting_prop {#1}
      { \msg_error:nnn { osglecture_modes_ltxtalk } { filter-profile-cycle } {#1} }
      {
        \prop_if_in:NnF \l_osglecture_modes_ltxtalk_profile_visited_prop {#1}
          {
            \prop_put:Nnn \l_osglecture_modes_ltxtalk_profile_visiting_prop {#1} { }
            \prop_get:NnNT \g_osglecture_modes_ltxtalk_profile_parents_prop {#1} \l_tmpa_tl
              {
                \clist_map_inline:Vn \l_tmpa_tl
                  {
                    \seq_if_in:NnTF \g_osglecture_modes_ltxtalk_profile_known_seq {##1}
                      {
                        \osglecture_modes_ltxtalk_profile_visit:n {##1}
                        \osglecture_modes_ltxtalk_profile_union_dispatch:nn {##1} {#1}
                        \osglecture_modes_ltxtalk_profile_union_envs:nn {##1} {#1}
                      }
                      {
                        \msg_error:nnnn { osglecture_modes_ltxtalk }
                          { filter-profile-unknown-parent } {#1} {##1}
                      }
                  }
              }
            \prop_map_inline:cn { osglecture_modes_ltxtalk_profile_own_dispatch_ #1 _prop }
              { \prop_gput:cnn { osglecture_modes_ltxtalk_profile_eff_dispatch_ #1 _prop } {##1} {##2} }
            \clist_map_inline:cn { osglecture_modes_ltxtalk_profile_own_envs_ #1 _clist }
              { \clist_gput_right:cn { osglecture_modes_ltxtalk_profile_eff_envs_ #1 _clist } {##1} }
            \clist_remove_duplicates:c { osglecture_modes_ltxtalk_profile_eff_envs_ #1 _clist }
            \prop_remove:Nn \l_osglecture_modes_ltxtalk_profile_visiting_prop {#1}
            \prop_put:Nnn \l_osglecture_modes_ltxtalk_profile_visited_prop {#1} { }
          }
      }
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_profile_finalize:
  {
    \bool_if:NF \g_osglecture_modes_ltxtalk_profile_frozen_bool
      {
        \prop_clear:N \l_osglecture_modes_ltxtalk_profile_visiting_prop
        \prop_clear:N \l_osglecture_modes_ltxtalk_profile_visited_prop
        \seq_map_inline:Nn \g_osglecture_modes_ltxtalk_profile_known_seq
          { \osglecture_modes_ltxtalk_profile_visit:n {##1} }
        \bool_gset_true:N \g_osglecture_modes_ltxtalk_profile_frozen_bool
      }
  }

\NewDocumentCommand \AssignLtxtalkFilterProfile { m m }
  {
    \seq_if_in:NnTF \g_osglecture_modes_ltxtalk_profile_known_seq {#2}
      {
        \osglecture_modes_ltxtalk_profile_if_mutable:nTF {#2}
          {
            \clist_map_inline:nn {#1}
              {
                \osglecture_modes_resolve:nN {##1} \l_tmpa_tl
                \seq_if_in:NVTF \g_osglecture_modes_known_seq \l_tmpa_tl
                  { \prop_gput:NVn \g_osglecture_modes_ltxtalk_mode_profile_prop \l_tmpa_tl {#2} }
                  { \msg_error:nnV { osglecture_modes } { unknown-mode } \l_tmpa_tl }
              }
          }
          { }
      }
      { \msg_error:nnn { osglecture_modes_ltxtalk } { unknown-filter-profile } {#2} }
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_select_profile:
  {
    \tl_clear:N \l_osglecture_modes_ltxtalk_selected_profile_tl
    \seq_map_inline:Nn \g_osglecture_modes_seed_seq
      {
