            \seq_if_in:NVF \g_osglecture_modes_known_seq \l_tmpb_tl
              { \bool_set_false:N \l_tmpa_bool }
          }
      }
    \bool_if:NTF \l_tmpa_bool
      { \prg_return_true: } { \prg_return_false: }
