\ProvidesExplPackage{osglecture-modes-ltxtalk}{2026-07-29}{0.1.0}
  {ltx-talk adapter with ignore-non-frame-text}

\RequirePackage{osglecture-modes}

\ExplSyntaxOn

\bool_new:N  \g_osglecture_modes_ltxtalk_ignore_bool
\bool_new:N  \g_osglecture_modes_ltxtalk_after_structure_bool
\clist_new:N \g_osglecture_modes_ltxtalk_raw_skip_envs_clist

\clist_gset:Nn \g_osglecture_modes_ltxtalk_raw_skip_envs_clist
  {
    verbatim,
    Verbatim,
    lstlisting,
    minted,
    comment
  }

\keys_define:nn { osglecture_modes_ltxtalk }
  {
    mode .code:n =
      { \SetLectureModes{#1} },

    ignorenonframetext .bool_gset:N =
      \g_osglecture_modes_ltxtalk_ignore_bool,

    ignorenonframetext .default:n = true,

    raw-skip-envs .clist_gset:N =
      \g_osglecture_modes_ltxtalk_raw_skip_envs_clist,
  }

\ProcessKeyOptions [ osglecture_modes_ltxtalk ]

\sys_if_engine_luatex:TF
  {
    \directlua{require("osglecture-modes-ltxtalk.lua")}
  }
  {
    \bool_if:NT \g_osglecture_modes_ltxtalk_ignore_bool
      {
        \PackageWarning
          {osglecture_modes_ltxtalk}
          {ignorenonframetext with raw-skip support needs LuaLaTeX}
      }
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_lua_raw_skip:n #1
  {
    \sys_if_engine_luatex:T
      {
        \directlua{
          osglecture_modes_ltxtalk.start_raw_skip("\luaescapestring{#1}")
        }
      }
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_peek_if_exist:NTF #1#2#3
  {
    \cs_if_exist:NTF #1
      { \peek_meaning_remove:NTF #1 {#2} {#3} }
      {#3}
  }
  
\cs_new_protected:Npn \osglecture_modes_ltxtalk_start_scan:
  {
    \bool_if:NT \g_osglecture_modes_ltxtalk_ignore_bool
    {
      \typeout{>>> Ignore~mode~on}
        \osglecture_modes_if_active:nT { presentation }
        {
          \typeout{>>> Start scan}
          \osglecture_modes_ltxtalk_scan:
        }
      }
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_scan:
  {
    \peek_meaning:NTF \begin
      { \osglecture_modes_ltxtalk_scan_begin: }
      {
        \peek_meaning:NTF \end
          { \osglecture_modes_ltxtalk_scan_end: }
          { \osglecture_modes_ltxtalk_scan_token: }
      }
  }  

\cs_new_protected:Npn \osglecture_modes_ltxtalk_scan_begin:
  {
    %\peek_remove:NT \begin
    \peek_meaning_remove:NT \begin
    \osglecture_modes_ltxtalk_scan_begin_aux:n
  }

  
\cs_new_protected:Npn \osglecture_modes_ltxtalk_scan_begin_aux:n #1
  {
    \str_if_eq:nnTF {#1} {frame}
      {
        \begin{frame}
      }
      {
        \clist_if_in:NnTF \g_osglecture_modes_ltxtalk_raw_skip_envs_clist {#1}
          {
            \osglecture_modes_ltxtalk_lua_raw_skip:n {#1}
            \osglecture_modes_ltxtalk_scan:
          }
          {
            \osglecture_modes_ltxtalk_skip_environment:n {#1}
            \osglecture_modes_ltxtalk_scan:
          }
      }
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_scan_end:
  {
    \peek_meaning_remove:NT \end
    \osglecture_modes_ltxtalk_scan_end_aux:n
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_scan_end_aux:n #1
  {
    \str_if_eq:nnTF {#1} {document}
      {
        \end{document}
      }
      {
        % fremdes \end{...} außerhalb von frames ignorieren
        \osglecture_modes_ltxtalk_scan:
      }
  }
  
\cs_new_protected:Npn \osglecture_modes_ltxtalk_skip_environment:n #1
  {
    \cs_set_protected:Npn \osglecture_modes_ltxtalk_skip:w ##1 \end ##2
      {
        \str_if_eq:nnF {#1} {##2}
          { \osglecture_modes_ltxtalk_skip:w }
      }
    \osglecture_modes_ltxtalk_skip:w
  }

\prop_new:N \g_osglecture_modes_ltxtalk_dispatch_prop
\bool_new:N \l_osglecture_modes_ltxtalk_dispatch_hit_bool

\cs_new_protected:Npn \osglecture_modes_ltxtalk_declare_allowed_command:nn #1#2
  {
    \prop_gput:Nnn \g_osglecture_modes_ltxtalk_dispatch_prop {#1} {#2}
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_scan_token:
  {
    \bool_set_false:N \l_osglecture_modes_ltxtalk_dispatch_hit_bool

    \prop_map_inline:Nn \g_osglecture_modes_ltxtalk_dispatch_prop
      {
        \bool_if:NF \l_osglecture_modes_ltxtalk_dispatch_hit_bool
          {
            \cs_if_exist:cT {##1}
              {
                \exp_args:Nc \peek_meaning_remove:NTF {##1}
                  {
                    \bool_set_true:N \l_osglecture_modes_ltxtalk_dispatch_hit_bool
                    \use:c {##2}
                  }
                  { }
              }
          }
      }

    \bool_if:NF \l_osglecture_modes_ltxtalk_dispatch_hit_bool
      { \osglecture_modes_ltxtalk_discard_one: }
   }

% handler
\cs_new_protected:Npn \osglecture_modes_ltxtalk_keep_part:
  { \osglecture_modes_ltxtalk_keep_structure:N \part }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_keep_section:
  { \osglecture_modes_ltxtalk_keep_structure:N \section }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_keep_subsection:
  { \osglecture_modes_ltxtalk_keep_structure:N \subsection }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_keep_subsubsection:
  { \osglecture_modes_ltxtalk_keep_structure:N \subsubsection }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_keep_appendix:
  {
    \appendix
    \bool_gset_true:N \g_osglecture_modes_ltxtalk_after_structure_bool
    \osglecture_modes_ltxtalk_scan:
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_keep_label:
  { \osglecture_modes_ltxtalk_keep_label:n }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_keep_input:
  { \osglecture_modes_ltxtalk_keep_input:n }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_keep_include:
  { \osglecture_modes_ltxtalk_keep_include:n }

\NewDocumentCommand \osglecture_modes_ltxtalk_keep_lecturemode: { d<> +m }
  {
    \IfNoValueTF {#1}
      { \lecturemode{#2} }
      { \lecturemode<#1>{#2} }
    \bool_gset_false:N \g_osglecture_modes_ltxtalk_after_structure_bool
    \osglecture_modes_ltxtalk_scan:
  }
  
\NewDocumentCommand \osglecture_modes_ltxtalk_keep_mode: { d<> +m }
  {
    \IfNoValueTF {#1}
      { \mode{#2} }
      { \mode<#1>{#2} }
    \bool_gset_false:N \g_osglecture_modes_ltxtalk_after_structure_bool
    \osglecture_modes_ltxtalk_scan:
  }

\osglecture_modes_ltxtalk_declare_allowed_command:nn { part }          { osglecture_modes_ltxtalk_keep_part: }
\osglecture_modes_ltxtalk_declare_allowed_command:nn { section }       { osglecture_modes_ltxtalk_keep_section: }
\osglecture_modes_ltxtalk_declare_allowed_command:nn { subsection }    { osglecture_modes_ltxtalk_keep_subsection: }
\osglecture_modes_ltxtalk_declare_allowed_command:nn { subsubsection } { osglecture_modes_ltxtalk_keep_subsubsection: }
\osglecture_modes_ltxtalk_declare_allowed_command:nn { appendix }      { osglecture_modes_ltxtalk_keep_appendix: }
\osglecture_modes_ltxtalk_declare_allowed_command:nn { label }         { osglecture_modes_ltxtalk_keep_label: }
\osglecture_modes_ltxtalk_declare_allowed_command:nn { input }         { osglecture_modes_ltxtalk_keep_input: }
\osglecture_modes_ltxtalk_declare_allowed_command:nn { include }       { osglecture_modes_ltxtalk_keep_include: }
\osglecture_modes_ltxtalk_declare_allowed_command:nn { lecturemode }   { osglecture_modes_ltxtalk_keep_lecturemode: }
\osglecture_modes_ltxtalk_declare_allowed_command:nn { mode }          { osglecture_modes_ltxtalk_keep_mode: } 

\NewDocumentCommand \osglecture_modes_ltxtalk_keep_structure:N { m s o m }
  {
    \IfBooleanTF {#2}
      {
        \IfNoValueTF {#3}
          { #1*{#4} }
          { #1*[#3]{#4} }
      }
      {
        \IfNoValueTF {#3}
          { #1{#4} }
          { #1[#3]{#4} }
      }
    \bool_gset_true:N \g_osglecture_modes_ltxtalk_after_structure_bool
    \osglecture_modes_ltxtalk_scan:
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_keep_label:n #1
  {
    \bool_if:NT \g_osglecture_modes_ltxtalk_after_structure_bool
      { \label{#1} }
    \bool_gset_false:N \g_osglecture_modes_ltxtalk_after_structure_bool
    \osglecture_modes_ltxtalk_scan:
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_keep_input:n #1
  {
    \input{#1}
    \bool_gset_false:N \g_osglecture_modes_ltxtalk_after_structure_bool
    \osglecture_modes_ltxtalk_scan:
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_keep_include:n #1
  {
    \include{#1}
    \bool_gset_false:N \g_osglecture_modes_ltxtalk_after_structure_bool
    \osglecture_modes_ltxtalk_scan:
  }


\cs_new_protected:Npn \osglecture_modes_ltxtalk_discard_one:
  {
    \osglecture_modes_ltxtalk_discard_one:n
  }

\cs_new_protected:Npn \osglecture_modes_ltxtalk_discard_one:n #1
  {
    \bool_gset_false:N \g_osglecture_modes_ltxtalk_after_structure_bool
    \osglecture_modes_ltxtalk_scan:
  }

\AddToHook{begindocument}
  { \osglecture_modes_ltxtalk_start_scan: }

\AddToHook{env/frame/after}
  { \osglecture_modes_ltxtalk_start_scan: }
%</ltxtalk>

%<*lua>
osglecture_modes_ltxtalk = osglecture_modes_ltxtalk or {}

osglecture_modes_ltxtalk.raw_skip_env = nil

local previous_callback = callback.find("process_input_buffer")

local function escape_pattern(s)
  return (s:gsub("([^%w])", "%%%1"))
end

function osglecture_modes_ltxtalk.start_raw_skip(env)
  osglecture_modes_ltxtalk.raw_skip_env = env
end

local function raw_skip_line(line)
  local env = osglecture_modes_ltxtalk.raw_skip_env
  if not env then
    return nil
  end

  local pattern =
    "^%s*\\end%s*{%s*" .. escape_pattern(env) .. "%s*}"

  if line:match(pattern) then
    osglecture_modes_ltxtalk.raw_skip_env = nil
  end

  return ""
end

local function process_input_buffer(line)
  local replacement = raw_skip_line(line)

  if replacement ~= nil then
    return replacement
  end

  if previous_callback then
    return previous_callback(line)
  end

  return nil
end

luatexbase.add_to_callback(
  "process_input_buffer",
  process_input_buffer,
  "osglecture-modes-ltxtalk raw skip"
)
%</lua>
