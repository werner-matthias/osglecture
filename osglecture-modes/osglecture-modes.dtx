          {
            \tl_if_empty:NTF \l_osglecture_modes_ltxtalk_selected_profile_tl
              { \tl_set_eq:NN \l_osglecture_modes_ltxtalk_selected_profile_tl \l_tmpa_tl }
              {
                \str_if_eq:VVF \l_osglecture_modes_ltxtalk_selected_profile_tl \l_tmpa_tl
                  {
                    \msg_error:nnVV { osglecture_modes_ltxtalk } { conflicting-filter-profiles }
                      \l_osglecture_modes_ltxtalk_selected_profile_tl \l_tmpa_tl
                  }
              }
          }
      }
  }

% Merges baseline (already live in the runtime tables) with the selected
% profile's closed allow-list, once per run. Nothing here runs if no active
% leaf mode selects a profile, so plain \code{ignorenonframetext} without
% any \cs{DeclareLtxtalkFilterProfile} keeps behaving exactly as before.
\cs_new_protected:Npn \osglecture_modes_ltxtalk_apply_profile:
  {
    \bool_if:NF \g_osglecture_modes_ltxtalk_profile_resolved_bool
      {
        \osglecture_modes_ltxtalk_profile_finalize:
        \osglecture_modes_ltxtalk_select_profile:
        \tl_if_empty:NF \l_osglecture_modes_ltxtalk_selected_profile_tl
          {
            \exp_args:Nc \prop_map_inline:Nn
              { osglecture_modes_ltxtalk_profile_eff_dispatch_
                \l_osglecture_modes_ltxtalk_selected_profile_tl _prop }
              { \prop_gput:Nnn \g_osglecture_modes_ltxtalk_dispatch_prop {##1} {##2} }
            \exp_args:Nc \clist_map_inline:Nn
              { osglecture_modes_ltxtalk_profile_eff_envs_
                \l_osglecture_modes_ltxtalk_selected_profile_tl _clist }
              {
                \clist_if_in:NnF \g_osglecture_modes_ltxtalk_keep_envs_clist {##1}
                  { \clist_gput_right:Nn \g_osglecture_modes_ltxtalk_keep_envs_clist {##1} }
              }
          }
        \bool_gset_true:N \g_osglecture_modes_ltxtalk_profile_resolved_bool
      }
  }

