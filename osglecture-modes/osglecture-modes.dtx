        \prop_new:c  { osglecture_modes_ltxtalk_profile_eff_dispatch_ #1 _prop }
        \clist_new:c { osglecture_modes_ltxtalk_profile_own_envs_ #1 _clist }
        \clist_new:c { osglecture_modes_ltxtalk_profile_eff_envs_ #1 _clist }
