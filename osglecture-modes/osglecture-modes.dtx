    \bool_gset_false:N \g_osglecture_modes_ltxtalk_after_structure_bool
    \osglecture_modes_ltxtalk_scan:
  }

% Arguments, in order: command name, handler name, profile name (possibly
% empty, meaning baseline: added directly to the live dispatch table below,
% active no matter which, if any, filter profile is selected).
