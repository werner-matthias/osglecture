% The argument has to be grabbed here, before the original command is
% re-inserted: appending code after a macro parameter in its own
% replacement text does not run that code "once the parameter is done" --
% macro expansion prepends the whole replacement text at once, so the
% re-inserted command would consume the appended tokens instead of its
% real argument. Grabbing the argument first and only then writing out
% the call keeps the two apart. This mirrors \cs{input}/\cs{include} below
% and covers the common case of a single mandatory argument; a command
% with a different signature still has the low-level
% \cs{osglecture_modes_ltxtalk_declare_allowed_command:nn} as an escape
% hatch.
\cs_new_protected:Npn \osglecture_modes_ltxtalk_keep_generic:Nn #1#2
  {
    #1 {#2}
    \bool_gset_false:N \g_osglecture_modes_ltxtalk_after_structure_bool
    \osglecture_modes_ltxtalk_scan:
  }

