              { \prop_gput:cnn { osglecture_modes_ltxtalk_profile_own_dispatch_ #3 _prop } {#1} {#2} }
              { }
          }
          { \msg_error:nnn { osglecture_modes_ltxtalk } { unknown-filter-profile } {#3} }
      }
  }
