\input regression-test.tex
\documentclass{article}
\begin{document}
\START
\directlua{
 local reader=require('tagpax-ir')
 local compare=require('tagpax-compare')
 local source=reader.read('subdocument.tagpax')
 local target=reader.read('roundtrip-master.tagpax')
 texio.write_nl('log','pages='..tostring(target.source.pages))
 local ok,errors=compare.semantic(source,target)
 texio.write_nl('log','roundtrip='..tostring(ok))
 local precise=false
 for _,annotation in ipairs(target.annotations or {}) do
   if annotation.action=='GoTo' then
     local destination=target.destinations[annotation.destination]
     precise=destination and destination.view=='XYZ'
       and tonumber(destination.arg1)~=nil
       and tonumber(destination.arg2)~=nil
     break
   end
 end
 texio.write_nl('log','precise-destination='..tostring(not not precise))
 for _,e in ipairs(errors) do texio.write_nl('log','error='..e) end
 --[[ The /RoleMap table is the source document's own structure-type
 vocabulary, not something roundtrip fidelity is about; only that the
 written copy carries the exact same tag->role pairs as the source is
 asserted, regardless of how many entries that vocabulary happens to have. ]]
 local function rolemap_set(ir)
   local set = {}
   for _, rolemap in ipairs(ir.rolemaps or {}) do
     set[rolemap.tag] = rolemap.role
   end
   return set
 end
 local function rolemap_sets_equal(a, b)
   for tag, role in pairs(a) do
     if b[tag] ~= role then return false end
   end
   for tag, role in pairs(b) do
     if a[tag] ~= role then return false end
   end
   return true
 end
 texio.write_nl('log', 'rolemap-roundtrip='..tostring(rolemap_sets_equal(rolemap_set(source), rolemap_set(target))))
}
\END
\end{document}
