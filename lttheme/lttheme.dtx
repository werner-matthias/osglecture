% ==========================================
% NAVIGATION
% ==========================================
% \ldeen{
%   Eine \emph{Navigation} ist eine benannte, wiederverwendbare Darstellung
%   der Dokumentstruktur. Ein Layout bindet sie im Aufbau-Code an einen Slot
%   (\cs{setltxtalkslotcontent}\Marg{slot}\Marg{\cs{LTXTalkNavigation}
%   \Marg{name}}); \cs{DeclareLTXTalkNavigation} registriert eigene.
%
%   Renderer, die die \emph{gesamte} Abschnittsfolge zeigen (nicht nur den
%   aktuellen Eintrag), brauchen zwei Läufe: \cls{ltx-talk} setzt Abschnitte
%   nicht selbst, deshalb sammelt lttheme über die Haken
%   \code{section/begin} und \code{subsection/begin} die Struktur in die
%   \file{.aux} und liest sie beim nächsten Lauf. Ändert sich die Struktur,
%   meldet lttheme \enquote{rerun to get the navigation right}. Renderer,
%   die nur den aktuellen Abschnitt zeigen, kommen mit einem Lauf aus.
% }{
%   A \emph{navigation} is a named, reusable rendering of the document
%   structure. A layout binds it to a slot in its setup code
%   (\cs{setltxtalkslotcontent}\Marg{slot}\Marg{\cs{LTXTalkNavigation}
%   \Marg{name}}); \cs{DeclareLTXTalkNavigation} registers new ones.
%
%   Renderers that show the \emph{whole} section sequence (not just the
%   current entry) need two passes: \cls{ltx-talk} does not typeset
%   sections, so lttheme collects the structure into the \file{.aux}
%   through the \code{section/begin} and \code{subsection/begin} hooks and
%   reads it back on the next run. If the structure changes, lttheme asks
%   for a rerun. Renderers that show only the current section need one pass.
% }

\prop_new:N \g__ltxtalk_navigations_prop
% Each entry is a brace group { {level} {number} {title} {frame} }.
\seq_new:N \g__ltxtalk_nav_toc_seq         % read from the .aux (previous run)
\seq_new:N \g__ltxtalk_nav_thisrun_seq     % collected during this run
\seq_new:N \l__ltxtalk_nav_tmp_seq
\bool_new:N \g__ltxtalk_nav_structure_used_bool
\int_new:N \g__ltxtalk_nav_map_int         % running entry count (separator logic)
\int_new:N \g__ltxtalk_nav_total_int       % number of sections
\int_new:N \g__ltxtalk_nav_index_int       % 1-based position of the current section
\tl_new:N \l__ltxtalk_nav_sep_tl
\tl_set:Nn \l__ltxtalk_nav_sep_tl { \nobreakspace \textbullet \nobreakspace }

\NewDocumentCommand \DeclareLTXTalkNavigation { m +m }
  { \prop_gput:Nnn \g__ltxtalk_navigations_prop {#1} {#2} }

\NewDocumentCommand \LTXTalkNavigation { m }
  {
    \prop_if_in:NnTF \g__ltxtalk_navigations_prop {#1}
      { \prop_item:Nn \g__ltxtalk_navigations_prop {#1} }
      { \msg_error:nnn { ltxtalk } { unknown-navigation } {#1} }
  }

% \ldeen{Renderer rufen dies auf, wenn sie die gesammelte Struktur nutzen;
%   nur dann wird am Dokumentende ein Rerun angemahnt.}{Renderers call this
%   when they use the collected structure; only then is a rerun requested at
%   the end of the document.}
\cs_new_protected:Npn \__ltxtalk_nav_use_structure:
  { \bool_gset_true:N \g__ltxtalk_nav_structure_used_bool }

% \ldeen{Der Titel wird detokenisiert in die \file{.aux} geschrieben --
%   einfache Titel erscheinen unverändert, Titel mit Auszeichnung als
%   Klartext (dokumentierte Einschränkung, da bewegliches Argument). Die
%   Signatur (Ebene/Nummer/Titel/Frame je Eintrag) dient der
%   Rerun-Erkennung.}{The title is written detokenised to the \file{.aux} --
%   plain titles appear unchanged, marked-up titles as plain text
%   (documented limitation, being a moving argument). The signature
%   (level/number/title/frame per entry) drives rerun detection.}
\cs_new_protected:Npn \__ltxtalk_nav_record:nnn #1#2#3
  {
    \seq_gput_right:Ne \g__ltxtalk_nav_thisrun_seq
      { { #1 } { #2 } { #3 } { \@framenumber } }
    \legacy_if:nT { @filesw }
      {
        \iow_now:Ne \@auxout
          {
            \token_to_str:N \ltxtalk@nav@entry
              { #1 } { #2 } { #3 } { \@framenumber }
          }
      }
  }

\cs_new_protected:Npn \ltxtalk@nav@entry #1#2#3#4
  { \seq_gput_right:Nn \g__ltxtalk_nav_toc_seq { {#1} {#2} {#3} {#4} } }

% \ldeen{\cs{insertsection} ist \cs{protected} und expandiert unter \code{:e}
%   nicht; die internen Titel-Variablen der Klasse werden hier direkt
%   detokenisiert (in der Variablenliste von \cls{ltx-talk} dokumentiert,
%   mit Existenzprüfung als Absicherung).}{\cs{insertsection} is
%   \cs{protected} and will not expand under \code{:e}; the class's internal
%   title variables are detokenised here directly (documented in
%   \cls{ltx-talk}'s variable list, guarded by an existence test).}
\cs_new:Npn \__ltxtalk_nav_sec_title:
  { \tl_if_exist:cT { l__talk_section_tl }
      { \tl_to_str:c { l__talk_section_tl } } }
\cs_new:Npn \__ltxtalk_nav_subsec_title:
  { \tl_if_exist:cT { l__talk_subsection_tl }
      { \tl_to_str:c { l__talk_subsection_tl } } }

\AddToHook { section / begin }
  { \__ltxtalk_nav_record:nnn { 1 } { \thesection } { \__ltxtalk_nav_sec_title: } }
\AddToHook { subsection / begin }
  { \__ltxtalk_nav_record:nnn { 2 } { \thesubsection }
      { \__ltxtalk_nav_subsec_title: } }

\AddToHook { enddocument / afterlastpage }
  {
    \bool_if:NT \g__ltxtalk_nav_structure_used_bool
      {
        \str_if_eq:eeF
          { \seq_use:Nn \g__ltxtalk_nav_toc_seq     { | } }
          { \seq_use:Nn \g__ltxtalk_nav_thisrun_seq { | } }
          { \msg_warning:nn { ltxtalk } { rerun-navigation } }
      }
  }

% \ldeen{Setzt einen Eintrag der Abschnittsliste; der aktuelle Abschnitt
%   wird über die Klassenfarbe \code{ltxtalk-primary} hervorgehoben, die
%   übrigen gedämpft.}{Typesets one section-list entry; the current section
%   is emphasised in the class colour \code{ltxtalk-primary}, the others
%   dimmed.}
\cs_new_protected:Npn \__ltxtalk_nav_list_entry:nnnn #1#2#3#4
  {
    \str_if_eq:nnT {#1} { 1 }
      {
        \int_compare:nNnT \g__ltxtalk_nav_map_int > { 0 }
          { \l__ltxtalk_nav_sep_tl }
        \int_incr:N \g__ltxtalk_nav_map_int
        \str_if_eq:eeTF {#2} { \thesection }
          { {\color{ltxtalk-primary} #3} }
          { {\color{ltxtalk-secondary!55} #3} }
      }
  }

% \ldeen{Die Renderer leben in eigenen Funktionen, nicht direkt im
%   gespeicherten Navigations-Code: \cs{seq_map_inline:Nn} braucht dort ein
%   echtes Makro als Rahmen, damit \code{##1} eindeutig ist.}{The renderers
%   live in their own functions rather than inline in the stored navigation
%   code: \cs{seq_map_inline:Nn} needs a real macro frame there for
%   \code{##1} to be unambiguous.}
\cs_new_protected:Npn \__ltxtalk_nav_render_section_list:
  {
    \int_gzero:N \g__ltxtalk_nav_map_int
    \seq_map_inline:Nn \g__ltxtalk_nav_toc_seq
      { \__ltxtalk_nav_list_entry:nnnn ##1 }
  }

% \ldeen{Wahr, wenn die Unterabschnittsnummer \#1 zum aktuellen Abschnitt
%   gehört -- also ihr Bestandteil vor dem ersten Punkt gleich
%   \cs{thesection} ist.}{True when the subsection number \#1 belongs to the
%   current section -- i.e.\ its component before the first dot equals
%   \cs{thesection}.}
\prg_new_protected_conditional:Npnn \__ltxtalk_nav_subsec_in_current:n #1 { T, F, TF }
  {
    \seq_set_split:Nnn \l__ltxtalk_nav_tmp_seq { . } {#1}
    \str_if_eq:eeTF { \seq_item:Nn \l__ltxtalk_nav_tmp_seq { 1 } } { \thesection }
      { \prg_return_true: } { \prg_return_false: }
  }

% \ldeen{Zählt die Abschnitte und merkt sich die Position des aktuellen; von
%   den Renderern \code{section-dots} und \code{section-progress} vor dem
%   Setzen aufgerufen.}{Counts the sections and records the current one's
%   position; called by the \code{section-dots} and \code{section-progress}
%   renderers before they typeset.}
\cs_new_protected:Npn \__ltxtalk_nav_measure:
  {
    \int_gzero:N \g__ltxtalk_nav_total_int
    \int_gzero:N \g__ltxtalk_nav_index_int
    \seq_map_inline:Nn \g__ltxtalk_nav_toc_seq
      { \__ltxtalk_nav_measure_entry:nnnn ##1 }
  }
\cs_new_protected:Npn \__ltxtalk_nav_measure_entry:nnnn #1#2#3#4
  {
    \str_if_eq:nnT {#1} { 1 }
      {
        \int_gincr:N \g__ltxtalk_nav_total_int
        \str_if_eq:eeT {#2} { \thesection }
          { \int_gset_eq:NN \g__ltxtalk_nav_index_int \g__ltxtalk_nav_total_int }
      }
  }

% \ldeen{Unterabschnittsliste des aktuellen Abschnitts, aktueller
%   Unterabschnitt hervorgehoben.}{Subsection list of the current section,
%   current subsection emphasised.}
\cs_new_protected:Npn \__ltxtalk_nav_render_subsection_list:
  {
    \int_gzero:N \g__ltxtalk_nav_map_int
    \seq_map_inline:Nn \g__ltxtalk_nav_toc_seq
      { \__ltxtalk_nav_subsec_entry:nnnn ##1 }
  }
\cs_new_protected:Npn \__ltxtalk_nav_subsec_entry:nnnn #1#2#3#4
  {
    \str_if_eq:nnT {#1} { 2 }
      {
        \__ltxtalk_nav_subsec_in_current:nT {#2}
          {
            \int_compare:nNnT \g__ltxtalk_nav_map_int > { 0 }
              { \l__ltxtalk_nav_sep_tl }
            \int_incr:N \g__ltxtalk_nav_map_int
            \str_if_eq:eeTF {#2} { \thesubsection }
              { {\color{ltxtalk-primary} #3} }
              { {\color{ltxtalk-secondary!55} #3} }
          }
      }
  }

% \ldeen{Abschnitte untereinander; unter dem aktuellen Abschnitt seine
%   Unterabschnitte eingerückt. Zeilen werden mit \cs{newline} getrennt, es
%   entsteht also kein zusätzlicher Absatz.}{Sections one per line; the
%   current section's subsections indented below it. Lines are separated with
%   \cs{newline}, so no extra paragraph is created.}
\cs_new_protected:Npn \__ltxtalk_nav_render_toc:
  {
    \int_gzero:N \g__ltxtalk_nav_map_int
    \seq_map_inline:Nn \g__ltxtalk_nav_toc_seq
      { \__ltxtalk_nav_toc_entry:nnnn ##1 }
  }
\cs_new_protected:Npn \__ltxtalk_nav_toc_entry:nnnn #1#2#3#4
  {
    \str_if_eq:nnTF {#1} { 1 }
      {
        \int_compare:nNnT \g__ltxtalk_nav_map_int > { 0 } { \newline }
        \int_incr:N \g__ltxtalk_nav_map_int
        \str_if_eq:eeTF {#2} { \thesection }
          { {\color{ltxtalk-primary} #3} }
          { {\color{ltxtalk-secondary!55} #3} }
      }
      {
        \str_if_eq:nnT {#1} { 2 }
          {
            \__ltxtalk_nav_subsec_in_current:nT {#2}
              {
                \int_compare:nNnT \g__ltxtalk_nav_map_int > { 0 } { \newline }
                \int_incr:N \g__ltxtalk_nav_map_int
                \hspace { 1em }
                \str_if_eq:eeTF {#2} { \thesubsection }
                  { {\color{ltxtalk-primary} #3} }
                  { {\color{ltxtalk-secondary!55} #3} }
              }
          }
      }
  }

% \ldeen{Ein Punkt je Abschnitt: aktueller gefüllt in \code{ltxtalk-primary},
%   zurückliegende gefüllt gedämpft, folgende offen. Beide Symbole aus dem
%   Mathematikmodus, damit die Schrift keine Rolle spielt.}{One dot per
%   section: current filled in \code{ltxtalk-primary}, past filled and dimmed,
%   upcoming open. Both symbols from math mode so the font does not matter.}
\cs_new_protected:Npn \__ltxtalk_nav_render_section_dots:
  {
    \__ltxtalk_nav_measure:
    \int_gzero:N \g__ltxtalk_nav_map_int
    \seq_map_inline:Nn \g__ltxtalk_nav_toc_seq
      { \__ltxtalk_nav_dot_entry:nnnn ##1 }
  }
\cs_new_protected:Npn \__ltxtalk_nav_dot_entry:nnnn #1#2#3#4
  {
    \str_if_eq:nnT {#1} { 1 }
      {
        \int_compare:nNnT \g__ltxtalk_nav_map_int > { 0 } { \nobreakspace }
        \int_incr:N \g__ltxtalk_nav_map_int
        \int_compare:nNnTF \g__ltxtalk_nav_map_int = \g__ltxtalk_nav_index_int
          { {\color{ltxtalk-primary} \ensuremath{\bullet}} }
          {
            \int_compare:nNnTF \g__ltxtalk_nav_map_int < \g__ltxtalk_nav_index_int
              { {\color{ltxtalk-primary!45} \ensuremath{\bullet}} }
              { {\color{ltxtalk-secondary!45} \ensuremath{\circ}} }
          }
      }
  }

% \ldeen{Textueller Fortschritt \enquote{\meta{Position} / \meta{Anzahl}};
%   sprachneutral. Vor dem ersten Abschnitt entfällt der Positionsteil.}{
%   Textual progress \enquote{\meta{position} / \meta{count}};
%   language-neutral. Before the first section the position part is omitted.}
\cs_new_protected:Npn \__ltxtalk_nav_render_section_progress:
  {
    \__ltxtalk_nav_measure:
    \int_compare:nNnT \g__ltxtalk_nav_index_int > { 0 }
      { \int_use:N \g__ltxtalk_nav_index_int \nobreakspace / \nobreakspace }
    \int_use:N \g__ltxtalk_nav_total_int
  }

\DeclareLTXTalkNavigation { current-section }
  { \LTXTalkMetadata { section } }
\DeclareLTXTalkNavigation { current-subsection }
  { \LTXTalkMetadata { subsection } }
\DeclareLTXTalkNavigation { section-list }
  { \__ltxtalk_nav_use_structure: \__ltxtalk_nav_render_section_list: }
\DeclareLTXTalkNavigation { subsection-list }
  { \__ltxtalk_nav_use_structure: \__ltxtalk_nav_render_subsection_list: }
\DeclareLTXTalkNavigation { toc }
  { \__ltxtalk_nav_use_structure: \__ltxtalk_nav_render_toc: }
\DeclareLTXTalkNavigation { section-dots }
  { \__ltxtalk_nav_use_structure: \__ltxtalk_nav_render_section_dots: }
\DeclareLTXTalkNavigation { section-progress }
  { \__ltxtalk_nav_use_structure: \__ltxtalk_nav_render_section_progress: }


