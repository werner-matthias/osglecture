% \ldeen{
%   \#1 Slot-Name (eindeutig), \#2 Bereich (header/left/content/right/footer),
%   \#3 Slot-Typ (frametitle, section, logo, \dots), \#4 Barrierefreiheits-Optionen
%   (Key-Value). Idempotent: ein Layout darf pro Frame erneut ausgeführt werden,
%   ohne dass ein Slot doppelt in die Bereichs-Reihenfolge gerät. Wird ein Slot
%   in einen anderen Bereich verschoben, wird er zuerst aus der alten Reihenfolge
%   entfernt.
% }{
%   \#1 slot name (unique), \#2 area (header/left/content/right/footer),
%   \#3 slot type (frametitle, section, logo, \dots), \#4 accessibility options
%   (key-value). Idempotent: a layout may run again per frame without a slot
%   ending up twice in an area's order. If a slot moves to another area, it is
%   first removed from the old order.
% }
\NewDocumentCommand \defineltxtalkslot { m m m m }
  {
    \prop_get:NnNT \g__ltxtalk_slot_areas_prop {#1} \l__ltxtalk_slot_area_tl
      {
        \seq_if_exist:cT { g__ltxtalk_ \l__ltxtalk_slot_area_tl _slots_seq }
          { \seq_gremove_all:cn { g__ltxtalk_ \l__ltxtalk_slot_area_tl _slots_seq } {#1} }
      }
    \prop_gput:Nnn \g__ltxtalk_slot_areas_prop {#1} {#2}
    \prop_gput:Nnn \g__ltxtalk_slot_types_prop {#1} {#3}
    \prop_gput:Nnn \g__ltxtalk_slot_accessibility_prop {#1} {#4}
    \seq_if_exist:cF { g__ltxtalk_#2_slots_seq }
      { \seq_new:c { g__ltxtalk_#2_slots_seq } }
    \seq_if_in:cnF { g__ltxtalk_#2_slots_seq } {#1}
      { \seq_gput_right:cn { g__ltxtalk_#2_slots_seq } {#1} }
    \IfInstanceExistsTF { lttheme-slot } {#1}
      { \EditInstance { lttheme-slot } {#1} { } }
      { \DeclareInstance { lttheme-slot } {#1} { standard } { } }
  }

\NewDocumentCommand \positionltxtalkslot { m m m m m }
  {
    % 
    % \begin{itemize}
    %  \item \#1: Slot-Name
    %  \item \#2: x-Position (Dimension oder 'left'/'center'/'right')
    %  \item \#3: y-Position (Dimension oder 'top'/'center'/'bottom')
    %  \item \#4: Breite (Dimension)
    %  \item \#5: Höhe (Dimension)
    %\end{itemize}
    \prop_gput:Nnn \g__ltxtalk_slot_positions_prop { #1 } 
      { { #2 } { #3 } { #4 } { #5 } }
  }

