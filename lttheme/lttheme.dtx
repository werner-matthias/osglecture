% \ldeen*{@1 hält den "`äußeren"' Teil des Themes (Layout, Slots,
% Dekorationen) frei von @2s \LuaTeX{}/\XeTeX{}-Bindung: Farbverwaltung
% wird über osgstyler bezogen (siehe unten bei @3), aber osgstylers
% Font-Palette-Modul -- und damit @2 selbst -- wird nicht geladen.
% Ohne @1 steht die volle osgstyler-Fontverwaltung zur Verfügung.}
% {Option @1 keeps the "`outer"' part of the theme (layout, slots,
% decorations) free of @2's \LuaTeX{}/\XeTeX{} binding: color management
% is still sourced from osgstyler (see @3 below), but osgstyler's
% font-palette module -- and thus @2 itself -- is not loaded. Without
% @1, full osgstyler font management is available.}
% {\option{outer-only}}{\pkg*{fontspec}}{\cs{setltxtalkcolors}}
\bool_new:N \g__ltxtalk_outeronly_bool
\DeclareKeys
  {
    outer-only .bool_gset:N = \g__ltxtalk_outeronly_bool,
    outer-only .initial:n = false,
    outer-only .usage:n = load,
  }
\ProcessKeyOptions\relax
% \ldeen*{@1 signalisiert osgstyler, dass lttheme seine Themefarben
% selbst über @2/@3 einspeist (siehe unten bei @4), sodass osgstylers
% eigene reaktive lttheme-Integration entfällt.}{@1 signals to osgstyler
% that lttheme feeds its theme colors into osgstyler itself via @2/@3
% (see @4 below), so osgstyler's own reactive lttheme integration does
% not apply.}{\cs{LtxtalkUsesOsgstylerNatively}}
% {\cs{DeclareOsgColorPalette}}{\cs{UseOsgColorPalette}}
% {\cs{__ltxtalk\_colors\_apply:n}}
\cs_gset_protected:Npn \LtxtalkUsesOsgstylerNatively { }
\bool_if:NTF \g__ltxtalk_outeronly_bool
  { \RequirePackage[colors-only]{osgstyler} }
  { \RequirePackage{osgstyler} }

