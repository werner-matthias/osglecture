  \str_if_eq:VnT \g__ltxtalk_active_theme_tl { default }
    {
      \clist_map_inline:nn { minimal, magpie, hawk, sparrow, anchovy, carp }
        {
          \@ifpackageloaded{ltxtalk-theme-#1}
