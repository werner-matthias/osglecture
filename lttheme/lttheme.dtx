% \ldeen{
%   Ein Layout bündelt eine benannte Grundeinstellung: die Keys von
%   \code{ltxtalk / layout} und optional Aufbau-Code (Slots definieren,
%   Flächen dekorieren, eine Navigation binden). \cs{UseLTXTalkLayout}
%   wendet zuerst die gespeicherten Keys an, dann die Aufruf-Overrides,
%   dann den Code -- der Code sieht also die endgültigen Werte (etwa
%   \cs{LTXTalkHeaderRows}). Layouts sind additiv: nicht genannte Keys
%   behalten ihren Wert, sodass ein Theme ein Layout als Ausgangspunkt
%   nutzen und einzelne Slots danach überschreiben kann. Ein Theme kann
%   mehrere Layouts deklarieren und pro Frame zwischen ihnen umschalten.
% }{
%   A layout bundles a named baseline: the \code{ltxtalk / layout} keys and
%   optionally setup code (define slots, decorate areas, bind a
%   navigation). \cs{UseLTXTalkLayout} applies the stored keys first, then
%   the per-call overrides, then the code -- so the code sees the final
%   values (such as \cs{LTXTalkHeaderRows}). Layouts are additive: keys not
%   named keep their value, so a theme can use a layout as a starting point
%   and override individual slots afterwards. A theme may declare several
%   layouts and switch between them per frame.
% }
\NewDocumentCommand \DeclareLTXTalkLayout { m m O{} }
  {
    \prop_gput:Nnn \g__ltxtalk_layouts_prop {#1} {#2}
    \prop_gput:Nnn \g__ltxtalk_layout_code_prop {#1} {#3}
  }

\NewDocumentCommand \UseLTXTalkLayout { m O{} }
  {
    \prop_get:NnNTF \g__ltxtalk_layouts_prop {#1} \l_tmpa_tl
      {
        \keys_set:nV { ltxtalk / layout } \l_tmpa_tl
        \tl_if_blank:nF {#2} { \keys_set:nn { ltxtalk / layout } {#2} }
        \prop_get:NnNT \g__ltxtalk_layout_code_prop {#1} \l_tmpb_tl
          { \tl_use:N \l_tmpb_tl }
        \__ltxtalk_update_text_area:
      }
      { \msg_error:nnn { ltxtalk } { unknown-layout } {#1} }
  }

% \ldeen{
%   Die Titelseite ist der Spezialfall eines Layouts: ihre Optionen liegen
%   im selben Speicher und Schlüsselraum (\code{ltxtalk / layout}) wie
%   gewöhnliche Layouts. Der dritte Parameter von
%   \cs{DeclareLTXTalkTitleLayout} ist jedoch kein Aufbau-Code, sondern der
%   \emph{Inhalt} des Titel-Frames -- er wird von \cs{MakeLTXTalkTitle}
%   einmalig in einer \env{frame}-Umgebung ausgeführt, nicht als
%   persistenter Aufbau. Deshalb ein eigener Code-Speicher.
% }{
%   The title page is the special case of a layout: its options live in the
%   same store and key space (\code{ltxtalk / layout}) as ordinary layouts.
%   The third parameter of \cs{DeclareLTXTalkTitleLayout} is not setup code
%   but the \emph{content} of the title frame -- \cs{MakeLTXTalkTitle} runs
%   it once inside a \env{frame}, not as persistent setup. Hence a separate
%   code store.
% }
\prop_new:N \g__ltxtalk_title_layout_code_prop
\tl_new:N \g__ltxtalk_title_layout_tl
\bool_new:N \l__ltxtalk_title_page_bool
\int_new:N \g__ltxtalk_title_header_rows_int
\int_new:N \g__ltxtalk_saved_header_grid_rows_int
% \ldeen{Wahr, während eine Titelseite den Zeilenzähler des Kopfrasters
%   überschreibt -- nur dann muss er nach dem Ausgeben wiederhergestellt
%   werden. Themes ohne Kopfraster tragen keinen Eintrag ein.}{True while a
%   title page has overridden the header grid's row count -- only then does it
%   need restoring after shipout. Themes without a header grid leave no
%   entry.}
\bool_new:N \g__ltxtalk_title_grid_saved_bool

\NewExpandableDocumentCommand \LTXTalkHeaderRows {}
  {\bool_if:NTF \l__ltxtalk_title_page_bool
     {\int_use:N \g__ltxtalk_title_header_rows_int}
     {\int_use:N \l__ltxtalk_header_rows_int}}

\NewDocumentCommand \IfLTXTalkTitlePageTF {m m}
  {\bool_if:NTF \l__ltxtalk_title_page_bool {#1}{#2}}

\NewDocumentCommand \DeclareLTXTalkTitleLayout { m m m }
  {
    \prop_gput:Nnn \g__ltxtalk_layouts_prop {#1} {#2}
    \prop_gput:Nnn \g__ltxtalk_title_layout_code_prop {#1} {#3}
  }

\NewDocumentCommand \UseLTXTalkTitleLayout { m }
  { \tl_gset:Nn \g__ltxtalk_title_layout_tl {#1} }

\NewDocumentCommand \MakeLTXTalkTitle {O{}}
  {
    \tl_if_blank:nTF {#1}
      {\tl_set_eq:NN \l_tmpa_tl \g__ltxtalk_title_layout_tl}
      {\tl_set:Nn \l_tmpa_tl {#1}}
    \prop_get:NVNTF \g__ltxtalk_title_layout_code_prop \l_tmpa_tl \l_tmpb_tl
      {
        \prop_get:NVN \g__ltxtalk_layouts_prop \l_tmpa_tl \l_tmpc_tl
        \group_begin:
          \keys_set:nV {ltxtalk/layout} \l_tmpc_tl
          % ltx-talk 0.5.3 can defer construction of the running head until
          % after the frame group.  Keep the small amount of state needed by
          % header sockets alive until this page has actually shipped.
          \bool_gset_true:N \l__ltxtalk_title_page_bool
          \int_gset_eq:NN \g__ltxtalk_title_header_rows_int
            \l__ltxtalk_header_rows_int
          % \ldeen{Nur wenn das Theme ein Kopfraster nutzt, gibt es eine
          %   Zeilenzahl zu sichern und zu ersetzen; ohne Eintrag lieferte
          %   \cs{prop_get:NnN} \cs{q_no_value} und \cs{int_gset:Nn} liefe
          %   sich fest.}{Only a theme with a header grid has a row count to
          %   save and replace; without an entry \cs{prop_get:NnN} would
          %   yield \cs{q_no_value} and \cs{int_gset:Nn} would spin.}
          \bool_gset_false:N \g__ltxtalk_title_grid_saved_bool
          \prop_get:NnNT \g__ltxtalk_area_grid_rows_prop {header} \l_tmpa_tl
            {
              \bool_gset_true:N \g__ltxtalk_title_grid_saved_bool
              \int_gset:Nn \g__ltxtalk_saved_header_grid_rows_int {\l_tmpa_tl}
              \prop_gput:NnV \g__ltxtalk_area_grid_rows_prop {header}
                \l__ltxtalk_header_rows_int
            }
          \AddToHookNext{shipout/after}
            {
              \bool_gset_false:N \l__ltxtalk_title_page_bool
              \bool_if:NT \g__ltxtalk_title_grid_saved_bool
                {\prop_gput:Nnx \g__ltxtalk_area_grid_rows_prop {header}
                  {\int_use:N \g__ltxtalk_saved_header_grid_rows_int}}
            }
          \__ltxtalk_update_text_area:
          \begin{frame}[vertical-alignment=top]
            \thispagestyle{lttheme}
            \tl_use:N \l_tmpb_tl
          \end{frame}
        \group_end:
        \__ltxtalk_update_text_area:
      }
      {\msg_error:nnV {ltxtalk}{unknown-title-layout}\l_tmpa_tl}
  }

% ==========================================
% FARBSCHEMA
% ==========================================

% \ldeen*{@1 löst selbst keine Farben auf, sondern reicht sein Argument
% unverändert an @2 weiter -- beide Schnittstellen teilen absichtlich
% dasselbe Vokabular (dieselben acht Slotnamen, dieselbe
% \code{model=...,~value=...}"=~bzw.\ \code{alias=...}"=Syntax), sodass
% keine Übersetzung nötig ist. Nicht genannte Slots werden über @2s
% eigene Fallback-Kette aufgelöst (\code{secondary} etc.\ fallen auf
% \code{primary} zurück): @1 ist eine vollständige Neudeklaration, kein
% inkrementelles Patch. Die resultierenden osgstyler-Farben werden
% anschließend unter den etablierten \code{ltxtalk-*}"=Namen (und den
% unpräfigierten \code{structure}/\code{alert}/\code{example}"=Namen)
% gespiegelt, damit Themecode diese Namen unverändert nutzen
% kann.}{@1 does not resolve colors itself; it forwards its argument
% unchanged to @2 -- both interfaces deliberately share the same
% vocabulary (the same eight slot names, the same
% \code{model=...,~value=...} resp.\ \code{alias=...} syntax), so no
% translation is needed. Slots not given resolve via @2's own fallback
% chain (\code{secondary} etc.\ fall back to \code{primary}): @1 is a
% full redeclaration, not an incremental patch. The resulting osgstyler
% colors are then mirrored under the established \code{ltxtalk-*} names
% (and the unprefixed \code{structure}/\code{alert}/\code{example}
% names), so theme code can use those names unchanged.}
% {\cs{setltxtalkcolors}}{\cs{DeclareOsgColorPalette}}
% \ldeen*{@1 liest den aufgelösten Wert per @2 aus der bereits von
% osgstyler gesetzten Farbe @3 und registriert ihn anschließend sowohl
% nativ über @4 als auch klassisch über @5: \cls*{ltx-talk} ersetzt
% \cs{color} durch eine auf dem \pkg*{l3color}"=Modul aufbauende
% Fassung, die ausschließlich nativ registrierte Farben kennt -- eine
% nur klassisch definierte Farbe wäre für \cs{color} "`unbekannt"',
% obwohl \cs{extractcolorspec} sie korrekt läse.}{@1 reads the resolved
% value via @2 from the color @3 that osgstyler has already set, then
% registers it both natively via @4 and classically via @5:
% \cls*{ltx-talk} replaces \cs{color} with a version built on the
% \pkg*{l3color} module that only recognizes natively registered colors
% -- a color defined only classically would be "`unknown"' to \cs{color},
% even though \cs{extractcolorspec} would read it correctly.}
% {\cs{\_\_ltxtalk\_colors\_mirror:nn}}{\cs{color\_export:nnN}}
% {\code{osgstyler-*}}{\cs{color\_set:nnn}}{\cs{definecolor}}
\cs_generate_variant:Nn \color_set:nnn { nnV }
\cs_new_protected:Npn \__ltxtalk_colors_mirror:nn #1#2
  {
    \color_export:nnN {#2} { HTML } \l_tmpb_tl
    \color_set:nnV {#1} { HTML } \l_tmpb_tl
    \use:e
      {
        \exp_not:N \definecolor {#1} { HTML } { \l_tmpb_tl }
      }
  }
\cs_new_protected:Npn \__ltxtalk_colors_apply:n #1
  {
    \DeclareOsgColorPalette { ltxtalk } {#1}
    \UseOsgColorPalette { ltxtalk }
    \__ltxtalk_colors_mirror:nn { ltxtalk-primary }   { osgstyler-primary }
    \__ltxtalk_colors_mirror:nn { ltxtalk-secondary } { osgstyler-secondary }
    \__ltxtalk_colors_mirror:nn { ltxtalk-accent }    { osgstyler-accent }
    \__ltxtalk_colors_mirror:nn { ltxtalk-text }      { osgstyler-text }
    \__ltxtalk_colors_mirror:nn { ltxtalk-bg }        { osgstyler-background }
    \__ltxtalk_colors_mirror:nn { ltxtalk-structure } { osgstyler-structure }
    \__ltxtalk_colors_mirror:nn { ltxtalk-alert }     { osgstyler-alert }
    \__ltxtalk_colors_mirror:nn { ltxtalk-example }   { osgstyler-example }
    \__ltxtalk_colors_mirror:nn { structure } { osgstyler-structure }
    \__ltxtalk_colors_mirror:nn { alert }     { osgstyler-alert }
    \__ltxtalk_colors_mirror:nn { example }   { osgstyler-example }
  }

\NewDocumentCommand \setltxtalkcolors { m }
  { \__ltxtalk_colors_apply:n {#1} }

% Standardfarben
\__ltxtalk_colors_apply:n
  {
    primary    = { model=HTML, value=2B3A67 },
    secondary  = { model=HTML, value=496A81 },
    accent     = { model=HTML, value=66999B },
    text       = { model=HTML, value=333333 },
    background = { model=HTML, value=FFFFFF },
    structure  = { alias=primary },
    alert      = { model=HTML, value=B00020 },
    example    = { model=HTML, value=166534 },
  }

% ==========================================
% INNER THEME: BLOCKS AND LIST MARKERS
% ==========================================

% The box-styling engine itself (template type, interface, and typeset
% code) now lives in osgstyler as osgstyler-block, since long-form
% documents need the same boxed-content rendering without pulling in
% this presentation-specific theme. This file only declares its own
% instances against that shared type and wraps the beamer/ltx-talk
% environments -- the "style a known environment" case, where the
% original environment keeps its own semantics and this wrapper only
% adds the visual frame.
\clist_map_inline:nn { block, alertblock, exampleblock }
  { \DeclareInstance { osgstyler-block } {#1} { standard } { } }

\NewDocumentCommand \styleltxtalkblock { m m }
  { \StyleOsgBlockInstance {#1} {#2} }

\cs_new_protected:Npn \__ltxtalk_use_original_block:nnn #1#2#3
  {
    \IfNoValueTF {#1}
      { \begin{ltxtalk-original-block}{#2}#3\end{ltxtalk-original-block} }
      { \begin{ltxtalk-original-block}<#1>{#2}#3\end{ltxtalk-original-block} }
  }

% \ldeen{
%   Zwei Wege je nach Block-Layout: \code{plain} reicht die Original-Umgebung
%   \code{ltxtalk-original-block} (mit deren eigenem Titel) unverteilt an
%   \code{osgstyler-block} weiter -- die \code{<Overlay>}-Behandlung der
%   Klasse bleibt erhalten. \code{titled} braucht Titel und Body getrennt:
%   der Titel geht in den farbigen Kopf, der Body ohne Klassen-Umgebung
%   direkt; die Overlay-Auswahl übernimmt hier \cs{__talk_if_overlay:nT}.
% }{
%   Two paths depending on the block layout: \code{plain} hands the original
%   \code{ltxtalk-original-block} environment (with its own title)
%   undivided to \code{osgstyler-block} -- the class's \code{<overlay>}
%   handling is preserved. \code{titled} needs title and body separately:
%   the title goes into the coloured head, the body directly without the
%   class environment; \cs{__talk_if_overlay:nT} does the overlay selection
%   here.
% }
\cs_new_protected:Npn \__ltxtalk_render_block:nnnn #1#2#3#4
  {
    \OsgIfBlockTitledTF {#1}
      {
        \IfNoValueTF {#2}
          { \__talk_if_overlay:nT { all }
              { \__osgstyler_block_use:nnn {#1} {#3} {#4} } }
          { \__talk_if_overlay:nT {#2}
              { \__osgstyler_block_use:nnn {#1} {#3} {#4} } }
      }
      {
        \__osgstyler_block_use:nnn {#1} { }
          { \__ltxtalk_use_original_block:nnn {#2} {#3} {#4} }
      }
  }

\NewEnvironmentCopy { ltxtalk-original-block } { block }
\RenewDocumentEnvironment { block } { d <> m +b }
  { \__ltxtalk_render_block:nnnn { block } {#1} {#2} {#3} }
  { }

% alertblock/exampleblock keep the "structure" rule-color default and
% locally alias it to alert/example instead of overriding rule-color
% per instance, so a later \styleltxtalkblock customization of
% rule-color is not silently undone here. The alias targets the
% resolved osgstyler-structure/-alert/-example names (via \OsgColorName)
% rather than the bare, lttheme-only mirrored ones, since
% osgstyler-block resolves colors through \OsgColorName itself.
% Only provide the two variants while the class does not provide its own.
\cs_if_exist:cF { alertblock }
  {
    \NewDocumentEnvironment { alertblock } { d <> m +b }
      {
        \group_begin:
          \exp_args:Nee \colorlet
            { \OsgColorName{structure} } { \OsgColorName{alert} }
          \__ltxtalk_render_block:nnnn { alertblock } {#1} {#2} {#3}
        \group_end:
      }
      { }
  }
\cs_if_exist:cF { exampleblock }
  {
    \NewDocumentEnvironment { exampleblock } { d <> m +b }
      {
        \group_begin:
          \exp_args:Nee \colorlet
            { \OsgColorName{structure} } { \OsgColorName{example} }
          \__ltxtalk_render_block:nnnn { exampleblock } {#1} {#2} {#3}
        \group_end:
      }
      { }
  }

% Delegates to osgstyler's list palette (enumitem-backed) instead of
% redefining \labelitemi directly, so itemize customization here gains
% mode-awareness for free and goes through the same engine as every
% other theme's list styling.
\tl_new:N \l__ltxtalk_itemize_options_tl
\keys_define:nn { ltxtalk / itemize }
  {
    level-1 .code:n =
      \tl_put_right:Nn \l__ltxtalk_itemize_options_tl { 1 = {label=#1}, },
    level-2 .code:n =
      \tl_put_right:Nn \l__ltxtalk_itemize_options_tl { 2 = {label=#1}, },
    level-3 .code:n =
      \tl_put_right:Nn \l__ltxtalk_itemize_options_tl { 3 = {label=#1}, },
    level-4 .code:n =
      \tl_put_right:Nn \l__ltxtalk_itemize_options_tl { 4 = {label=#1}, }
  }
\NewDocumentCommand \setltxtalkitemize { m }
  {
    \tl_clear:N \l__ltxtalk_itemize_options_tl
    \keys_set:nn { ltxtalk / itemize } {#1}
    \exp_args:Nnx \DeclareOsgListPalette { ltxtalk-itemize }
      { itemize = { \l__ltxtalk_itemize_options_tl } }
    \UseOsgListPalette { ltxtalk-itemize }
  }

