\input regression-test.tex
\documentclass{ltx-talk}
\usepackage{ltxtalk-theme-magpie}
\usepackage{ltxtalk-theme-minimal}
\usepackage{ltxtalk-theme-hawk}
\usepackage{ltxtalk-theme-sparrow}
\usepackage{ltxtalk-theme-anchovy}
\usepackage{ltxtalk-theme-carp}
\useltxtalktheme{magpie}
\title{Compatibility test}
\author{Test author}
\date{2026-07-21}
\begin{document}
\ExplSyntaxOn
\clist_map_inline:nn { magpie, minimal, hawk, sparrow }
  {
    \useltxtalktheme{#1}
    \begin{frame}
      \frametitle{#1 theme}
      Test content.
    \end{frame}
  }
\useltxtalktheme{magpie}
\addltxtalktheme{anchovy}
\addltxtalktheme{carp}
\START
\TYPE{compat-anchovy:passed}
\TYPE{compat-carp:passed}
\TYPE{compat-magpie:passed}
\TYPE{compat-minimal:passed}
\TYPE{compat-hawk:passed}
\TYPE{compat-sparrow:passed}
\ExplSyntaxOff
\END
\end{document}
