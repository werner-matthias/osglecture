\DocumentMetadata{}
\input regression-test.tex
\documentclass{ltx-talk}
\usepackage{ltxtalk-theme-magpie}
\usepackage{ltxtalk-theme-minimal}

\title[T]{Titled block wrapper}
\author[A]{A}
\date{}

\begin{document}
\useltxtalktheme{magpie}

\begin{frame}
  \frametitle{Titled}
  \begin{block}{Bar title}
    Titled body.
  \end{block}
  \begin{block}<2->{Hidden on slide 1}
    Overlay-gated body.
  \end{block}
\end{frame}

% Switching themes resets the block to the lttheme default (the subtle
% "soft" titled look), not to magpie's title bar and not to plain.
\useltxtalktheme{minimal}
\begin{frame}
  \frametitle{Soft again}
  \begin{block}{Soft title}
    Soft body.
  \end{block}
\end{frame}

\START
\ExplSyntaxOn
% The default is titled (soft); the clear reset magpie's title bar to it.
\OsgIfBlockTitledTF { block }
  { \TYPE { block-titled-after-minimal:passed } }
  { \TYPE { block-titled-after-minimal:FAILED } }

% Re-activate magpie: still titled.
\useltxtalktheme { magpie }
\OsgIfBlockTitledTF { block }
  { \TYPE { block-titled-after-magpie:passed } }
  { \TYPE { block-titled-after-magpie:FAILED } }
\ExplSyntaxOff
\END
\end{document}
