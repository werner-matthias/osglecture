\input regression-test.tex
\DocumentMetadata{tagging=on,lang=de-DE}
\documentclass{ltx-talk}
\usepackage{ltxtalk-theme-hawk}
\useltxtalktheme{hawk}

\title{Auto-Section-Title-Test}
\author{A. Beispiel}
\date{\today}

\ExplSyntaxOn
\NewDocumentCommand \CHECKTITLE { m } {
  \str_if_eq:eeTF {#1} { \g__talk_frame_title_tl }
    { \TYPE { title:passed } }
    { \TYPE { title:FAILED=\g__talk_frame_title_tl } }
}
\NewDocumentCommand \CHECKSUBTITLE { m } {
  \str_if_eq:eeTF {#1} { \g__talk_frame_subtitle_tl }
    { \TYPE { subtitle:passed } }
    { \TYPE { subtitle:FAILED=\g__talk_frame_subtitle_tl } }
}
\ExplSyntaxOff

\begin{document}
\START

% Vor dem Einschalten: unveraendertes Verhalten, keine Uebernahme.
\section{Unberuehrt}
\begin{frame}
  \frametitle{Eigener Titel}
  \CHECKTITLE{Eigener Titel}
  \CHECKSUBTITLE{}
\end{frame}

\ExplSyntaxOn
\setltxtalkheadingbehavior{auto-section-title=true}
\ExplSyntaxOff

% Abschnittstitel ohne gegebenen Frametitel: wird zum Titel, kein Subtitel.
\section{Erster Abschnitt}
\begin{frame}
  \frametitle{}
  \CHECKTITLE{Erster Abschnitt}
  \CHECKSUBTITLE{}
\end{frame}

% Folgefolie im selben Abschnitt: Merker ist verbraucht, normales Verhalten.
\begin{frame}
  \frametitle{Zweite Folie}
  \CHECKTITLE{Zweite Folie}
  \CHECKSUBTITLE{}
\end{frame}

% Abschnitt und Unterabschnitt ohne Folie dazwischen: der Unterabschnitt
% (der speziellere, zuletzt genannte) gewinnt.
\section{Zweiter Abschnitt}
\subsection{Ein Unterabschnitt}
\begin{frame}
  \frametitle{Gegebener Titel}
  \CHECKTITLE{Ein Unterabschnitt}
  \CHECKSUBTITLE{Gegebener Titel}
\end{frame}

% Gegebener Titel UND Subtitel: der eigene Subtitel entfaellt, weil der
% demotierte Titel den Subtitel-Platz schon belegt.
\section{Titel und Subtitel zugleich}
\begin{frame}
  \frametitle{Gegebener Titel}
  \framesubtitle{Eigener Subtitel}
  \CHECKTITLE{Titel und Subtitel zugleich}
  \CHECKSUBTITLE{Gegebener Titel}
\end{frame}

% Ein framesubtitle in einer normalen (nicht-Abschnittsanfangs-)Folie bleibt
% unangetastet.
\begin{frame}
  \frametitle{Normale Folie}
  \framesubtitle{Normaler Subtitel}
  \CHECKTITLE{Normale Folie}
  \CHECKSUBTITLE{Normaler Subtitel}
\end{frame}

\clearpage
\SHOWPDFTAGS

\end{document}
