       Layout:TextAlign="Justify"
       rolemaps-to="P"
      >
     <?MarkedContent page="1" ?>First body paragraph of the block, long enough to wrap onto a second line so a line break is exercised inside the block body.
    </text>
   </text-unit>
   <text-unit xmlns="https://www.latex-project.org/ns/dflt"
