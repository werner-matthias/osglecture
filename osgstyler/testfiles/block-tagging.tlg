       xmlns:Layout="http://iso.org/pdf/ssn/Layout"
       Layout:TextAlign="Justify"
       rolemaps-to="P"
      >
     <?MarkedContent page="1" ?>The soft trait adds a tinted head and a thin rule; both are artifacts, so the structure must stay just as flat as the title-bar block.
    </text>
   </text-unit>
