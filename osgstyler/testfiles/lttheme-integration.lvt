\input regression-test.tex
\documentclass{article}
\usepackage{osgstyler}
\usepackage{lttalk-theme}

\begin{document}
\START
\TYPE{active=\OsgActiveColorPalette}
\extractcolorspec{osgstyler-primary}\TestColor
\TYPE{initial-primary=\TestColor}
\uselttalktheme{test}
\extractcolorspec{osgstyler-primary}\TestColor
\TYPE{theme-primary=\TestColor}
\addlttalktheme{extra}
\extractcolorspec{osgstyler-accent}\TestColor
\TYPE{added-accent=\TestColor}
\setlttalkcolors{160,30,30}
\extractcolorspec{osgstyler-alert}\TestColor
\TYPE{changed-alert=\TestColor}
\END
\end{document}
