\input regression-test.tex
\DocumentMetadata{tagging=on,lang=en-US}
\documentclass{article}
\usepackage{osgstyler}

\DeclareOsgColorPalette{p}{
  primary   = {model=HTML, value=204070},
  structure = {alias=primary},
  text      = {model=HTML, value=111111},
  background = {model=HTML, value=FFFFFF}
}
\DeclareOsgBlockInstance{tb}{traits={titlebar}}
\NewOsgStyledEnvironment{tb}{tb}{none}[1]{#1}

\DeclareOsgBlockInstance{softb}{traits={soft}}
\NewOsgStyledEnvironment{softb}{softb}{none}[1]{#1}

\begin{document}
\UseOsgColorPalette{p}

A paragraph before the block.

\begin{tb}{The block title}
  First body paragraph of the block, long enough to wrap onto a
  second line so a line break is exercised inside the block body.

  Second body paragraph.
\end{tb}

A paragraph after the block.

\begin{softb}{A soft block}
  The soft trait adds a tinted head and a thin rule; both are artifacts,
  so the structure stays flat: title and body are plain text-unit>text
  siblings of the surrounding text, no Div.
\end{softb}

A paragraph after the soft block.

% The title-bar block carries a tinted body area, so it is a box
% (fcolorbox+minipage): exactly one Div per block, holding clean
% text-unit>text children with no nesting -- the same shape as the card
% default. The soft block stays fully flowing, no Div at all.
\clearpage
\SHOWPDFTAGS
\end{document}
