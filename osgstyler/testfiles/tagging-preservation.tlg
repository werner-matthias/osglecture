<PDF>
 <StructTreeRoot>
  <Document xmlns="http://iso.org/pdf2/ssn"
     id="ID.00002"
    >
   <text-unit xmlns="https://www.latex-project.org/ns/dflt"
      id="ID.00006"
      rolemaps-to="Part"
     >
    <text xmlns="https://www.latex-project.org/ns/dflt"
       id="ID.00007"
       xmlns:Layout="http://iso.org/pdf/ssn/Layout"
       Layout:TextAlign="Justify"
       rolemaps-to="P"
      >
     <?MarkedContent page="1" ?>Plain text, 
     <Em xmlns="http://iso.org/pdf2/ssn"
        id="ID.00008"
       >
      <?MarkedContent page="1" ?>native emphasis
     </Em>
     <?MarkedContent page="1" ?>, strong-looking text, 
     <?MarkedContent page="1" ?>
     <?MarkedContent page="1" ?>underlined text, 
     <?MarkedContent page="1" ?>high
     <?MarkedContent page="1" ?>
     <?MarkedContent page="1" ?>lighted text, and framed text remain in one accessible paragraph.
    </text>
   </text-unit>
  </Document>
 </StructTreeRoot>
