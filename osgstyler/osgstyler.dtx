        \l__osgstyler_decoration_color_tl
      \__osgstyler_decoration_default:Nn \l__osgstyler_decoration_color_tl { text }
      \tl_set:Nx \l__osgstyler_decoration_color_tl
        { \OsgColorName { \l__osgstyler_decoration_color_tl } }
      \__osgstyler_decoration_value:nnnnN {#1}{line}{#2}{thickness}
        \l__osgstyler_decoration_value_tl
      \__osgstyler_decoration_default:Nn \l__osgstyler_decoration_value_tl { rule/thin }
      \exp_args:NV \__osgstyler_decoration_metric_resolve:nN
        \l__osgstyler_decoration_value_tl \l__osgstyler_decoration_value_tl
