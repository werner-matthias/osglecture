\end{options}
\ldeen{Die portablen Fontslots sind}{The portable font slots are}
\code{main}, \code{companion}, \code{display}, \code{accent}, \code{mono},
\code{math}, \code{symbol}.
\begin{options}
  \opt{colors-only}
    \ldeen{Paketoption (kein Templateschlüssel); siehe
