% \ldeen*{@1 schreibt die aufgelöste Farbe sowohl nativ über @2 als
% auch klassisch über @3: \cls*{ltx-talk} und vergleichbare,
% modernisierte Klassen ersetzen \cs{color} durch eine auf @2s eigenem
% Modul aufbauende Fassung, die nur nativ registrierte Farben kennt;
% Werkzeuge wie \cs{extractcolorspec} und unveränderte Klassen kennen
% dagegen nur die klassische Registrierung -- nur die doppelte
% Schreibweise bedient beide Seiten zuverlässig. Ein dritter Parameter
% trennt bewusst "`welcher Slot liefert die Daten"' (\#2, nach
% Alias-Auflösung der eigentliche Ressourcen-Besitzer) von "`unter
% welchem Namen wird geschrieben"' (\#3, der ursprünglich angefragte
% Slot): Ein Alias-Slot bekommt dadurch seine eigene Farbe direkt
% zugewiesen, statt sie nachträglich unter @4 auf die Besitzer-Farbe zu
% verweisen -- @4 selbst ist, anders als @2/@3, grundsätzlich nur lokal
% gültig und würde eine Zuweisung aus der Deklarationszeit nicht
% zuverlässig bis zum Dokumentkörper erhalten.}{@1 writes the resolved
% color both natively via @2 and classically via @3: \cls*{ltx-talk} and
% similarly modernized classes replace \cs{color} with a version built
% on @2's own module, which only recognizes natively registered colors;
% tools such as \cs{extractcolorspec} and unmodified classes, in turn,
% only recognize the classical registration -- only writing both
% reliably serves either side. A third parameter deliberately separates
% "`which slot supplies the data"' (\#2, the actual resource owner after
% alias resolution) from "`under which name is it written"' (\#3, the
% originally requested slot): an alias slot thus gets its own color
% assigned directly, instead of pointing it at the owner's color
% afterward via @4 -- @4 itself, unlike @2/@3, is fundamentally
% local-only and would not reliably carry an assignment made at
% declaration time through to the document body.}
% {\cs{color\_set:nnn}}{\pkg*{l3color}}{\cs{definecolor}}{\cs{color\_set\_eq:nn}}
\cs_new_protected:Npn \__osgstyler_color_define_from_resource:nnn #1#2#3
  {
    \prop_get:NnN \g__osgstyler_color_palette_prop
      { #1 / #2 / model } \l__osgstyler_color_resolution_model_tl
    \prop_get:NnN \g__osgstyler_color_palette_prop
      { #1 / #2 / value } \l__osgstyler_color_resolution_target_tl
    \tl_set:Nx \l__osgstyler_color_name_tl
      { \__osgstyler_color_name:n {#3} }
    \color_set:VVV
      \l__osgstyler_color_name_tl
      \l__osgstyler_color_resolution_model_tl
      \l__osgstyler_color_resolution_target_tl
    \use:e
      {
        \exp_not:N \definecolor
          { \l__osgstyler_color_name_tl }
          { \l__osgstyler_color_resolution_model_tl }
          { \l__osgstyler_color_resolution_target_tl }
      }
  }
\cs_generate_variant:Nn \__osgstyler_color_define_from_resource:nnn { nVn }

\cs_new_protected:Npn \__osgstyler_color_palette_use:n #1
  {
    \prop_if_in:NnTF \g__osgstyler_color_palette_prop { #1 / declared }
      {
        \tl_gset:Nn \g__osgstyler_color_palette_tl {#1}
        \clist_map_inline:Nn \c__osgstyler_color_slots_clist
          {
            \__osgstyler_color_slot_resolve:nnN {#1}{##1} \l_tmpa_tl
            \tl_if_empty:NTF \l_tmpa_tl
              {
                \prop_if_in:NnT \c__osgstyler_color_absolute_default_prop {##1}
                  {
                    \prop_get:NnN \c__osgstyler_color_absolute_default_prop
                      {##1} \l_tmpb_tl
                    \tl_set:Nx \l_tmpc_tl { \__osgstyler_color_name:n {##1} }
                    \str_case:VnF \l_tmpb_tl
                      {
                        { black }
                          {
                            \exp_args:NV \color_set:nnn \l_tmpc_tl { gray } { 0 }
                            \exp_args:Nee \colorlet { \l_tmpc_tl } { black }
                          }
                        { white }
                          {
                            \exp_args:NV \color_set:nnn \l_tmpc_tl { gray } { 1 }
                            \exp_args:Nee \colorlet { \l_tmpc_tl } { white }
                          }
                      }
                      { }
                  }
              }
              {
                \__osgstyler_color_define_from_resource:nVn
                  {#1} \l_tmpa_tl {##1}
              }
          }
      }
      { \msg_error:nnn { osgstyler } { unknown-color-palette } {#1} }
  }

