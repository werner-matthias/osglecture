    Section~\ref{sec:fonts:colors-only}.}
\end{commands}
\begin{options}
  \keyval{font}{\ldeen{Fontname}{font name}}
    \ldeen{Ein \pkg*{fontspec}-Fontname.}{A \pkg*{fontspec} font name.}
  \keyval{features}{\pkg*{fontspec} \ldeen{Optionen}{options}}
    \ldeen{Werden unverändert an \pkg*{fontspec} weitergereicht.}{Passed
    through to \pkg*{fontspec} unchanged.}
  \keyval{alias}{\ldeen{anderer Slot}{other slot}}
    \ldeen{Übernimmt die Schrift eines anderen Slots derselben Palette.}
    {Adopts the font of another slot in the same palette.}
  \keyval{description}{\ldeen{Text}{text}}
    \ldeen{Rein informativ, für Werkzeuge/Themes; wird von \osgstyler{}
