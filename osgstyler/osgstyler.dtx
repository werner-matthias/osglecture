% Font palettes contain a deliberately small, portable set of relational
% slots.  A slot either owns a fontspec resource or aliases another slot.
% The distinction is explicit so that a font called, for example, "main"
% can never be mistaken for an alias.
\clist_const:Nn \c__osgstyler_font_slots_clist
  { main, companion, display, accent, mono, math, symbol }

\prop_new:N \g__osgstyler_font_palette_prop
\prop_new:N \g__osgstyler_font_family_prop
\tl_new:N \g__osgstyler_font_palette_tl
\tl_new:N \l__osgstyler_font_name_tl
\tl_new:N \l__osgstyler_font_features_tl
\tl_new:N \l__osgstyler_font_alias_tl
\tl_new:N \l__osgstyler_font_description_tl
\tl_new:N \l__osgstyler_font_resolution_kind_tl
\tl_new:N \l__osgstyler_font_resolution_target_tl
\tl_new:N \l__osgstyler_font_resolution_discard_tl
\tl_new:N \l__osgstyler_font_load_name_tl
\tl_new:N \l__osgstyler_font_load_features_tl
\tl_new:N \l__osgstyler_font_load_family_tl
\seq_new:N \l__osgstyler_font_resolution_seq

\msg_new:nnnn { osgstyler } { unknown-font-slot }
  { Unknown~font~palette~slot~'#1'. }
  { The~portable~slots~are~main,~companion,~display,~accent,~mono,~math,~and~symbol. }
\msg_new:nnnn { osgstyler } { incomplete-font-resource }
  { Font~slot~'#2'~in~palette~'#1'~does~not~specify~a~font~or~an~alias. }
  { Use~font={...}~for~a~resource~or~alias=...~for~an~alias. }
\msg_new:nnnn { osgstyler } { conflicting-font-resource }
  { Font~slot~'#2'~in~palette~'#1'~specifies~both~a~font~and~an~alias. }
  { A~slot~must~either~own~a~fontspec~resource~or~alias~another~slot. }
\msg_new:nnnn { osgstyler } { missing-main-font }
  { Font~palette~'#1'~does~not~define~the~required~slot~'main'. }
  { Add~main={font={...}}~to~the~palette. }
\msg_new:nnnn { osgstyler } { unknown-font-palette }
  { Unknown~font~palette~'#1'. }
  { Declare~it~with~\token_to_str:N\DeclareOsgFontPalette~before~using~it. }
\msg_new:nnnn { osgstyler } { unavailable-font-slot }
  { Font~slot~'#2'~is~not~available~in~palette~'#1'. }
  { Define~that~slot~or~one~of~its~standard~fallbacks. }
\msg_new:nnnn { osgstyler } { font-alias-cycle }
  { Font~palette~'#1'~contains~an~alias~cycle~at~slot~'#2'. }
  { Change~the~aliases~so~that~they~eventually~resolve~to~a~font~resource. }
\msg_new:nnnn { osgstyler } { math-font-selection }
  { Font~slot~'math'~cannot~be~selected~as~a~text~font. }
  { Query~it~for~a~unicode-math~adapter;~use~another~slot~for~text. }

\keys_define:nn { osgstyler / font-resource }
  {
    font .tl_set:N = \l__osgstyler_font_name_tl,
    features .tl_set:N = \l__osgstyler_font_features_tl,
    alias .tl_set:N = \l__osgstyler_font_alias_tl,
    description .tl_set:N = \l__osgstyler_font_description_tl,
  }

\cs_new_protected:Npn \__osgstyler_font_resource_store:nnn #1#2#3
  {
    \tl_clear:N \l__osgstyler_font_name_tl
    \tl_clear:N \l__osgstyler_font_features_tl
    \tl_clear:N \l__osgstyler_font_alias_tl
    \tl_clear:N \l__osgstyler_font_description_tl
    \keys_set:nn { osgstyler / font-resource } {#3}
    \bool_lazy_and:nnTF
      { ! \tl_if_empty_p:N \l__osgstyler_font_name_tl }
      { ! \tl_if_empty_p:N \l__osgstyler_font_alias_tl }
      { \msg_error:nnnn { osgstyler } { conflicting-font-resource } {#1} {#2} }
      {
        \tl_if_empty:NTF \l__osgstyler_font_name_tl
          {
            \tl_if_empty:NTF \l__osgstyler_font_alias_tl
              { \msg_error:nnnn { osgstyler } { incomplete-font-resource } {#1} {#2} }
              {
                \clist_if_in:NVTF \c__osgstyler_font_slots_clist
                  \l__osgstyler_font_alias_tl
                  {
                    \prop_gput:Nne \g__osgstyler_font_palette_prop
                      { #1 / #2 / kind } { alias }
                    \prop_gput:NnV \g__osgstyler_font_palette_prop
                      { #1 / #2 / alias } \l__osgstyler_font_alias_tl
                  }
                  { \msg_error:nne { osgstyler } { unknown-font-slot }
                      \l__osgstyler_font_alias_tl }
              }
          }
          {
            \prop_gput:Nnn \g__osgstyler_font_palette_prop
              { #1 / #2 / kind } { resource }
            \prop_gput:NnV \g__osgstyler_font_palette_prop
              { #1 / #2 / font } \l__osgstyler_font_name_tl
            \prop_gput:NnV \g__osgstyler_font_palette_prop
              { #1 / #2 / features } \l__osgstyler_font_features_tl
          }
        \tl_if_empty:NF \l__osgstyler_font_description_tl
          { \prop_gput:NnV \g__osgstyler_font_palette_prop
              { #1 / #2 / description } \l__osgstyler_font_description_tl }
      }
  }

\cs_new_protected:Npn \__osgstyler_font_palette_declare:nn #1#2
  {
    \clist_map_inline:Nn \c__osgstyler_font_slots_clist
      {
        \clist_map_inline:nn { kind, font, features, alias, description }
          { \prop_gremove:Nn \g__osgstyler_font_palette_prop
              { #1 / ##1 / ####1 } }
      }
    \prop_gremove:Nn \g__osgstyler_font_palette_prop { #1 / declared }
    \clist_map_inline:Nn \c__osgstyler_font_slots_clist
      {
        \keys_define:nn { osgstyler / font-palette / #1 }
          { ##1 .code:n = \__osgstyler_font_resource_store:nnn {#1}{##1}{####1} }
      }
    \keys_set:nn { osgstyler / font-palette / #1 } {#2}
    \prop_if_in:NnF \g__osgstyler_font_palette_prop { #1 / main / kind }
      { \msg_error:nnn { osgstyler } { missing-main-font } {#1} }
    \prop_gput:Nnn \g__osgstyler_font_palette_prop { #1 / declared } { true }
  }

\NewDocumentCommand \DeclareOsgFontPalette { m m }
  { \__osgstyler_font_palette_declare:nn {#1}{#2} }

% Default fallbacks deliberately express suitability, not morphology.
\cs_new:Npn \__osgstyler_font_fallback:n #1
  {
    \str_case:nnF {#1}
      {
        { companion } { main }
        { display }   { companion }
        { accent }    { companion }
        { symbol }    { main }
      }
      { }
  }

\cs_new_protected:Npn \__osgstyler_font_resolve:nnN #1#2#3
  {
    \seq_if_in:NnTF \l__osgstyler_font_resolution_seq {#2}
      {
        \msg_error:nnnn { osgstyler } { font-alias-cycle } {#1}{#2}
        \tl_clear:N #3
      }
      {
        \seq_put_right:Nn \l__osgstyler_font_resolution_seq {#2}
        \prop_get:NnNTF \g__osgstyler_font_palette_prop
          { #1 / #2 / kind } \l__osgstyler_font_resolution_kind_tl
          {
            \str_if_eq:VnTF \l__osgstyler_font_resolution_kind_tl { resource }
              { \tl_set:Nn #3 {#2} }
              {
                \prop_get:NnN \g__osgstyler_font_palette_prop
                  { #1 / #2 / alias } \l__osgstyler_font_resolution_target_tl
                \exp_args:NnV \__osgstyler_font_resolve:nnN {#1}
                  \l__osgstyler_font_resolution_target_tl #3
              }
          }
          {
            \tl_set:Ne \l__osgstyler_font_resolution_target_tl
              { \__osgstyler_font_fallback:n {#2} }
            \tl_if_empty:NTF \l__osgstyler_font_resolution_target_tl
              {
                \msg_error:nnnn { osgstyler } { unavailable-font-slot } {#1}{#2}
                \tl_clear:N #3
              }
              { \exp_args:NnV \__osgstyler_font_resolve:nnN {#1}
                  \l__osgstyler_font_resolution_target_tl #3 }
          }
        \seq_pop_right:NN \l__osgstyler_font_resolution_seq
          \l__osgstyler_font_resolution_discard_tl
      }
  }

\cs_new_protected:Npn \__osgstyler_font_slot_resolve:nnN #1#2#3
  {
    \clist_if_in:NnTF \c__osgstyler_font_slots_clist {#2}
      {
        \seq_clear:N \l__osgstyler_font_resolution_seq
        \__osgstyler_font_resolve:nnN {#1}{#2} #3
      }
      {
        \msg_error:nnn { osgstyler } { unknown-font-slot } {#2}
        \tl_clear:N #3
      }
  }

\NewDocumentCommand \OsgFontPaletteResolvedSlotTo { m m m }
  { \__osgstyler_font_slot_resolve:nnN {#1}{#2} #3 }

\NewExpandableDocumentCommand \OsgFontPaletteValue { m m m }
  { \prop_item:Nn \g__osgstyler_font_palette_prop { #1 / #2 / #3 } }

\cs_new_protected:Npn \__osgstyler_font_palette_use:n #1
  {
    \prop_if_in:NnTF \g__osgstyler_font_palette_prop { #1 / declared }
      {
        \tl_gset:Nn \g__osgstyler_font_palette_tl {#1}
        \clist_map_inline:Nn \c__osgstyler_font_slots_clist
          {
            \str_if_eq:nnF {##1}{math}
              {
                \__osgstyler_font_slot_resolve:nnN {#1}{##1} \l_tmpa_tl
                \tl_if_empty:NF \l_tmpa_tl
                  {
                    \prop_if_in:NeF \g__osgstyler_font_family_prop
                      { #1 / \l_tmpa_tl }
                      {
                        \prop_get:NeN \g__osgstyler_font_palette_prop
                          { #1 / \l_tmpa_tl / font }
                          \l__osgstyler_font_load_name_tl
                        \prop_get:NeN \g__osgstyler_font_palette_prop
                          { #1 / \l_tmpa_tl / features }
                          \l__osgstyler_font_load_features_tl
                        \exp_args:NNVV \fontspec_gset_family:Nnn
                          \l__osgstyler_font_load_family_tl
                          \l__osgstyler_font_load_features_tl
                          \l__osgstyler_font_load_name_tl
                        \prop_gput:NeV \g__osgstyler_font_family_prop
                          { #1 / \l_tmpa_tl }
                          \l__osgstyler_font_load_family_tl
                      }
                  }
              }
          }
      }
      { \msg_error:nnn { osgstyler } { unknown-font-palette } {#1} }
  }

\NewDocumentCommand \UseOsgFontPalette { m }
  { \__osgstyler_font_palette_use:n {#1} }

\NewExpandableDocumentCommand \OsgActiveFontPalette { }
  { \tl_use:N \g__osgstyler_font_palette_tl }

\cs_new_protected:Npn \__osgstyler_font_select:n #1
  {
    \str_if_eq:nnTF {#1}{math}
      { \msg_error:nn { osgstyler } { math-font-selection } }
      {
        \tl_if_empty:NTF \g__osgstyler_font_palette_tl
          { \msg_error:nnn { osgstyler } { unknown-font-palette } { } }
          {
            \exp_args:NV \__osgstyler_font_slot_resolve:nnN
              \g__osgstyler_font_palette_tl {#1} \l_tmpa_tl
            \prop_get:NeN \g__osgstyler_font_family_prop
              { \g__osgstyler_font_palette_tl / \l_tmpa_tl } \l_tmpb_tl
            \fontfamily{\l_tmpb_tl}\selectfont
          }
      }
  }

\NewDocumentCommand \UseOsgFont { m }
  { \__osgstyler_font_select:n {#1} }

\DeclareOsgFontPalette { osgstyler-default }
  {
    main      = { font = { Latin Modern Roman } },
    companion = { font = { Latin Modern Sans } },
    display   = { alias = companion },
    accent    = { alias = companion },
    mono      = { font = { Latin Modern Mono } },
    symbol    = { alias = main }
  }
\UseOsgFontPalette { osgstyler-default }

% Color palettes deliberately mirror lttheme's public color vocabulary and
% value syntax.  osgstyler owns neutral, stable color names; a presentation
% adapter can copy these colors without making the general package depend on
% lttheme.
\clist_const:Nn \c__osgstyler_color_slots_clist
  { primary, secondary, accent, text, background, structure, alert, example }

\prop_new:N \g__osgstyler_color_palette_prop
\tl_new:N \g__osgstyler_color_palette_tl
\seq_new:N \l__osgstyler_color_resolution_seq
\tl_new:N \l__osgstyler_color_resolution_model_tl
\tl_new:N \l__osgstyler_color_resolution_target_tl
\tl_new:N \l__osgstyler_color_resolution_discard_tl
\tl_new:N \l__osgstyler_color_name_tl

\msg_new:nnnn { osgstyler } { unknown-color-slot }
  { Unknown~color~palette~slot~'#1'. }
  { The~portable~slots~are~primary,~secondary,~accent,~text,~background,~structure,~alert,~and~example. }
\msg_new:nnnn { osgstyler } { missing-primary-color }
  { Color~palette~'#1'~does~not~define~the~required~slot~'primary'. }
  { Add~primary={model}{specification}~to~the~palette. }
\msg_new:nnnn { osgstyler } { unknown-color-palette }
  { Unknown~color~palette~'#1'. }
  { Declare~it~with~\token_to_str:N\DeclareOsgColorPalette~before~using~it. }
\msg_new:nnnn { osgstyler } { color-alias-cycle }
  { Color~palette~'#1'~contains~an~alias~cycle~at~slot~'#2'. }
  { Change~the~aliases~so~that~they~eventually~resolve~to~a~color~resource. }
\msg_new:nnnn { osgstyler } { invalid-color-alias }
  { Color~slot~'#2'~in~palette~'#1'~aliases~unknown~slot~'#3'. }
  { Use~one~of~the~portable~color~slots~as~the~alias~target. }

\cs_new_protected:Npn \__osgstyler_color_store:nnn #1#2#3
  { \__osgstyler_color_store_aux:nnnn {#1}{#2} #3 }

\cs_new_protected:Npn \__osgstyler_color_store_aux:nnnn #1#2#3#4
  {
    \str_if_eq:nnTF {#3}{alias}
      {
        \clist_if_in:NnTF \c__osgstyler_color_slots_clist {#4}
          {
            \prop_gput:Nnn \g__osgstyler_color_palette_prop
              { #1 / #2 / kind } { alias }
            \prop_gput:Nnn \g__osgstyler_color_palette_prop
              { #1 / #2 / alias } {#4}
          }
          { \msg_error:nnnnn { osgstyler } { invalid-color-alias }
              {#1}{#2}{#4} }
      }
      {
        \prop_gput:Nnn \g__osgstyler_color_palette_prop
          { #1 / #2 / kind } { resource }
        \prop_gput:Nnn \g__osgstyler_color_palette_prop
          { #1 / #2 / model } {#3}
        \prop_gput:Nnn \g__osgstyler_color_palette_prop
          { #1 / #2 / specification } {#4}
      }
  }

\cs_new_protected:Npn \__osgstyler_color_palette_declare:nn #1#2
  {
    \clist_map_inline:Nn \c__osgstyler_color_slots_clist
      {
        \clist_map_inline:nn { kind, model, specification, alias }
          { \prop_gremove:Nn \g__osgstyler_color_palette_prop
              { #1 / ##1 / ####1 } }
        \keys_define:nn { osgstyler / color-palette / #1 }
          { ##1 .code:n = \__osgstyler_color_store:nnn {#1}{##1}{####1} }
      }
    \prop_gremove:Nn \g__osgstyler_color_palette_prop { #1 / declared }
    \keys_set:nn { osgstyler / color-palette / #1 } {#2}
    \prop_if_in:NnF \g__osgstyler_color_palette_prop { #1 / primary / kind }
      { \msg_error:nnn { osgstyler } { missing-primary-color } {#1} }
    \prop_gput:Nnn \g__osgstyler_color_palette_prop { #1 / declared } { true }
  }

\NewDocumentCommand \DeclareOsgColorPalette { m m }
  { \__osgstyler_color_palette_declare:nn {#1}{#2} }

\cs_new:Npn \__osgstyler_color_fallback:n #1
  {
    \str_case:nnF {#1}
      {
        { secondary }  { primary }
        { accent }     { secondary }
        { structure }  { primary }
        { alert }      { primary }
        { example }    { primary }
        { text }       { primary }
        { background } { primary }
      }
      { }
  }

\cs_new_protected:Npn \__osgstyler_color_resolve:nnN #1#2#3
  {
    \seq_if_in:NnTF \l__osgstyler_color_resolution_seq {#2}
      {
        \msg_error:nnnn { osgstyler } { color-alias-cycle } {#1}{#2}
        \tl_clear:N #3
      }
      {
        \seq_put_right:Nn \l__osgstyler_color_resolution_seq {#2}
        \prop_get:NnNTF \g__osgstyler_color_palette_prop
          { #1 / #2 / kind } \l__osgstyler_color_resolution_model_tl
          {
            \str_if_eq:VnTF \l__osgstyler_color_resolution_model_tl { resource }
              { \tl_set:Nn #3 {#2} }
              {
                \prop_get:NnN \g__osgstyler_color_palette_prop
                  { #1 / #2 / alias } \l__osgstyler_color_resolution_target_tl
                \exp_args:NnV \__osgstyler_color_resolve:nnN {#1}
                  \l__osgstyler_color_resolution_target_tl #3
              }
          }
          {
            \tl_set:Ne \l__osgstyler_color_resolution_target_tl
              { \__osgstyler_color_fallback:n {#2} }
            \tl_if_empty:NTF \l__osgstyler_color_resolution_target_tl
              { \tl_clear:N #3 }
              { \exp_args:NnV \__osgstyler_color_resolve:nnN {#1}
                  \l__osgstyler_color_resolution_target_tl #3 }
          }
        \seq_pop_right:NN \l__osgstyler_color_resolution_seq
          \l__osgstyler_color_resolution_discard_tl
      }
  }

\cs_new_protected:Npn \__osgstyler_color_slot_resolve:nnN #1#2#3
  {
    \clist_if_in:NnTF \c__osgstyler_color_slots_clist {#2}
      {
        \seq_clear:N \l__osgstyler_color_resolution_seq
        \__osgstyler_color_resolve:nnN {#1}{#2} #3
      }
      {
        \msg_error:nnn { osgstyler } { unknown-color-slot } {#2}
        \tl_clear:N #3
      }
  }

\NewDocumentCommand \OsgColorPaletteResolvedSlotTo { m m m }
  { \__osgstyler_color_slot_resolve:nnN {#1}{#2} #3 }

\NewExpandableDocumentCommand \OsgColorPaletteValue { m m m }
  { \prop_item:Nn \g__osgstyler_color_palette_prop { #1 / #2 / #3 } }

\cs_new:Npn \__osgstyler_color_name:n #1 { osgstyler-#1 }

\NewExpandableDocumentCommand \OsgColorName { m }
  { \__osgstyler_color_name:n {#1} }

\cs_new_protected:Npn \__osgstyler_color_define_from_resource:nn #1#2
  {
    \prop_get:NnN \g__osgstyler_color_palette_prop
      { #1 / #2 / model } \l__osgstyler_color_resolution_model_tl
    \prop_get:NnN \g__osgstyler_color_palette_prop
      { #1 / #2 / specification } \l__osgstyler_color_resolution_target_tl
    \tl_set:Nx \l__osgstyler_color_name_tl
      { \__osgstyler_color_name:n {#2} }
    \use:e
      {
        \exp_not:N \definecolor
          { \l__osgstyler_color_name_tl }
          { \l__osgstyler_color_resolution_model_tl }
          { \l__osgstyler_color_resolution_target_tl }
      }
  }

\cs_new_protected:Npn \__osgstyler_color_palette_use:n #1
  {
    \prop_if_in:NnTF \g__osgstyler_color_palette_prop { #1 / declared }
