  }
  { \__osgstyler_block_typeset:n {#1} }

% \ldeen*{Einzige Aufrufkonvention für den Block-Template-Typ: Titel und
% Body getrennt übergeben. Aufrufstellen ohne Titel geben \code{\{\}}.}
% {The one calling convention for the block template type: pass title and
% body separately. Call sites without a title pass \code{\{\}}.}
\cs_new_protected:Npn \__osgstyler_block_use:nnn #1#2#3
  {
    \tl_set:Nn \l__osgstyler_block_title_tl {#2}
    \UseInstance { osgstyler-block } {#1} {#3}
  }

% \ldeen*{Muss expandierbar sein: der Wert landet als Farbargument in
% \cs{colorbox}/\cs{fcolorbox}, die ihr Argument expandieren.}
% {Must stay expandable: the value ends up as the colour argument of
% \cs{colorbox}/\cs{fcolorbox}, which expand their argument.}
\cs_new:Npn \__osgstyler_block_bg:n #1
  { \str_if_eq:nnTF {#1} { none } { \OsgColorName{background} } { \OsgColorName{#1} } }
\cs_generate_variant:Nn \__osgstyler_block_bg:n { V }

% \ldeen*{Kastenhintergrund + Rahmen. Ohne \code{corner-radius} und
% \code{shadow} genügt \cs{fcolorbox} (\cs{fboxsep} ist bei den Aufrufern
% Null). Sind Ecken oder Schatten gewünscht, zeichnet \pkg{pgfcore} die
% Form: der zu umrahmende Kasten wird vermessen, Schatten/Fläche/Rand
% laufen als \code{artifact}-\cs{rlap} dahinter, der Kasten selbst behält
% seine Struktur. \pkg{pgfcore} lädt das Theme (z.\,B.\ \pkg*{magpie});
% fehlt es, fällt der Renderer auf eckig ohne Schatten zurück.}
% {Box background + frame. Without \code{corner-radius} and \code{shadow}
% an \cs{fcolorbox} is enough (\cs{fboxsep} is zero at the call sites).
% When corners or a shadow are wanted, \pkg{pgfcore} draws the shape: the
% box to be framed is measured, shadow/fill/border run behind it as an
% \code{artifact} \cs{rlap}, and the box keeps its own structure. The theme
% loads \pkg{pgfcore} (e.g.\ \pkg*{magpie}); without it the renderer falls
% back to square with no shadow.}
\box_new:N \l__osgstyler_block_content_box
\msg_new:nnn { osgstyler } { no-pgfcore }
  { Rounded~corners~and~shadows~on~blocks~need~\token_to_str:N\usepackage
    {pgfcore}.~Falling~back~to~a~square~frame. }
\bool_new:N \g__osgstyler_block_pgf_warned_bool
\cs_new_protected:Npn \__osgstyler_block_fbox:nnn #1#2#3
  {
    \bool_lazy_and:nnTF
      { \cs_if_exist_p:N \pgfpicture }
      {
        \bool_lazy_or_p:nn
          { \dim_compare_p:nNn \l__osgstyler_block_corner_radius_dim > \c_zero_dim }
          { \bool_if_p:N \l__osgstyler_block_shadow_bool }
      }
      { \__osgstyler_block_fbox_pgf:nnn {#1} {#2} {#3} }
      {
        \bool_lazy_and:nnT
          { ! \cs_if_exist_p:N \pgfpicture }
          {
            \bool_lazy_or_p:nn
              { \dim_compare_p:nNn \l__osgstyler_block_corner_radius_dim > \c_zero_dim }
              { \bool_if_p:N \l__osgstyler_block_shadow_bool }
          }
          {
            \bool_if:NF \g__osgstyler_block_pgf_warned_bool
              {
                \bool_gset_true:N \g__osgstyler_block_pgf_warned_bool
                \msg_warning:nn { osgstyler } { no-pgfcore }
              }
          }
        \fcolorbox {#1} {#2} {#3}
      }
  }
% \ldeen{Ein abgerundetes (bzw.\ bei Radius Null eckiges) Rechteck von
%   \code{(#1,#2)} mit Größe \code{#3}$\times$\code{#4} als aktuellem
%   pgf-Pfad.}{A rounded (square at radius zero) rectangle from
%   \code{(#1,#2)} of size \code{#3}$\times$\code{#4} as the current pgf
%   path.}
\cs_new_protected:Npn \__osgstyler_block_rrect:nnnn #1#2#3#4
  {
    \pgfsetcornersarced
      { \pgfpoint
          { \l__osgstyler_block_corner_radius_dim }
          { \l__osgstyler_block_corner_radius_dim } }
    \pgfpathrectanglecorners
      { \pgfpoint { \dim_eval:n {#1} } { \dim_eval:n {#2} } }
      { \pgfpoint { \dim_eval:n { (#1) + (#3) } } { \dim_eval:n { (#2) + (#4) } } }
  }
\cs_new_protected:Npn \__osgstyler_block_fbox_pgf:nnn #1#2#3
  {
    \hbox_set:Nn \l__osgstyler_block_content_box {#3}
    \hbox:n
      {
        \tag_mc_begin:n { artifact }
          \rlap
            {
              \begin { pgfpicture }
                \pgfsetbaseline { 0pt }
                \bool_if:NT \l__osgstyler_block_shadow_bool
                  {
                    \pgfsetfillcolor
                      { \OsgColorName { \l__osgstyler_block_shadow_color_tl } }
                    \__osgstyler_block_rrect:nnnn
                      { \l__osgstyler_block_shadow_offset_dim }
                      { -\box_dp:N \l__osgstyler_block_content_box
                        - \l__osgstyler_block_shadow_offset_dim }
                      { \box_wd:N \l__osgstyler_block_content_box }
                      { \box_ht:N \l__osgstyler_block_content_box
                        + \box_dp:N \l__osgstyler_block_content_box }
                    \pgfusepath { fill }
                  }
                \pgfsetfillcolor { #2 }
                \pgfsetstrokecolor { #1 }
                \pgfsetlinewidth { \l__osgstyler_block_rule_dim }
                \__osgstyler_block_rrect:nnnn
                  { 0pt }
                  { -\box_dp:N \l__osgstyler_block_content_box }
                  { \box_wd:N \l__osgstyler_block_content_box }
                  { \box_ht:N \l__osgstyler_block_content_box
                    + \box_dp:N \l__osgstyler_block_content_box }
                \dim_compare:nNnTF \l__osgstyler_block_rule_dim > \c_zero_dim
                  { \pgfusepath { fill, stroke } }
                  { \pgfusepath { fill } }
              \end { pgfpicture }
            }%
        \tag_mc_end:
        \box_use_drop:N \l__osgstyler_block_content_box
      }
  }

\cs_new_protected:Npn \__osgstyler_block_typeset:n #1
  {
    \group_begin:
      \l__osgstyler_block_before_tl
      \str_if_eq:VnTF \l__osgstyler_block_layout_tl { titled }
        { \__osgstyler_block_typeset_titled:n {#1} }
        { \__osgstyler_block_typeset_plain:n {#1} }
      \l__osgstyler_block_after_tl
    \group_end:
  }

% \ldeen*{\code{plain}: Titel (falls gesetzt) plus Body, ungeteilt -- wie
% bisher, samt optionalem Rahmen um alles, wenn \code{rule-thickness}
% positiv ist.}
% {\code{plain}: title (if set) plus body, undivided -- as before,
% including an optional frame around everything when \code{rule-thickness}
% is positive.}
% \ldeen{\cs{tagpdfparaOff} um die \cs{fcolorbox}: ohne das umhüllt das
%   Absatz-Tagging der Klasse den Kasten in einem eigenen Absatz, den der
%   \env{minipage}-Sockel dann um sein \code{Div} herum aufspaltet und
%   leere \code{P}-Fragmente hinterlässt. Mit ausgeschaltetem Absatz-Tagging
%   liegt das \code{Div} sauber neben den umgebenden Absätzen. Wirkt nur bei
%   geladenem \pkg{tagpdf} und wird von der einschließenden Gruppe wieder
%   zurückgesetzt.}{\cs{tagpdfparaOff} around the \cs{fcolorbox}: without it
%   the class's paragraph tagging wraps the box in a paragraph of its own,
%   which the \env{minipage} socket then splits around its \code{Div},
%   leaving empty \code{P} fragments. With paragraph tagging off the
%   \code{Div} sits cleanly beside the surrounding paragraphs. Only matters
%   when \pkg{tagpdf} is loaded, and the enclosing group restores it.}
\cs_new_protected:Npn \__osgstyler_block_box_para_off:
  { \cs_if_exist_use:N \tagpdfparaOff }
% \ldeen{Setzt den Blocktitel im Kopf-Font und in der Kopffarbe (wie beim
%   \code{titled}-Layout), aber als gewöhnliche erste Absatzzeile.}{Typesets
%   the block title in the head font and head colour (as in the \code{titled}
%   layout), but as an ordinary first paragraph line.}
\cs_new_protected:Npn \__osgstyler_block_plain_title:
  {
    \tl_if_empty:NF \l__osgstyler_block_title_tl
      {
        { \color { \OsgColorName{ \l__osgstyler_block_head_fg_tl } }
          \l__osgstyler_block_head_font_tl
          \l__osgstyler_block_title_tl \par }
        \nobreak
        \skip_vertical:n { 0.3 \baselineskip }
      }
  }
\cs_new_protected:Npn \__osgstyler_block_typeset_plain:n #1
  {
    \dim_compare:nNnTF { \l__osgstyler_block_rule_dim } > { 0pt }
      {
        \par
        \group_begin:
          \__osgstyler_block_box_para_off:
          \addvspace { \medskipamount }
          \setlength\fboxsep{\l__osgstyler_block_padding_dim}
          \setlength\fboxrule{\l__osgstyler_block_rule_dim}
          \noindent\fcolorbox
            { \OsgColorName{\l__osgstyler_block_rule_color_tl} }
            { \__osgstyler_block_bg:V \l__osgstyler_block_background_tl }
            {
              \begin{minipage}{\dim_eval:n
                {\linewidth-2\fboxsep-2\fboxrule}}
                \__osgstyler_block_plain_title:
                \setlength\parskip{0.5\baselineskip}
                #1
                \par
              \end{minipage}
            }
          \par
        \group_end:
        \addvspace { \medskipamount }
      }
      {
        \__osgstyler_block_plain_title:
        #1
      }
  }

% \ldeen*{\code{titled}: farbiger Kopfstreifen mit dem Titel, darunter der
% eingerückte Body -- optisch abhebende Blöcke im Stil von Beamers Madrid.
%
% Zwei Varianten je nach \code{body-background}. Bei \code{none} fließt
% alles: der Titel als normale Textzeile mit dem farbigen Streifen als
% \code{artifact}-\cs{rule} dahinter, der Body mit
% \cs{leftskip}/\cs{rightskip} als Innenabstand. Titel und Body-Absätze
% sind dann Geschwister im Frame -- getaggt wie ein Absatz ohne Block, ohne
% zusätzliches \code{Div}. Eine getönte Body-Fläche braucht dagegen einen
% Kasten: ist \code{body-background} gesetzt, liegt der Block in genau
% einer \cs{fcolorbox} um eine \env{minipage} (ein \code{Div}, wie bei
% \code{card}); der Kopfstreifen bleibt eine \code{artifact}-\cs{rule}, die
% bis an die Kastenkanten läuft, sodass Titel und Body auch dort saubere
% \code{text-unit}s bleiben. Die Kastenunterkante markiert das Blockende.}
% {\code{titled}: a coloured head strip carrying the title, the indented
% body below -- visually distinct blocks in the style of beamer's Madrid.
%
% Two variants depending on \code{body-background}. With \code{none}
% everything flows: the title as a normal text line with the coloured strip
% behind it as an \code{artifact} \cs{rule}, the body with
% \cs{leftskip}/\cs{rightskip} as inner padding. Title and body paragraphs
% are then siblings in the frame -- tagged like a paragraph with no block,
% no extra \code{Div}. A tinted body area needs a box: when
% \code{body-background} is set the block sits in exactly one \cs{fcolorbox}
% around a \env{minipage} (one \code{Div}, as with \code{card}); the head
% strip stays an \code{artifact} \cs{rule} bled to the box edges, so title
% and body still stay clean \code{text-unit}s there. The box's bottom edge
% marks where the block ends.}
% \ldeen{Eine volle Zeilenbreite überspannende Deko-Linie in eigener Zeile,
%   getaggt als ausgesetzt (nicht Teil der Struktur).}{A full-width
%   decorative rule on its own line, tagged as suspended (not part of the
%   structure).}
\cs_new_protected:Npn \__osgstyler_block_rule:nn #1#2
  {
    \tag_suspend:n { osgstyler-block-rule }
    \nobreak
    \noindent
    { \color { \OsgColorName{#1} } \rule { \linewidth } {#2} }%
    \par
    \tag_resume:n { osgstyler-block-rule }
  }
\cs_new_protected:Npn \__osgstyler_block_typeset_titled:n #1
  {
    \str_if_eq:VnTF \l__osgstyler_block_body_bg_tl { none }
      { \__osgstyler_block_typeset_titled_flow:n {#1} }
      { \__osgstyler_block_typeset_titled_box:n {#1} }
  }
% \ldeen{Der Kopfstreifen als nullhohe \cs{rlap}\cs{smash}-\code{artifact}
%   hinter der Titelzeile: \cs{tag_mc}-Push/Pop hebt die laufende Titel-MC
%   kurz an, sodass der Streifen ein eigenes Artefakt bleibt und die Glyphen
%   der Titelzeile danach weiter in ihre MC laufen. Aufruf im hmode, nachdem
%   \cs{noindent} die Absatz-MC geöffnet hat. \code{#1} verschiebt die
%   Streifenkante nach links, \code{#2} ist seine Breite.}{The head strip as
%   a zero-height \cs{rlap}\cs{smash} \code{artifact} behind the title line:
%   \cs{tag_mc} push/pop lifts the running title MC for a moment so the
%   strip stays its own artifact and the title glyphs afterwards keep
%   flowing into their MC. Call in hmode, after \cs{noindent} has opened the
%   paragraph MC. \code{#1} shifts the strip edge left, \code{#2} its
%   width.}
\cs_new_protected:Npn \__osgstyler_block_headstrip:nn #1#2
  {
    \str_if_eq:VnF \l__osgstyler_block_head_bg_tl { none }
      {
        \rlap { \smash {
          \tag_mc_end_push: \tag_mc_begin:n { artifact }
            \skip_horizontal:n { #1 }
            \color { \OsgColorName{ \l__osgstyler_block_head_bg_tl } }
            \rule
              [ \dim_eval:n { -0.32 \baselineskip } ]
              { \dim_eval:n { #2 } }
              { \dim_eval:n { 1.2 \baselineskip } }
          \tag_mc_end: \tag_mc_begin_pop:n { }
        } }%
      }
  }
% \ldeen{Der Kopfbalken des Kastenzweigs: eine \code{artifact}-\cs{rule},
%   die genau die Höhe der (durch einen unsichtbaren Strut aufgepolsterten)
%   Titelzeile hat -- so schliesst der Balken bündig mit der Kastenoberkante
%   ab, ohne dass die getönte Body-Fläche darüber hinausragt. \code{#1} ist
%   seine Breite.}{The boxed branch's head bar: an \code{artifact} \cs{rule}
%   exactly as tall as the title line (padded by an invisible strut), so the
%   bar meets the box's top edge flush and no tinted body area shows above
%   it. \code{#1} is its width.}
\dim_new:N \l__osgstyler_block_bar_pad_dim
\cs_new_protected:Npn \__osgstyler_block_headbar:n #1
  {
    \str_if_eq:VnF \l__osgstyler_block_head_bg_tl { none }
      {
        \bool_lazy_and:nnTF
          { \dim_compare_p:nNn \l__osgstyler_block_corner_radius_dim > \c_zero_dim }
          { \cs_if_exist_p:N \pgfpicture }
          { \__osgstyler_block_headbar_round:n {#1} }
          {
            \rlap { \smash {
              \tag_mc_end_push: \tag_mc_begin:n { artifact }
                \color { \OsgColorName{ \l__osgstyler_block_head_bg_tl } }
                \rule
                  [ \dim_eval:n { -\dp\strutbox
                                  - \l__osgstyler_block_bar_pad_dim } ]
                  { \dim_eval:n { #1 } }
                  { \dim_eval:n { \ht\strutbox + \dp\strutbox
                                  + 2 \l__osgstyler_block_bar_pad_dim } }
              \tag_mc_end: \tag_mc_begin_pop:n { }
            } }%
          }
      }
  }
% \ldeen{Kopfbalken mit abgerundeten \emph{oberen} Ecken (Radius wie der
%   Kasten), damit er in einem gerundeten \code{titlebar}-Kasten nicht über
%   die Ecken hinaussteht.}{Head bar with rounded \emph{top} corners (the
%   box's radius) so it does not overshoot the corners inside a rounded
%   \code{titlebar} box.}
\cs_new_protected:Npn \__osgstyler_block_headbar_round:n #1
  {
    \rlap { \smash {
      \tag_mc_end_push: \tag_mc_begin:n { artifact }
        \begin { pgfpicture }
          \pgfsetbaseline { 0pt }
          \pgfsetfillcolor { \OsgColorName { \l__osgstyler_block_head_bg_tl } }
          \dim_set:Nn \l_tmpa_dim
            { \ht\strutbox + \l__osgstyler_block_bar_pad_dim }
          \dim_set:Nn \l_tmpb_dim
            { -\dp\strutbox - \l__osgstyler_block_bar_pad_dim }
          \pgfpathmoveto { \pgfpoint { 0pt } { \l_tmpb_dim } }
          \pgfpathlineto { \pgfpoint { 0pt }
            { \dim_eval:n { \l_tmpa_dim - \l__osgstyler_block_corner_radius_dim } } }
          \pgfpatharc { 180 } { 90 } { \l__osgstyler_block_corner_radius_dim }
          \pgfpathlineto { \pgfpoint
            { \dim_eval:n { (#1) - \l__osgstyler_block_corner_radius_dim } }
            { \l_tmpa_dim } }
          \pgfpatharc { 90 } { 0 } { \l__osgstyler_block_corner_radius_dim }
          \pgfpathlineto { \pgfpoint { \dim_eval:n {#1} } { \l_tmpb_dim } }
          \pgfpathclose
          \pgfusepath { fill }
        \end { pgfpicture }
      \tag_mc_end: \tag_mc_begin_pop:n { }
    } }%
  }
% \ldeen{\code{titled} mit getönter Body-Fläche: ein Kasten
%   (\cs{fcolorbox}+\env{minipage}, ein \code{Div}). Innenabstand von Hand
%   (\cs{fboxsep} ist Null), damit der Kopfbalken randlos an die Kanten
%   läuft und bündig mit der Oberkante abschliesst.}{\code{titled} with a
%   tinted body area: a box (\cs{fcolorbox}+\env{minipage}, one \code{Div}).
%   Padding done by hand (\cs{fboxsep} is zero) so the head bar bleeds to
%   the edges and meets the top edge flush.}
\cs_new_protected:Npn \__osgstyler_block_typeset_titled_box:n #1
  {
    \par
    \group_begin:
      \__osgstyler_block_box_para_off:
      \addvspace { \medskipamount }
      \dim_set_eq:NN \l__osgstyler_block_bar_pad_dim
        \l__osgstyler_block_head_padding_dim
      \setlength \fboxsep { 0pt }
      \setlength \fboxrule { \l__osgstyler_block_rule_dim }
      \noindent
      \__osgstyler_block_fbox:nnn
        { \OsgColorName { \l__osgstyler_block_rule_color_tl } }
        { \__osgstyler_block_bg:V \l__osgstyler_block_body_bg_tl }
        {
          \begin { minipage } { \dim_eval:n { \linewidth - 2\fboxrule } }
            \tl_if_empty:NF \l__osgstyler_block_title_tl
              {
                \noindent
                % invisible strut sets the title line's metrics; the bar
                % (smashed) is drawn to the same extent.
                \rule
                  [ \dim_eval:n { -\dp\strutbox
                                  - \l__osgstyler_block_bar_pad_dim } ]
                  { 0pt }
                  { \dim_eval:n { \ht\strutbox + \dp\strutbox
                                  + 2 \l__osgstyler_block_bar_pad_dim } }%
                \__osgstyler_block_headbar:n { \linewidth }
                \skip_horizontal:n { \l__osgstyler_block_head_padding_dim }
                \dim_set:Nn \rightskip { \l__osgstyler_block_head_padding_dim }
                { \color { \OsgColorName{ \l__osgstyler_block_head_fg_tl } }
                  \l__osgstyler_block_head_font_tl
                  \l__osgstyler_block_title_tl \par }
                \nobreak
                \skip_vertical:n { \l__osgstyler_block_body_padding_dim }
              }
            \dim_set:Nn \leftskip  { \l__osgstyler_block_body_padding_dim }
            \dim_set:Nn \rightskip { \l__osgstyler_block_body_padding_dim }
            \tl_if_empty:NT \l__osgstyler_block_title_tl
              { \tex_kern:D \l__osgstyler_block_body_padding_dim }
            \setlength \parskip { 0.5 \baselineskip }
            \noindent \ignorespaces #1
            \par
            % A kern, not \skip_vertical: \endminipage's \unskip would drop
            % trailing glue and leave the body sitting on the bottom edge.
            \tex_kern:D \l__osgstyler_block_body_padding_dim
          \end { minipage }
        }%
      \par
    \group_end:
    \addvspace { \medskipamount }
  }
\cs_new_protected:Npn \__osgstyler_block_typeset_titled_flow:n #1
  {
    \par
    \addvspace { \medskipamount }
    \group_begin:
      \tl_if_empty:NF \l__osgstyler_block_title_tl
        {
          % Optional rule above the head (booktabs-style bracket top).
          \dim_compare:nNnT \l__osgstyler_block_head_rule_dim > \c_zero_dim
            {
              \__osgstyler_block_rule:nn
                { \l__osgstyler_block_head_rule_color_tl }
                { \l__osgstyler_block_head_rule_dim }
              \nointerlineskip
              \skip_vertical:n { 0.2 \baselineskip }
            }
          % The coloured strip (if any) sits behind the title's own line.
          \noindent
          \__osgstyler_block_headstrip:nn
            { -\l__osgstyler_block_head_padding_dim }
            { \linewidth + \l__osgstyler_block_head_padding_dim }
          {
            \color { \OsgColorName{ \l__osgstyler_block_head_fg_tl } }
            \l__osgstyler_block_head_font_tl
            \l__osgstyler_block_title_tl
          }%
          \par
          % Normal interline spacing to the body -- one line apart, like
          % beamer's default block.  The head strip is \cs{smash}ed and
          % reaches only ~0.3\baselineskip below the title baseline, so it
          % does not touch the body at this distance.
        }
      \group_begin:
        \dim_set:Nn \leftskip  { \l__osgstyler_block_body_padding_dim }
        \dim_set:Nn \rightskip { \l__osgstyler_block_body_padding_dim }
        \setlength \parskip { 0.5 \baselineskip }
        \noindent \ignorespaces #1 \par
      \group_end:
      % Optional rule below the body (bracket bottom).
      \dim_compare:nNnT \l__osgstyler_block_foot_rule_dim > \c_zero_dim
        {
          \nointerlineskip
          \skip_vertical:n { 0.35 \baselineskip }
          \__osgstyler_block_rule:nn
            { \l__osgstyler_block_foot_rule_color_tl }
            { \l__osgstyler_block_foot_rule_dim }
        }
    \group_end:
    \addvspace { \medskipamount }
  }

% \ldeen*{Instanzen sind bei xtemplate ohnehin nur gespeichertes
% Keyval-Material -- Rahmen/Schatten/Ecken lassen sich also schon durch
% simples Verketten mehrerer Fragmente kombinieren, ohne dass es dafür
% je eine eigene Instanz bräuchte. @1 gibt diesem Verketten nur einen
% Namen: der Schlüssel @2 schlägt benannte, mit @3 deklarierte
% Fragmente nach und reiht sie vor die übrigen, unverändert
% durchgereichten Schlüssel ein.}
% {Instances are just stored keyval material in xtemplate to begin
% with -- rule/shadow/corner combinations can already be composed by
% concatenating fragments, without a dedicated instance for each
% combination. @1 merely gives that concatenation a name: the @2 key
% looks up named fragments declared via @3 and prepends them to the
% remaining keys, which pass through unchanged.}
% {\cs{DeclareOsgBlockInstance}}{traits}{\cs{DeclareOsgBlockTrait}}

\prop_new:N \g__osgstyler_block_trait_prop
\tl_new:N \l__osgstyler_block_instance_keys_tl
\tl_new:N \l__osgstyler_block_trait_tl

\msg_new:nnnn { osgstyler } { unknown-block-trait }
  { Unknown~block~trait~'#1'. }
  { Declare~it~with~\token_to_str:N\DeclareOsgBlockTrait~before~using~it. }

\NewDocumentCommand \DeclareOsgBlockTrait { m m }
  { \prop_gput:Nne \g__osgstyler_block_trait_prop {#1} { \exp_not:n {#2} } }

\keys_define:nn { osgstyler / block-instance }
  {
    % \ldeen{Ein eigener Scratch, nicht \cs{l_tmpa_tl}: der Aufrufer kann
    %   \cs{l_tmpa_tl} über den \cs{keys_set:nn}"=Aufruf hinweg brauchen.}{A
    %   private scratch, not \cs{l_tmpa_tl}: the caller may rely on
    %   \cs{l_tmpa_tl} across the \cs{keys_set:nn} call.}
    traits .code:n =
      \clist_map_inline:nn {#1}
        {
          % \ldeen{\cs{tl_put_right:NV} statt \cs{tl_put_right:Nx}: der
          %   Trait-Wert darf \cs{normalfont} u.\,ä.\ enthalten, die eine
          %   vollständige Expansion sprengen würden.}{\cs{tl_put_right:NV}
          %   not \cs{tl_put_right:Nx}: a trait value may contain
          %   \cs{normalfont} and the like, which would break full
          %   expansion.}
          \prop_get:NnNTF \g__osgstyler_block_trait_prop {##1}
            \l__osgstyler_block_trait_tl
            {
              \tl_put_right:NV \l__osgstyler_block_instance_keys_tl
                \l__osgstyler_block_trait_tl
              \tl_put_right:Nn \l__osgstyler_block_instance_keys_tl { , }
            }
            { \msg_error:nnn { osgstyler } { unknown-block-trait } {##1} }
        },
    unknown .code:n =
      \tl_put_right:Nx \l__osgstyler_block_instance_keys_tl
        { \exp_not:V \l_keys_key_str = \exp_not:n {#1} , }
  }

\cs_new_protected:Npn \__osgstyler_block_instance_resolve:n #1
  {
    \tl_clear:N \l__osgstyler_block_instance_keys_tl
    \keys_set:nn { osgstyler / block-instance } {#1}
  }

% \ldeen*{Merkt sich pro Instanz, ob \code{layout=titled} wirksam ist
% (direkt oder über einen Trait). Umhüllende Pakete wie \pkg*{lttheme}
% brauchen das, weil sie einen Kopf-Titel dann anders zuführen müssen als
% einen dem Body vorangestellten. Ein Aufruf ohne Layout-Angabe lässt den
% Vermerk stehen -- \cs{StyleOsgBlockInstance} ist additiv.}
% {Records per instance whether \code{layout=titled} is in effect
% (directly or through a trait). Wrapping packages such as \pkg*{lttheme}
% need this because a head title has to be fed in differently from one
% prepended to the body. A call without a layout key leaves the record
% untouched -- \cs{StyleOsgBlockInstance} is additive.}
\prop_new:N \g__osgstyler_block_titled_prop

\cs_new_protected:Npn \__osgstyler_block_record_layout:n #1
  {
    \tl_if_in:NnT \l__osgstyler_block_instance_keys_tl { titled }
      { \prop_gput:Nnn \g__osgstyler_block_titled_prop {#1} { } }
    \tl_if_in:NnT \l__osgstyler_block_instance_keys_tl { plain }
      { \prop_gremove:Nn \g__osgstyler_block_titled_prop {#1} }
  }

\prg_new_conditional:Npnn \osgstyler_if_block_titled:n #1 { p, T, F, TF }
  {
    \prop_if_in:NnTF \g__osgstyler_block_titled_prop {#1}
      { \prg_return_true: } { \prg_return_false: }
  }
\cs_new_eq:NN \OsgIfBlockTitledT \osgstyler_if_block_titled:nT
\cs_new_eq:NN \OsgIfBlockTitledF \osgstyler_if_block_titled:nF
\cs_new_eq:NN \OsgIfBlockTitledTF \osgstyler_if_block_titled:nTF

% xtemplate's own key parser, like enumitem's \setlist (see
% \cs{__osgstyler_list_apply_level:nnn}), scans its keys argument
% before expansion; a bare macro reference there is read as one
% valueless key, not expanded first. Building the whole call as
% already-expanded literal text avoids that.
\tl_new:N \l__osgstyler_block_instance_call_tl

% \ldeen{\cs{exp_not:V} um die gesammelten Schlüssel: sie dürfen
%   \cs{normalfont} u.\,ä.\ enthalten (etwa aus \code{head-font}), die eine
%   vollständige Expansion sprengen würden.}{\cs{exp_not:V} around the
%   collected keys: they may contain \cs{normalfont} and the like (e.g.\ from
%   \code{head-font}), which would break full expansion.}
\NewDocumentCommand \DeclareOsgBlockInstance { m m }
  {
    \__osgstyler_block_instance_resolve:n {#2}
    \__osgstyler_block_record_layout:n {#1}
    \tl_set:Ne \l__osgstyler_block_instance_call_tl
      {
        \exp_not:N \DeclareInstance { osgstyler-block }
          { \exp_not:n {#1} } { standard }
          { \exp_not:V \l__osgstyler_block_instance_keys_tl }
      }
    \tl_use:N \l__osgstyler_block_instance_call_tl
  }

\NewDocumentCommand \StyleOsgBlockInstance { m m }
  {
    \__osgstyler_block_instance_resolve:n {#2}
    \__osgstyler_block_record_layout:n {#1}
    \tl_set:Ne \l__osgstyler_block_instance_call_tl
      {
        \exp_not:N \EditInstance { osgstyler-block }
          { \exp_not:n {#1} }
          { \exp_not:V \l__osgstyler_block_instance_keys_tl }
      }
    \tl_use:N \l__osgstyler_block_instance_call_tl
  }

% ==========================================
% NUMBERING TEMPLATE
% ==========================================
%
% \ldeen*{Liefert ausschließlich die formatierte Zahl (z.\,B. "`2.3"');
% weder ein lokalisiertes Label wie "`Satz"' noch ein optionaler
% Autoren-Titel gehören dazu -- beides bleibt Sache der Umgebung, die
% eine Instanz dieses Templates verwendet, damit dieses Paket
% sprachneutral bleibt. @1 registriert den zugrundeliegenden
% \LaTeX-Zähler einmalig (\cs{DeclareOsgNumbering} löst dies sofort
% aus, nicht erst bei der ersten Verwendung), da ein zweiter Aufruf von
% \cs{newcounter} sonst fehlschlüge; Zählername und Format-Vorgabe
% werden dabei zusätzlich unter dem Instanznamen gemerkt, weil weder
% \cs{StepOsgNumbering} noch \cs{OsgNumberingValue} sonst einen Weg
% hätten, sie wiederzufinden.}
% {Produces only the formatted number (e.g. "`2.3"'); neither a
% localized label such as "`Theorem"' nor an optional author-supplied
% title belong here -- both remain the calling environment's concern,
% keeping this package language-neutral. @1 registers the underlying
% \LaTeX\ counter exactly once (\cs{DeclareOsgNumbering} triggers this
% immediately, not on first use), since a second \cs{newcounter} call
% would otherwise fail; the counter name and format are additionally
% remembered under the instance name, since neither
% \cs{StepOsgNumbering} nor \cs{OsgNumberingValue} would otherwise have
% a way to recover them.}
% {\cs{DeclareOsgNumbering}}

\tl_new:N \l__osgstyler_numbering_counter_tl
\tl_new:N \l__osgstyler_numbering_within_tl
\tl_new:N \l__osgstyler_numbering_format_tl
\prop_new:N \g__osgstyler_numbering_counter_prop
\prop_new:N \g__osgstyler_numbering_format_prop

\NewTemplateType { osgstyler-numbering } { 1 }
\DeclareTemplateInterface { osgstyler-numbering } { standard } { 1 }
  {
    counter : tokenlist =,
    within  : tokenlist = none,
    format  : tokenlist =
  }
\DeclareTemplateCode { osgstyler-numbering } { standard } { 1 }
  {
    counter = \l__osgstyler_numbering_counter_tl,
    within  = \l__osgstyler_numbering_within_tl,
    format  = \l__osgstyler_numbering_format_tl
  }
  { \__osgstyler_numbering_register:n {#1} }

\cs_new_protected:Npn \__osgstyler_numbering_register:n #1
  {
    \cs_if_exist:cF { c@ \l__osgstyler_numbering_counter_tl }
      {
        \str_if_eq:VnTF \l__osgstyler_numbering_within_tl { none }
          { \newcounter { \l__osgstyler_numbering_counter_tl } }
          {
            \newcounter
              { \l__osgstyler_numbering_counter_tl }
              [ \l__osgstyler_numbering_within_tl ]
          }
      }
    \prop_gput:NnV \g__osgstyler_numbering_counter_prop {#1}
      \l__osgstyler_numbering_counter_tl
    \prop_gput:NnV \g__osgstyler_numbering_format_prop {#1}
      \l__osgstyler_numbering_format_tl
  }

\NewDocumentCommand \DeclareOsgNumbering { m m }
  {
    \DeclareInstance { osgstyler-numbering } {#1} { standard } {#2}
    \UseInstance { osgstyler-numbering } {#1} {#1}
  }

\NewExpandableDocumentCommand \OsgNumberingCounter { m }
  { \prop_item:Nn \g__osgstyler_numbering_counter_prop {#1} }

\NewDocumentCommand \StepOsgNumbering { m }
  { \refstepcounter { \OsgNumberingCounter {#1} } }

\NewExpandableDocumentCommand \OsgNumberingValue { m }
  { \prop_item:Nn \g__osgstyler_numbering_format_prop {#1} }

% ==========================================
% NEW ENVIRONMENTS FROM SCRATCH
% ==========================================
%
% \ldeen*{@1 deckt den Fall ab, in dem \emph{keine} bereits bestehende
% Umgebung umhüllt wird (der Gegenfall -- ein bekanntes Environment wie
% \env{block} oder ein von \pkg*{amsthm} erzeugtes \env{theorem} nur
% optisch einzurahmen -- bleibt eine dokumentierte, pro Environment
% wiederholte Anwendung von \cs{UseInstance}\Marg{osgstyler-block}, da
% sich die Argumentsignaturen bestehender Environments zu sehr
% unterscheiden, um sie generisch zu erfassen). @2 selbst bleibt
% sprachneutral: das Label (@3) liefert der Aufrufer als fertigen Text,
% \pkg*{osgstyler} übersetzt nicht.}
% {@1 covers the case where \emph{no} pre-existing environment is being
% wrapped (the opposite case -- giving a known environment such as
% \env{block} or an \pkg*{amsthm}-generated \env{theorem} only a visual
% frame -- remains a documented, per-environment repetition of
% \cs{UseInstance}\Marg{osgstyler-block}, since existing environments'
% argument signatures differ too much to capture generically). @2 itself
% stays language-neutral: the caller supplies the label (@3) as
% ready-made text, \pkg*{osgstyler} does not translate.}
% {\cs{NewOsgStyledEnvironment}}{\cs{DeclareOsgNumbering}}

\tl_new:N \l__osgstyler_styled_env_title_tl

\cs_new_protected:Npn \__osgstyler_styled_env_begin:nnnnn #1#2#3#4#5
  {
    \group_begin:
      \tl_clear:N \l__osgstyler_styled_env_title_tl
      \tl_put_right:Nn \l__osgstyler_styled_env_title_tl {#3}
      \str_if_eq:nnF {#2} { none }
        {
          \StepOsgNumbering {#2}
          \tl_put_right:Nn \l__osgstyler_styled_env_title_tl
            { ~\OsgNumberingValue {#2} }
        }
      \IfNoValueF {#4}
        { \tl_put_right:Nn \l__osgstyler_styled_env_title_tl { ~(#4)} }
      \__osgstyler_block_use:nnn {#1}
        { \tl_use:N \l__osgstyler_styled_env_title_tl } { #5 }
    \group_end:
  }

% \ldeen*{Ist @1 (aus \pkg*{osglecture-modes}) beim Aufruf bereits
% geladen, bekommt das erzeugte Environment zusätzlich eine führende
% \cs{d<>}-Spezifikation: ein inaktiver Modus unterdrückt die Ausgabe
% vollständig, \emph{einschließlich} des Nummerierungsschritts --
% ausgeblendeter Inhalt soll keine Lücke in der Nummerierung
% hinterlassen. Das ist hier gefahrlos möglich (anders als bei
% nativen Overlay-Umgebungen ohne Fallback), weil der Textkörper
% ohnehin als \cs{+b}-Argument vollständig eingelesen wird, bevor
% irgendetwas davon ausgeführt wird -- ihn bedingt zu verwerfen ersetzt
% keine bereits laufende Ausgabe.}
% {If @1 (from \pkg*{osglecture-modes}) is already loaded when this
% runs, the generated environment additionally gets a leading
% \cs{d<>} specification: an inactive mode suppresses output entirely,
% \emph{including} the numbering step -- hidden content should not
% leave a gap in the numbering. This is safe here (unlike native
% overlay environments without a fallback) because the body is fully
% read as a \cs{+b} argument before any of it executes -- discarding it
% conditionally does not interrupt output already under way.}
% {\pkg*{osglecture-modes}}
\cs_new_protected:Npn \__osgstyler_styled_env_mode_dispatch:nnnnnn #1#2#3#4#5#6
  {
    \IfNoValueTF {#4}
      { \__osgstyler_styled_env_begin:nnnnn {#1}{#2}{#3}{#5}{#6} }
      {
        \IfLectureModeT {#4}
          { \__osgstyler_styled_env_begin:nnnnn {#1}{#2}{#3}{#5}{#6} }
      }
  }

% \ldeen*{Ab @1 (tcolorbox-artig, wie \pkg*{tcolorbox}s eigenes
% \cs{newtcolorbox}\oarg{nargs}) verlangt das erzeugte Environment
% @1 Pflichtargumente statt des optionalen \Marg{Name}; die Titelvorlage
% (@2) wird dann pro Verwendung mit den echten Argumenten gefüllt --
% genau Beamers eigene \env{block}-Signatur \Verb+\begin{block}{Titel}+
% lässt sich damit für die Langform nachbilden (@3). Die automatische
% Label+Zahl+Name-Komposition entfällt hier bewusst: wer Nummerierung
% mit freiem Titel kombinieren will, bezieht \cs{OsgNumberingValue}
% selbst in die Vorlage ein.}
% {From @1 onward (tcolorbox-style, like \pkg*{tcolorbox}'s own
% \cs{newtcolorbox}\oarg{nargs}) the generated environment requires
% @1 mandatory arguments instead of the optional \Marg{Name}; the title
% template (@2) is then filled with the real arguments on each use --
% this reproduces beamer's own \env{block} signature
% \Verb+\begin{block}{Title}+ for the long form (@3). The automatic
% label+number+name composition is deliberately absent here: combining
% numbering with a free title means including \cs{OsgNumberingValue}
% in the template yourself.}
% {\code{1}}{title~template}{\NewOsgStyledEnvironment\Marg{block}\Marg{block}\Marg{none}\oarg{1}\Marg{\#1}}
\msg_new:nnnn { osgstyler } { unsupported-styled-env-nargs }
  { Styled~environments~support~0--3~title~arguments,~not~'#1'. }
  { Use~a~value~from~0~to~3~for~the~optional~argument~of
    ~\token_to_str:N\NewOsgStyledEnvironment. }

\cs_new_protected:Npn \__osgstyler_styled_env_freetitle_render:nnn #1#2#3
  {
    \group_begin:
      \__osgstyler_block_use:nnn {#1} { #2 } { #3 }
    \group_end:
  }

\NewDocumentCommand \NewOsgStyledEnvironment { m m m O{0} m }
