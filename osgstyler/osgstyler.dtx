\msg_new:nnnn { osgstyler } { font-management-unavailable }
  { Font~management~is~not~available~(osgstyler~was~loaded~with~the~
    'colors-only'~option). }
  { Check~\token_to_str:N\OsgFontPaletteAvailableTF~before~calling~font~
    commands,~or~load~osgstyler~without~'colors-only'. }

\keys_define:nn { osgstyler / font-resource }
  {
    font .tl_set:N = \l__osgstyler_font_name_tl,
    features .tl_set:N = \l__osgstyler_font_features_tl,
    alias .tl_set:N = \l__osgstyler_font_alias_tl,
    description .tl_set:N = \l__osgstyler_font_description_tl,
  }

\cs_new_protected:Npn \__osgstyler_font_resource_store:nnn #1#2#3
  {
    \tl_clear:N \l__osgstyler_font_name_tl
    \tl_clear:N \l__osgstyler_font_features_tl
    \tl_clear:N \l__osgstyler_font_alias_tl
    \tl_clear:N \l__osgstyler_font_description_tl
    \keys_set:nn { osgstyler / font-resource } {#3}
    \bool_lazy_and:nnTF
      { ! \tl_if_empty_p:N \l__osgstyler_font_name_tl }
      { ! \tl_if_empty_p:N \l__osgstyler_font_alias_tl }
      { \msg_error:nnnn { osgstyler } { conflicting-font-resource } {#1} {#2} }
      {
        \tl_if_empty:NTF \l__osgstyler_font_name_tl
          {
            \tl_if_empty:NTF \l__osgstyler_font_alias_tl
              { \msg_error:nnnn { osgstyler } { incomplete-font-resource } {#1} {#2} }
              {
                \clist_if_in:NVTF \c__osgstyler_font_slots_clist
                  \l__osgstyler_font_alias_tl
                  {
                    \prop_gput:Nne \g__osgstyler_font_palette_prop
                      { #1 / #2 / kind } { alias }
                    \prop_gput:NnV \g__osgstyler_font_palette_prop
                      { #1 / #2 / alias } \l__osgstyler_font_alias_tl
                  }
                  { \msg_error:nne { osgstyler } { unknown-font-slot }
                      \l__osgstyler_font_alias_tl }
              }
          }
          {
            \prop_gput:Nnn \g__osgstyler_font_palette_prop
              { #1 / #2 / kind } { resource }
            \prop_gput:NnV \g__osgstyler_font_palette_prop
              { #1 / #2 / font } \l__osgstyler_font_name_tl
            \prop_gput:NnV \g__osgstyler_font_palette_prop
              { #1 / #2 / features } \l__osgstyler_font_features_tl
          }
        \tl_if_empty:NF \l__osgstyler_font_description_tl
          { \prop_gput:NnV \g__osgstyler_font_palette_prop
              { #1 / #2 / description } \l__osgstyler_font_description_tl }
      }
  }

\cs_new_protected:Npn \__osgstyler_font_palette_declare:nn #1#2
  {
    \clist_map_inline:Nn \c__osgstyler_font_slots_clist
      {
        \clist_map_inline:nn { kind, font, features, alias, description }
          { \prop_gremove:Nn \g__osgstyler_font_palette_prop
              { #1 / ##1 / ####1 } }
      }
    \prop_gremove:Nn \g__osgstyler_font_palette_prop { #1 / declared }
    \clist_map_inline:Nn \c__osgstyler_font_slots_clist
      {
        \keys_define:nn { osgstyler / font-palette / #1 }
          { ##1 .code:n = \__osgstyler_font_resource_store:nnn {#1}{##1}{####1} }
      }
    \keys_set:nn { osgstyler / font-palette / #1 } {#2}
    \prop_if_in:NnF \g__osgstyler_font_palette_prop { #1 / main / kind }
      { \msg_error:nnn { osgstyler } { missing-main-font } {#1} }
    \prop_gput:Nnn \g__osgstyler_font_palette_prop { #1 / declared } { true }
  }

\NewDocumentCommand \DeclareOsgFontPalette { m m }
  { \__osgstyler_font_palette_declare:nn {#1}{#2} }

% \ldeen{Die Standardrückfallebenen der Font gehen vom der konzeptionellen Eignung aus, 
% nicht vom Aussehen}{Default fallbacks deliberately express suitability, not morphology}.
\cs_new:Npn \__osgstyler_font_fallback:n #1
  {
    \str_case:nnF {#1}
      {
        { companion } { main }
        { display }   { companion }
        { accent }    { companion }
        { symbol }    { main }
      }
      { }
  }

\cs_new_protected:Npn \__osgstyler_font_resolve:nnN #1#2#3
  {
    \seq_if_in:NnTF \l__osgstyler_font_resolution_seq {#2}
      {
        \msg_error:nnnn { osgstyler } { font-alias-cycle } {#1}{#2}
        \tl_clear:N #3
      }
      {
        \seq_put_right:Nn \l__osgstyler_font_resolution_seq {#2}
        \prop_get:NnNTF \g__osgstyler_font_palette_prop
          { #1 / #2 / kind } \l__osgstyler_font_resolution_kind_tl
          {
            \str_if_eq:VnTF \l__osgstyler_font_resolution_kind_tl { resource }
              { \tl_set:Nn #3 {#2} }
              {
                \prop_get:NnN \g__osgstyler_font_palette_prop
                  { #1 / #2 / alias } \l__osgstyler_font_resolution_target_tl
                \exp_args:NnV \__osgstyler_font_resolve:nnN {#1}
                  \l__osgstyler_font_resolution_target_tl #3
              }
          }
          {
            \tl_set:Ne \l__osgstyler_font_resolution_target_tl
              { \__osgstyler_font_fallback:n {#2} }
            \tl_if_empty:NTF \l__osgstyler_font_resolution_target_tl
              {
                \msg_error:nnnn { osgstyler } { unavailable-font-slot } {#1}{#2}
                \tl_clear:N #3
              }
              { \exp_args:NnV \__osgstyler_font_resolve:nnN {#1}
                  \l__osgstyler_font_resolution_target_tl #3 }
          }
        \seq_pop_right:NN \l__osgstyler_font_resolution_seq
          \l__osgstyler_font_resolution_discard_tl
      }
  }

\cs_new_protected:Npn \__osgstyler_font_slot_resolve:nnN #1#2#3
  {
    \clist_if_in:NnTF \c__osgstyler_font_slots_clist {#2}
      {
        \seq_clear:N \l__osgstyler_font_resolution_seq
        \__osgstyler_font_resolve:nnN {#1}{#2} #3
      }
      {
        \msg_error:nnn { osgstyler } { unknown-font-slot } {#2}
        \tl_clear:N #3
      }
  }

