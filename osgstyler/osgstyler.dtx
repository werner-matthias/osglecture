                            \IfLectureModeT {##1}
                              {
                                \tl_set:Ne \l__osgstyler_styled_env_title_tl
                                  {
                                    \exp_not:c
                                      { __osgstyler_styled_env_title_apply_#1:n }
                                      {##2}
                                  }
                                \__osgstyler_styled_env_freetitle_render:nnn {#2}
                                  { \tl_use:N \l__osgstyler_styled_env_title_tl } {##3}
                              }
                          }
                      }
                      { }
                  }
                  {
                    \NewDocumentEnvironment {#1} { m +b }
                      {
                        \tl_set:Ne \l__osgstyler_styled_env_title_tl
                          { \exp_not:c { __osgstyler_styled_env_title_apply_#1:n } {##1} }
                        \__osgstyler_styled_env_freetitle_render:nnn {#2}
                          { \tl_use:N \l__osgstyler_styled_env_title_tl } {##2}
                      }
                      { }
                  }
              }
            { 2 }
              {
                \cs_set:cpn { __osgstyler_styled_env_title_apply_#1:nn } ##1##2
                  { #5 }
                \cs_if_exist:NTF \IfLectureModeTF
                  {
                    \NewDocumentEnvironment {#1} { d<> m m +b }
                      {
                        \IfNoValueTF {##1}
                          {
                            \tl_set:Ne \l__osgstyler_styled_env_title_tl
                              {
                                \exp_not:c { __osgstyler_styled_env_title_apply_#1:nn }
                                  {##2}{##3}
                              }
                            \__osgstyler_styled_env_freetitle_render:nnn {#2}
                              { \tl_use:N \l__osgstyler_styled_env_title_tl } {##4}
                          }
                          {
                            \IfLectureModeT {##1}
                              {
                                \tl_set:Ne \l__osgstyler_styled_env_title_tl
                                  {
                                    \exp_not:c
                                      { __osgstyler_styled_env_title_apply_#1:nn }
                                      {##2}{##3}
                                  }
                                \__osgstyler_styled_env_freetitle_render:nnn {#2}
                                  { \tl_use:N \l__osgstyler_styled_env_title_tl } {##4}
                              }
                          }
                      }
                      { }
                  }
                  {
                    \NewDocumentEnvironment {#1} { m m +b }
                      {
                        \tl_set:Ne \l__osgstyler_styled_env_title_tl
                          {
                            \exp_not:c { __osgstyler_styled_env_title_apply_#1:nn }
                              {##1}{##2}
                          }
                        \__osgstyler_styled_env_freetitle_render:nnn {#2}
                          { \tl_use:N \l__osgstyler_styled_env_title_tl } {##3}
                      }
                      { }
                  }
              }
            { 3 }
              {
                \cs_set:cpn { __osgstyler_styled_env_title_apply_#1:nnn } ##1##2##3
                  { #5 }
                \cs_if_exist:NTF \IfLectureModeTF
                  {
                    \NewDocumentEnvironment {#1} { d<> m m m +b }
                      {
