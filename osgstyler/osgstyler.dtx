% ==========================================
% BOX TEMPLATE: STYLED BLOCKS
% ==========================================
%
% \ldeen*{Ein gemeinsamer Template-Typ für kastenartige, umrandete oder
% hinterlegte Inhalte -- Beamer-Blöcke ebenso wie theorem-artige Boxen
% oder Zitate in der Langform. Paket- und Themenautoren binden entweder
% eine bereits bekannte Umgebung an eine Instanz (die Render-Logik
% umhüllt dann nur optisch, die Umgebung bringt z.\,B. ihre eigene
% Nummerierung selbst mit) oder deklarieren über
% \cs{NewOsgStyledEnvironment} eine neue -- die Render-Logik existiert
% in beiden Fällen nur einmal. Farbwerte werden stets über
% \cs{OsgColorName} aufgelöst statt als bloße Slot-Namen verwendet, da
% nur die aufgelösten Namen unabhängig von einer ladenden Theme-Datei
% wie \pkg*{lttheme} garantiert existieren.}
% {A shared template type for boxed, framed or filled content -- beamer
% blocks as well as theorem-like boxes or quotations in the long form.
% Package and theme authors either bind an already-known environment to
% an instance (the rendering then only wraps it visually; the
% environment brings its own numbering, if any) or declare a new one via
% \cs{NewOsgStyledEnvironment} -- the rendering logic exists only once
% either way. Color values are always resolved via \cs{OsgColorName}
% rather than used as bare slot names, since only the resolved names are
% guaranteed to exist independently of a loading theme file such as
% \pkg*{lttheme}.}

\tl_new:N \l__osgstyler_block_background_tl
\tl_new:N \l__osgstyler_block_rule_color_tl
\tl_new:N \l__osgstyler_block_before_tl
\tl_new:N \l__osgstyler_block_after_tl
\tl_new:N \l__osgstyler_block_layout_tl
\tl_new:N \l__osgstyler_block_head_bg_tl
\tl_new:N \l__osgstyler_block_head_fg_tl
\tl_new:N \l__osgstyler_block_head_font_tl
\tl_new:N \l__osgstyler_block_head_rule_color_tl
\tl_new:N \l__osgstyler_block_foot_rule_color_tl
\tl_new:N \l__osgstyler_block_body_bg_tl
\dim_new:N \l__osgstyler_block_rule_dim
\dim_new:N \l__osgstyler_block_padding_dim
\tl_new:N \l__osgstyler_block_shadow_color_tl
\dim_new:N \l__osgstyler_block_corner_radius_dim
\dim_new:N \l__osgstyler_block_shadow_offset_dim
\dim_new:N \l__osgstyler_block_head_padding_dim
\dim_new:N \l__osgstyler_block_head_rule_dim
\dim_new:N \l__osgstyler_block_foot_rule_dim
\dim_new:N \l__osgstyler_block_body_padding_dim
\bool_new:N \l__osgstyler_block_shadow_bool

% \ldeen*{Der Titel wird nicht als Template-Schlüssel geführt (er wechselt
% je Verwendung, nicht je Instanz), sondern vor \cs{UseInstance} in diese
% Variable gelegt -- über \cs{__osgstyler_block_use:nnn}, damit keine
% Aufrufstelle sie zu setzen vergisst. Im Layout \code{plain} wird er
% schlicht dem Body vorangestellt (verhält sich wie das frühere
% \code{Titel\cs{par}Body}); im Layout \code{titled} bekommt er einen
% eigenen, gestalteten Kopf.}
% {The title is not a template key (it changes per use, not per instance);
% callers place it into this variable before \cs{UseInstance}, through
% \cs{__osgstyler_block_use:nnn} so no call site forgets it. In layout
% \code{plain} it is simply prepended to the body (behaving like the
% former \code{title\cs{par}body}); in layout \code{titled} it gets its
% own styled head.}
\tl_new:N \l__osgstyler_block_title_tl

\NewTemplateType { osgstyler-block } { 1 }
\DeclareTemplateInterface { osgstyler-block } { standard } { 1 }
  {
    background    : tokenlist = none,
