                              \l__osgstyler_font_load_name_tl
                            \prop_get:NeN \g__osgstyler_font_palette_prop
                              { #1 / \l_tmpa_tl / features }
                              \l__osgstyler_font_load_features_tl
                            \exp_args:NNVV \fontspec_gset_family:Nnn
                              \l__osgstyler_font_load_family_tl
                              \l__osgstyler_font_load_features_tl
                              \l__osgstyler_font_load_name_tl
                            \prop_gput:NeV \g__osgstyler_font_family_prop
                              { #1 / \l_tmpa_tl }
                              \l__osgstyler_font_load_family_tl
                          }
                      }
                  }
              }
          }
          { \msg_error:nnn { osgstyler } { unknown-font-palette } {#1} }
      }
  }

\NewDocumentCommand \UseOsgFontPalette { m }
