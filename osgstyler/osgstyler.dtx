            \NewDocumentEnvironment {#1} { d<> o +b }
              {
                \__osgstyler_styled_env_mode_dispatch:nnnnnn
                  {#2}{#3}{#5}{##1}{##2}{##3}
              }
              { }
          }
          {
            \NewDocumentEnvironment {#1} { o +b }
              { \__osgstyler_styled_env_begin:nnnnn {#2}{#3}{#5}{##1}{##2} }
              { }
          }
      }
      {
        \int_case:nnF {#4}
          {
            { 1 }
              {
                \cs_set:cpn { __osgstyler_styled_env_title_apply_#1:n } ##1
                  { #5 }
                \cs_if_exist:NTF \IfLectureModeTF
                  {
                    \NewDocumentEnvironment {#1} { d<> m +b }
                      {
                        \IfNoValueTF {##1}
                          {
                            \tl_set:Ne \l__osgstyler_styled_env_title_tl
                              {
                                \exp_not:c { __osgstyler_styled_env_title_apply_#1:n }
