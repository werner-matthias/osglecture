% slots.  A slot either owns a fontspec resource or aliases another slot.
% The distinction is explicit so that a font called, for example, "main"
% can never be mistaken for an alias.
\clist_const:Nn \c__osgstyler_font_slots_clist
  { main, companion, display, accent, mono, math, symbol }

