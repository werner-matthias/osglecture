\msg_new:nnnn { osgstyler } { unknown-font-slot }
  { Unknown~font~palette~slot~'#1'. }
  { The~portable~slots~are~main,~companion,~display,~accent,~mono,~math,~and~symbol. }
\msg_new:nnnn { osgstyler } { incomplete-font-resource }
  { Font~slot~'#2'~in~palette~'#1'~does~not~specify~a~font~or~an~alias. }
  { Use~font={...}~for~a~resource~or~alias=...~for~an~alias. }
\msg_new:nnnn { osgstyler } { conflicting-font-resource }
  { Font~slot~'#2'~in~palette~'#1'~specifies~both~a~font~and~an~alias. }
  { A~slot~must~either~own~a~fontspec~resource~or~alias~another~slot. }
\msg_new:nnnn { osgstyler } { missing-main-font }
  { Font~palette~'#1'~does~not~define~the~required~slot~'main'. }
  { Add~main={font={...}}~to~the~palette. }
\msg_new:nnnn { osgstyler } { unknown-font-palette }
  { Unknown~font~palette~'#1'. }
  { Declare~it~with~\token_to_str:N\DeclareOsgFontPalette~before~using~it. }
\msg_new:nnnn { osgstyler } { unavailable-font-slot }
  { Font~slot~'#2'~is~not~available~in~palette~'#1'. }
  { Define~that~slot~or~one~of~its~standard~fallbacks. }
\msg_new:nnnn { osgstyler } { font-alias-cycle }
  { Font~palette~'#1'~contains~an~alias~cycle~at~slot~'#2'. }
  { Change~the~aliases~so~that~they~eventually~resolve~to~a~font~resource. }
\msg_new:nnnn { osgstyler } { math-font-selection }
  { Font~slot~'math'~cannot~be~selected~as~a~text~font. }
