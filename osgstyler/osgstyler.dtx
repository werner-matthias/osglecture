% \ldeen*{Ein bewusst zurückhaltendes Accessoire zu \code{osl-modern}
% (siehe dort): ein gezeichnetes \cs{rule}-Quadrat statt eines
% Font-Glyphen für die oberste Aufzählungsebene, gefärbt über
% \cs{OsgColorName}. Da ein gezeichnetes Element kein Glyph aus
% irgendeiner Schrift braucht, kann es auch nicht mit einer
% Begleitschrift kollidieren. \code{osl-standard} bleibt bei
% enumitems eigenen Vorgaben.}
% {A deliberately restrained accessory to \code{osl-modern} (see
% there): a drawn \cs{rule} square instead of a font glyph for the
% top-level itemize marker, colored via \cs{OsgColorName}. Since a
% drawn element needs no glyph from any typeface, it cannot clash with
% a companion face either. \code{osl-standard} stays with enumitem's
% own defaults.}
\DeclareOsgListPalette { osl-modern }
  {
    itemize =
      {
        1 = { label = \textcolor{\OsgColorName{accent}}
                { \rule[.15ex]{.9ex}{.9ex} } }
      }
  }

