  \command{UseOsgFont}[\marg{slot}]
    \ldeen{Wählt die Schrift von \meta{slot} in der aktiven Palette aus
    (\cs*{fontfamily}\ldots\cs*{selectfont}); \meta{slot} darf nicht
    \code{math} sein.}{Selects the font of \meta{slot} in the active
    palette (\cs*{fontfamily}\ldots\cs*{selectfont}); \meta{slot} must not
    be \code{math}.}
  \expandable\command{OsgActiveFontPalette}
    \ldeen{Expandierbar; Name der aktiven Schriftpalette.}{Expandable; name
    of the active font palette.}
  \expandable\command{OsgFontPaletteValue}[\marg{palette}\marg{slot}\marg{property}]
    \ldeen{Expandierbar; roher, gespeicherter Wert (\code{kind},
    \code{font}/\code{features} oder \code{alias}, \code{description}) --
    ohne Alias-Auflösung.}{Expandable; raw stored value (\code{kind},
    \code{font}/\code{features} or \code{alias}, \code{description}) --
    without alias resolution.}
  \command{OsgFontPaletteResolvedSlotTo}[\marg{palette}\marg{slot}\marg{tl-var}]
    \ldeen{Löst Alias-Ketten und Rückfälle auf, speichert den
    Ressourcen-Slotnamen in \meta{tl-var}.}{Resolves alias chains and
    fallbacks, stores the resource slot name in \meta{tl-var}.}
  \command{OsgFontPaletteAvailableTF}[\marg{true}\marg{false}]
