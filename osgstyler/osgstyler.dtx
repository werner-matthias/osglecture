                { \l__osgstyler_lua_cap_height_dim
                  +\l__osgstyler_lua_offset_dim
                  +\l__osgstyler_lua_thickness_dim }
              \dim_set:Nn \l__osgstyler_lua_bottom_dim
                { \l__osgstyler_lua_cap_height_dim
                  +\l__osgstyler_lua_offset_dim }
