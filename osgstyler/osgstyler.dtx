        \l__osgstyler_decoration_value_tl
      \__osgstyler_decoration_default:Nn \l__osgstyler_decoration_value_tl { .1ex }
      \exp_args:NV \__osgstyler_decoration_metric_resolve:nN
        \l__osgstyler_decoration_value_tl \l__osgstyler_decoration_value_tl
      \dim_set:Nn \l__osgstyler_lua_offset_dim
        { \l__osgstyler_decoration_value_tl }
