% \ldeen*{Begleiten @1/@2 aus Konsistenzgründen (siehe dort): @3 bleibt
% wie im Default bei \cls*{amsthm}-nahen Dokumenten üblich; @4 tauscht
% nur die Begleitschrift (\code{companion}/\code{accent}/\code{display})
% gegen eine deutlicher zeitgenössisch wirkende Groteske, ohne den
% Fließtext (\code{main}) anzutasten -- ein bewusst kleiner, risikoarmer
% Unterschied.}
% {Accompany @1/@2 for consistency (see there): @3 stays exactly like
% the default, as usual for \cls*{amsthm}-adjacent documents; @4 only
% swaps the companion face (\code{companion}/\code{accent}/\code{display})
% for a visibly more contemporary sans, leaving body text (\code{main})
% untouched -- a deliberately small, low-risk difference.}
% {\code{osl-standard}}{\code{osl-modern}}{osl-standard}
\DeclareOsgFontPalette { osl-standard }
  {
    main      = { font = { Latin Modern Roman } },
    companion = { font = { Latin Modern Sans } },
    display   = { alias = companion },
    accent    = { alias = companion },
    mono      = { font = { Latin Modern Mono } },
    symbol    = { alias = main }
  }
\DeclareOsgFontPalette { osl-modern }
  {
    main      = { font = { Latin Modern Roman } },
    companion = { font = { TeX Gyre Heros } },
    display   = { alias = companion },
    accent    = { alias = companion },
    mono      = { font = { Latin Modern Mono } },
    symbol    = { alias = main }
  }

