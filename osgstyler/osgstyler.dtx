% text/background are not aliased into the slot-fallback chain above:
% every other slot's fallback is another *theme* color (ultimately
% primary), which is appropriate for accents but not for body text or
% the page background, where a theme accent color risks poor
% contrast or an unintended colored background. Their fallback is
% therefore a fixed neutral value, kept in its own small table rather
% than special-cased in the resolution code.
\prop_new:N \c__osgstyler_color_absolute_default_prop
\prop_gput:Nnn \c__osgstyler_color_absolute_default_prop { text } { black }
\prop_gput:Nnn \c__osgstyler_color_absolute_default_prop { background } { white }

\cs_new_protected:Npn \__osgstyler_color_resolve:nnN #1#2#3
  {
