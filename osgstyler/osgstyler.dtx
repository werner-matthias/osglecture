% ==========================================
% STYLING KNOWN ENVIRONMENTS (CASE A, WITHOUT OVERLAYS)
% ==========================================
%
% \ldeen*{@1 verallgemeinert das Muster, mit dem \pkg*{lttheme}
% \env{block} umhüllt, für Environments \emph{ohne} Overlay-Syntax --
% deren Argumentsignatur ist einheitlich genug (ein optionaler Name vor
% einem Textkörper), um sie generisch zu erfassen, anders als bei
% \env{block}/\env{alertblock}, die \cs{d<>} brauchen und daher
% themenspezifisch bleiben. Das optionale Argument wird unverändert an
% das umhüllte Original weitergereicht, nie selbst interpretiert --
% @2s eigene \Marg{Name}-Klammer vor \env{theorem}-artigen Environments
% (\cs{newtheorem}) funktioniert dadurch unverändert, samt eigener
% Nummerierung: @1 fügt nur die Box-Optik um @2s vollständige Ausgabe
% herum, ohne dessen Zähler oder Kopf-Rendering zu berühren.}
% {@1 generalizes the pattern \pkg*{lttheme} uses to wrap \env{block}
% for environments \emph{without} overlay syntax -- their argument
% signature is uniform enough (an optional name before a text body) to
% capture generically, unlike \env{block}/\env{alertblock}, which need
% \cs{d<>} and therefore stay theme-specific. The optional argument is
% forwarded to the wrapped original unchanged, never interpreted here
% itself -- @2's own \Marg{name} bracket in front of \env{theorem}-like
% environments (\cs{newtheorem}) therefore keeps working unchanged,
% numbering included: @1 only adds the box styling around @2's complete
% output, without touching its counter or heading rendering.}
% {\cs{BindOsgBlockEnvironment}}{\pkg*{amsthm}}

\NewDocumentCommand \BindOsgBlockEnvironment { m m }
  { \__osgstyler_block_bind_environment:nn {#1}{#2} }

\cs_new_protected:Npn \__osgstyler_block_render_bound:nnnn #1#2#3#4
  {
    \__osgstyler_block_use:nnn {#2} { }
      {
        \IfNoValueTF {#3}
          { \begin{osgstyler-original-#1} #4 \end{osgstyler-original-#1} }
          { \begin{osgstyler-original-#1}[#3] #4 \end{osgstyler-original-#1} }
      }
  }

% See \cs{NewOsgStyledEnvironment} for why discarding the body
% conditionally is safe here.
\cs_new_protected:Npn \__osgstyler_block_bound_mode_dispatch:nnnnn #1#2#3#4#5
  {
    \IfNoValueTF {#3}
      { \__osgstyler_block_render_bound:nnnn {#1}{#2}{#4}{#5} }
      {
        \IfLectureModeT {#3}
          { \__osgstyler_block_render_bound:nnnn {#1}{#2}{#4}{#5} }
      }
  }

\cs_new_protected:Npn \__osgstyler_block_bind_environment:nn #1#2
  {
    \NewEnvironmentCopy { osgstyler-original-#1 } {#1}
    \cs_if_exist:NTF \IfLectureModeTF
      {
        \RenewDocumentEnvironment {#1} { d<> o +b }
          {
            \__osgstyler_block_bound_mode_dispatch:nnnnn
              {#1}{#2}{##1}{##2}{##3}
          }
          { }
      }
      {
        \RenewDocumentEnvironment {#1} { o +b }
          { \__osgstyler_block_render_bound:nnnn {#1}{#2}{##1}{##2} }
          { }
      }
  }

% \ldeen*{Die \cls*{LaTeX}-Kernumgebungen @1/@2 sind auf jedem Ziel
% verfügbar, weshalb ihre Instanzen -- unsichtbar, wie die
% Schnittstellen-Vorgaben es ohnehin vorsehen -- immer deklariert sind.
% Umgebunden werden sie aber erst durch einen bewussten Aufruf von
% \cs{BindOsgBlockEnvironment} oder @3, nicht beim Laden dieses Pakets:
% wer \pkg*{osgstyler} nur wegen Farben oder Inline-Befehlen lädt, soll
% nicht überrascht feststellen, dass sich seine Zitate verändert
% haben.}
% {The \cls*{LaTeX} kernel environments @1/@2 are available on every
% target, which is why their instances -- invisible, as the interface
% defaults already provide anyway -- are always declared. They are only
% actually rebound by a deliberate call to \cs{BindOsgBlockEnvironment}
% or @3, not on loading this package: someone loading \pkg*{osgstyler}
% only for colors or inline commands should not be surprised to find
% their quotations changed.}
% {\env{quote}}{\env{quotation}}{\cs{UseOsgStandardBlockEnvironments}}
\DeclareInstance { osgstyler-block } { quote } { standard } { }
\DeclareInstance { osgstyler-block } { quotation } { standard } { }

% \ldeen*{@1/@2/@3 reproduzieren Beamers eigene, freie Titelsignatur
% (\Verb+\begin{block}{Titel}+) über @4 -- dieselbe Quelle kompiliert
% damit unter Beamer/ltx-talk (dort natives Environment, siehe
% \pkg*{lttheme}) wie unter der Langform (hier neu erzeugt) gleich.
% Nur wenn der Name noch nicht existiert wird das Environment
% angelegt: existiert es schon nativ, ändert @5 daran nichts.}
% {@1/@2/@3 reproduce beamer's own free-title signature
% (\Verb+\begin{block}{Title}+) via @4 -- the same source therefore
% compiles the same way under beamer/ltx-talk (native environment
% there, see \pkg*{lttheme}) and under the long form (newly created
% here). The environment is only created if the name does not exist
% yet: if it is already native, @5 leaves it untouched.}
% {\env{block}}{\env{alertblock}}{\env{exampleblock}}
% {\cs{NewOsgStyledEnvironment}}{\cs{UseOsgStandardBlockEnvironments}}
\DeclareInstance { osgstyler-block } { block } { standard }
  { rule-thickness = .4pt, padding = .5em }
\DeclareInstance { osgstyler-block } { alertblock } { standard }
  { rule-thickness = .4pt, padding = .5em, rule-color = alert }
\DeclareInstance { osgstyler-block } { exampleblock } { standard }
  { rule-thickness = .4pt, padding = .5em, rule-color = example }

\NewDocumentCommand \UseOsgStandardBlockEnvironments { }
  {
    \BindOsgBlockEnvironment { quote } { quote }
    \BindOsgBlockEnvironment { quotation } { quotation }
    \cs_if_exist:cF { block }
      { \NewOsgStyledEnvironment { block } { block } { none } [ 1 ] { ##1 } }
    \cs_if_exist:cF { alertblock }
      { \NewOsgStyledEnvironment { alertblock } { alertblock } { none } [ 1 ] { ##1 } }
    \cs_if_exist:cF { exampleblock }
      { \NewOsgStyledEnvironment { exampleblock } { exampleblock } { none } [ 1 ] { ##1 } }
  }

% \ldeen*{Ein weiteres @1-Accessoire: eine dünne, akzentfarbene Linie
% vor und nach dem Inhalt statt eines vollen Rahmens (\code{rule-thickness
% = 0pt} erzwingt das, unabhängig vom bisherigen Zustand der Instanz) --
% passend sowohl für Zitate als auch für theorem-artige Umgebungen ohne
% eigenen Kasten (\cls*{amsthm} rahmt seine Umgebungen ja auch nicht
% ein). Ein \cs{traits}-Wert durchläuft auf dem Weg von der Deklaration
% bis zur fertigen Instanz mehrere vollständige Expansionsrunden (siehe
% \cs{__osgstyler_block_instance_resolve:n}); Befehle mit eigenem
% Lookahead auf das nächste Zeichen (\cs{rule}s optionales
% Anhebungs-Argument, \cs{vspace}, \cs{newline}, \cs{par} innerhalb
% eines nicht-\cs{long}-Arguments von \pkg*{l3keys}) überstehen das
% nicht zuverlässig. Die eigentliche Zeichenlogik steckt deshalb in
% einer \cs{cs_new_protected:Npn}-Funktion, die als Ganzes durch alle
% Runden unangetastet durchgereicht wird (wie ein bereits
% \code{\\protected}-markierter Kernbefehl) und erst beim tatsächlichen
% Satz ausgeführt statt expandiert wird -- innerhalb dieser Funktion
% sind \cs{par} & Co. wieder ganz normal verwendbar, da dort keine
% weitere Expansion mehr stattfindet.}
% {Another @1 accessory: a thin, accent-colored line before and after
% the content instead of a full border (\code{rule-thickness = 0pt}
% forces this regardless of the instance's prior state) -- suits both
% quotations and theorem-like environments without their own box
% (\cls*{amsthm} does not frame its environments either). A \cs{traits}
% value passes through several full expansion rounds on its way from
% declaration to the finished instance (see
% \cs{__osgstyler_block_instance_resolve:n}); commands with their own
% lookahead for the next character (\cs{rule}'s optional raise
% argument, \cs{vspace}, \cs{newline}, \cs{par} inside a non-\cs{long}
% \pkg*{l3keys} argument) do not reliably survive that. The actual
% drawing logic therefore lives in a \cs{cs_new_protected:Npn} function
% that passes through all rounds untouched as a whole (like an
% already-\code{\\protected} kernel command) and is executed rather
% than expanded only at actual typesetting time -- inside that
% function, \cs{par} and friends are perfectly usable again, since no
% further expansion happens there.}
% {osl-modern}
\cs_new_protected:Npn \__osgstyler_osl_modern_rule:n #1
  {
    \noindent{\color{\OsgColorName{#1}}\vrule width\linewidth
      height.6pt depth0pt}
  }
\cs_new_protected:Npn \__osgstyler_osl_modern_rule_before:
  { \par \__osgstyler_osl_modern_rule:n {accent} \vskip.3em }
\cs_new_protected:Npn \__osgstyler_osl_modern_rule_after:
  { \vskip.3em \__osgstyler_osl_modern_rule:n {accent} }

\DeclareOsgBlockTrait { osl-modern-rules }
  {
    rule-thickness = 0pt,
    before = \__osgstyler_osl_modern_rule_before:,
    after  = \__osgstyler_osl_modern_rule_after:
  }

% \ldeen*{Gebrauchsfertige Block-Optiken als Traits. Farben sind
% Slot-Namen (\code{structure} usw.), sodass sie der ladenden Palette bzw.
% dem Theme folgen; \code{alertblock}/\code{exampleblock} überschreiben
% danach nur den Slot.
%
% \code{heading} (nur farbiger Titel), \code{soft} (Titel mit dünnen
% Linien) und \code{plain} fließen vollständig und belassen das Tagging der
% Klasse unangetastet -- die richtige Wahl, wenn jede \code{Div}-Ebene im
% getaggten PDF zählt. \code{card} (die Vorgabe), \code{titlebar} (Beamers
% Madrid: Farbbalken über getönter Body-Fläche), \code{framed} und
% \code{filled} setzen einen echten Kasten (\cs{fcolorbox} um eine
% \env{minipage}); das fügt je Block genau ein \code{Div} hinzu -- Titel
% und Body bleiben saubere \code{text-unit}s darin, ohne Verschachtelung.}
% {Ready-made block looks as traits. Colours are slot names
% (\code{structure} etc.) so they follow the loaded palette or theme;
% \code{alertblock}/\code{exampleblock} then only override the slot.
%
% \code{heading} (a coloured title only), \code{soft} (a title with thin
% rules) and \code{plain} are fully flowing and leave the class's tagging
% untouched -- the right choice when every \code{Div} level in tagged PDF
% counts. \code{card} (the default), \code{titlebar} (beamer's Madrid: a
% colour bar over a tinted body area), \code{framed} and \code{filled} put
% a real box (\cs{fcolorbox} around a \env{minipage}); that adds exactly
% one \code{Div} per block -- title and body stay clean \code{text-unit}s
% inside it, with no nesting.}
\DeclareOsgBlockTrait { plain }
  { layout = plain, rule-thickness = 0pt, background = none }
\DeclareOsgBlockTrait { framed }
  { layout = plain, rule-thickness = 0.4pt, rule-color = structure,
    padding = 0.5em }
\DeclareOsgBlockTrait { filled }
  { layout = plain, rule-thickness = 0.4pt, rule-color = structure,
    background = structure!8, padding = 0.5em }
% \ldeen{\code{titlebar}: Beamers Madrid -- voller Farbbalken oben, darunter
%   die getönte Body-Fläche bis zur Kastenunterkante. Durch das gesetzte
%   \code{body-background} nimmt der \code{titled}-Renderer seinen
%   Kastenzweig (ein \code{Div}).}{\code{titlebar}: beamer's Madrid -- a full
%   colour bar on top, the tinted body area below it down to the box's
%   bottom edge. The set \code{body-background} makes the \code{titled}
%   renderer take its boxed branch (one \code{Div}).}
\DeclareOsgBlockTrait { titlebar }
  {
    layout = titled,
    head-background = structure, head-color = background,
    body-background = structure!12,
    rule-thickness = 0pt, rule-color = structure!40,
    head-rule-thickness = 0pt, foot-rule-thickness = 0pt,
    head-padding = 0.4em, body-padding = 0.6em
  }
\DeclareOsgBlockTrait { soft }
  {
    layout = titled,
    head-background = none, head-color = structure,
    head-rule-color = structure, head-rule-thickness = 1pt,
    foot-rule-color = structure!45, foot-rule-thickness = 0.6pt,
    head-padding = 0pt, body-padding = 0.9em
  }
% \ldeen{\code{heading}: nur der farbige, fette Titel, darunter der bündige
%   Body -- fließend, ohne Balken, Fläche oder Linien. Wie Beamers
%   Default-Block (Hannover, Szeged). \code{head-rule}/\code{foot-rule} auf
%   einen positiven Wert setzen bringt die \code{soft}-Linien zurück.}{
%   \code{heading}: just the coloured bold title with the body flush below
%   it -- flowing, no bar, no fill, no rules. Like beamer's default block
%   (Hannover, Szeged). Setting \code{head-rule}/\code{foot-rule} to a
%   positive value brings the \code{soft} rules back.}
\DeclareOsgBlockTrait { heading }
  {
    layout = titled,
    head-background = none, head-color = structure,
    head-rule-color = structure, head-rule-thickness = 0pt,
    foot-rule-color = structure!45, foot-rule-thickness = 0pt,
    head-padding = 0pt, body-padding = 0pt
  }
% \ldeen{\code{card}: eine leicht gerahmte, zart getönte Box mit farbig
%   fettem Titel -- die Vorgabe. Als echter Kasten (\cs{fcolorbox} um eine
%   \env{minipage}) fügt sie im getaggten PDF ein \code{Div} je Block hinzu,
%   sonst nichts (Titel und Body bleiben saubere \code{text-unit}s darin).}{
%   \code{card}: a lightly framed, faintly tinted box with a coloured bold
%   title -- the default. Being a real box (\cs{fcolorbox} around a
%   \env{minipage}) it adds one \code{Div} per block in tagged PDF and
%   nothing else (title and body stay clean \code{text-unit}s inside it).}
\DeclareOsgBlockTrait { card }
  {
    layout = plain,
    rule-thickness = 0.8pt, rule-color = structure!70,
    background = structure!10,
    padding = 0.65em,
    head-color = structure, head-font = \normalfont \bfseries
  }

% \ldeen*{Ein Preset besteht aus bis zu vier unabhängig deklarierten
% Teilen (Farb-, Font- und Listenpalette, Block-Trait) unter demselben
% Namen; ohne @1 müsste eine Vorlage wie \code{osl-modern} durch vier
% getrennte Aufrufe aktiviert und der Trait zusätzlich von Hand auf
% jede gewünschte Block-Instanz angewendet werden. @1 aktiviert Farb-
% und (sofern @2 nicht \code{colors-only} gesetzt hat) Fontpalette
% immer; Listenpalette und Trait nur, wenn unter demselben Namen
% tatsächlich etwas deklariert ist -- @3 hat z.\,B.\ keine eigene
% Listenpalette. Der Trait wird auf die immer schon deklarierten
% Standard-Blockinstanzen (@4) angewendet, unabhängig davon, ob deren
% Environments überhaupt schon (via \cs{UseOsgStandardBlockEnvironments}
% oder \cs{BindOsgBlockEnvironment}) angebunden sind -- das Anwenden
% eines Traits ist reine, folgenlose Keyval-Verwaltung, bis eine
% tatsächlich gebundene Umgebung sie einmal abfragt.}
% {A preset consists of up to four independently declared parts (color,
% font, and list palette, block trait) sharing one name; without @1, a
% preset such as \code{osl-modern} would need four separate calls to
% activate, plus manually applying the trait to every desired block
% instance. @1 always activates the color palette and (unless @2 has
% set \code{colors-only}) the font palette; it activates the list
% palette and trait only if something is actually declared under the
% same name -- @3, for instance, has no list palette of its own. The
% trait is applied to the standard block instances (@4), which are
% always already declared, regardless of whether their environments
% are bound yet at all (via \cs{UseOsgStandardBlockEnvironments} or
% \cs{BindOsgBlockEnvironment}) -- applying a trait is pure,
% consequence-free keyval bookkeeping until some actually bound
% environment queries it.}
% {\cs{UseOsgPreset}}{osgstyler}{osl-standard}{\env{quote}/\env{quotation}/\env{block}/\env{alertblock}/\env{exampleblock}}
\msg_new:nnnn { osgstyler } { unknown-preset }
  { Unknown~preset~'#1'. }
  { Available~presets~are~osl-standard~and~osl-modern,~or~build~your~own~
    from~\token_to_str:N\UseOsgColorPalette,~\token_to_str:N\UseOsgFontPalette,~
    \token_to_str:N\UseOsgListPalette,~and~\token_to_str:N\StyleOsgBlockInstance. }

\clist_const:Nn \c__osgstyler_preset_block_instances_clist
  { quote, quotation, block, alertblock, exampleblock }

\cs_new_protected:Npn \__osgstyler_preset_use:n #1
  {
    \prop_if_in:NnTF \g__osgstyler_color_palette_prop { #1 / declared }
      {
        \UseOsgColorPalette {#1}
        \OsgFontPaletteAvailableTF
          {
            \prop_if_in:NnT \g__osgstyler_font_palette_prop { #1 / declared }
              { \UseOsgFontPalette {#1} }
          }
          { }
        \prop_if_in:NnT \g__osgstyler_list_palette_prop { #1 / declared }
          { \UseOsgListPalette {#1} }
        \prop_if_in:NnT \g__osgstyler_block_trait_prop { #1-rules }
          {
            \clist_map_inline:Nn \c__osgstyler_preset_block_instances_clist
              { \StyleOsgBlockInstance {##1} { traits = {#1-rules} } }
          }
      }
      { \msg_error:nnn { osgstyler } { unknown-preset } {#1} }
  }

\NewDocumentCommand \UseOsgPreset { m }
  { \__osgstyler_preset_use:n {#1} }

% ==========================================
% ATTRIBUTED ENVIRONMENTS (CASE B, CONTENT-THEN-ATTRIBUTION)
% ==========================================
%
% \ldeen*{Ein zweiter Fall-B-Baustein neben \cs{NewOsgStyledEnvironment}:
% ein semantisches Zitat trägt keine Titelzeile mit Label und Zahl vor
% dem Inhalt, sondern höchstens eine Quellenangabe danach -- die
% Zusammensetzung ist genau umgekehrt, weshalb dies ein eigener,
% schlanker Mechanismus ist statt einer weiteren Option von
% \cs{NewOsgStyledEnvironment}.}
% {A second case-B building block alongside \cs{NewOsgStyledEnvironment}:
% a semantic quotation carries no label-and-number title before its
% content, only an optional attribution after it -- the composition is
% exactly reversed, which is why this is its own, lean mechanism rather
% than another option of \cs{NewOsgStyledEnvironment}.}
% {\cs{NewOsgAttributedEnvironment}}

\tl_new:N \l__osgstyler_attributed_env_tl

\cs_new_protected:Npn \__osgstyler_attributed_env_begin:nnn #1#2#3
  {
    \group_begin:
      \tl_set:Nn \l__osgstyler_attributed_env_tl {#3}
      \IfNoValueF {#2}
        {
          \tl_put_right:Nn \l__osgstyler_attributed_env_tl
            { \par \hfill ---~#2 }
        }
      \__osgstyler_block_use:nnn {#1} { }
        { \tl_use:N \l__osgstyler_attributed_env_tl }
    \group_end:
  }

% See \cs{NewOsgStyledEnvironment} for why discarding the body
% conditionally is safe here.
\cs_new_protected:Npn \__osgstyler_attributed_env_mode_dispatch:nnnn #1#2#3#4
  {
    \IfNoValueTF {#2}
      { \__osgstyler_attributed_env_begin:nnn {#1}{#3}{#4} }
      {
        \IfLectureModeT {#2}
          { \__osgstyler_attributed_env_begin:nnn {#1}{#3}{#4} }
      }
  }

\NewDocumentCommand \NewOsgAttributedEnvironment { m m }
  {
    \cs_if_exist:NTF \IfLectureModeTF
      {
        \NewDocumentEnvironment {#1} { d<> o +b }
          { \__osgstyler_attributed_env_mode_dispatch:nnnn {#2}{##1}{##2}{##3} }
          { }
      }
      {
        \NewDocumentEnvironment {#1} { o +b }
          { \__osgstyler_attributed_env_begin:nnn {#2}{##1}{##2} }
          { }
      }
  }

% \ldeen*{Optionale Integration von Modi, falls @1 geladen wurde.
% Die Auswahlbefehle (\token_to_str:N\UseOsgInlineStyle und die gebundenen
% Inline-Befehle sowie \token_to_str:N\UseOsgColorPalette,
% \token_to_str:N\UseOsgFontPalette, \token_to_str:N\UseOsgMetricPalette)
% werden modusabhängig (Parameter in spitzen Klammern), da ihr aktiver Modus
% zum Zeitpunkt des Aufrufs bekannt ist. Die Deklarationsbefehle
% (\token_to_str:N\DeclareOsgColorPalette und Geschwister) bleiben bewußt
% moduunabhängig: Eine Palette wird einmalig definiert, unabhängig davon, in
% welchen Moden sie später ausgewählt wird.}{Optional osglecture-modes
% integration. The selection commands (\token_to_str:N\UseOsgInlineStyle and
% the bound inline commands, as well as \token_to_str:N\UseOsgColorPalette,
% \token_to_str:N\UseOsgFontPalette, \token_to_str:N\UseOsgMetricPalette)
% accept a portable angle-bracket mode whenever @1 is present, since their
% active mode is known at the call site. The declaration commands
% (\token_to_str:N\DeclareOsgColorPalette and siblings) deliberately remain
% mode-independent: a palette is defined once, regardless of which modes
% later select it.}{\pkg{osglecture-modes}}
\bool_new:N \g__osgstyler_modes_integrated_bool

\cs_new_protected:Npn \__osgstyler_modes_integrate:
  {
    \bool_if:NF \g__osgstyler_modes_integrated_bool
      {
        \bool_gset_true:N \g__osgstyler_modes_integrated_bool
        \__osgstyler_make_mode_aware:Nn \UseOsgInlineStyle { m +m }
        \prop_map_inline:Nn \g__osgstyler_inline_command_socket_prop
          {
            \exp_args:Nc \__osgstyler_make_mode_aware:Nn {##1} { +m }
          }
        \__osgstyler_make_mode_aware:Nn \UseOsgColorPalette { m }
        \__osgstyler_make_mode_aware:Nn \UseOsgFontPalette { m }
        \__osgstyler_make_mode_aware:Nn \UseOsgMetricPalette { m }
        \__osgstyler_make_mode_aware:Nn \UseOsgListPalette { m }
        \__osgstyler_make_mode_aware:Nn \UseOsgPreset { m }
      }
  }

\AddToHook { package/osglecture-modes/after } [ osgstyler/modes ]
  { \__osgstyler_modes_integrate: }
\IfPackageLoadedTF { osglecture-modes }
  { \__osgstyler_modes_integrate: } { }

% \ldeen*{Reaktive Rückfallintegration für Themepakete, die ihre
% Themefarben nicht selbst über @1/@2 in osgstyler einspeisen. Speist ein
% Themepaket seine Farben selbst ein und aktiviert dabei die
% osgstyler-Palette @3 (vgl.\ @4), erkennt dieser Abschnitt sich anhand
% der aktiven Palette selbst als überflüssig und tut nichts.}{Reactive
% fallback integration for theme packages that do not feed their theme
% colors into osgstyler themselves via @1/@2. A theme package that feeds
% its own colors in and activates the osgstyler palette @3 while doing so
% (cf.\ @4) makes this section recognize itself as redundant, via the
% active palette, and do nothing.}{\cs{DeclareOsgColorPalette}}
% {\cs{UseOsgColorPalette}}{\code{ltxtalk}}{\cs{setltxtalkcolors}}
\bool_new:N \g__osgstyler_lttheme_integrated_bool

\cs_new_protected:Npn \__osgstyler_lttheme_sync_colors:
  {
    \str_if_eq:VnF \g__osgstyler_color_palette_tl { ltxtalk }
      {
    \clist_map_inline:Nn \c__osgstyler_color_slots_clist
      {
        \str_if_eq:nnTF {##1} { background }
          { \tl_set:Nn \l_tmpa_tl { bg } }
          { \tl_set:Nn \l_tmpa_tl {##1} }
        \exp_args:Ne \color_export:nnN
          { ltxtalk-\l_tmpa_tl } { HTML } \l_tmpb_tl
        \prop_gput:Nnn \g__osgstyler_color_palette_prop
          { lttheme / ##1 / kind } { resource }
        \prop_gput:Nnn \g__osgstyler_color_palette_prop
          { lttheme / ##1 / model } { HTML }
        \prop_gput:Nne \g__osgstyler_color_palette_prop
          { lttheme / ##1 / value } { \l_tmpb_tl }
        \use:e
          {
            \exp_not:N \definecolor
              { osgstyler-##1 } { HTML } { \l_tmpb_tl }
          }
      }
    \prop_gput:Nnn \g__osgstyler_color_palette_prop
      { lttheme / declared } { true }
    \tl_gset:Nn \g__osgstyler_color_palette_tl { lttheme }
      }
  }

\cs_new_protected:Npn \__osgstyler_lttheme_integrate:
  {
    \bool_if:NF \g__osgstyler_lttheme_integrated_bool
      {
        \bool_gset_true:N \g__osgstyler_lttheme_integrated_bool
        \AddToHook { cmd/useltxtalktheme/after }
          [ osgstyler/lttheme/theme ]
          { \__osgstyler_lttheme_sync_colors: }
        \AddToHook { cmd/addltxtalktheme/after }
          [ osgstyler/lttheme/add-theme ]
          { \__osgstyler_lttheme_sync_colors: }
        \AddToHook { cmd/setltxtalkcolors/after }
          [ osgstyler/lttheme/colors ]
          { \__osgstyler_lttheme_sync_colors: }
        \__osgstyler_lttheme_sync_colors:
      }
  }

% \ldeen*{@1 ist ein Koordinationssignal: Ein Paket, das es vor dem
% eigenen @2 definiert (lttheme tut dies, siehe dort), zeigt damit an,
% dass es seine Themefarben selbst über @3/@4 einspeist und die reaktive
% Integration hier überflüssig, ja sogar riskant wäre. Riskant, weil @2
% aus Sicht von \LaTeX{} schon dann als geladen gilt, sobald das
% aufrufende Paket seine eigene \cs{ProvidesExplPackage}-Zeile
% durchlaufen hat -- lange bevor es seine eigenen Farben definiert; die
% reaktive Integration würde in diesem Moment sonst auf noch nicht
% existierende Farben zugreifen.}{@1 is a coordination signal: a package
% that defines it before its own @2 (lttheme does, see there) thereby
% indicates that it feeds its own theme colors into osgstyler via @3/@4
% itself, making the reactive integration here redundant, in fact risky.
% Risky, because @2 already counts as loaded from \LaTeX's perspective
% as soon as the requiring package's own \cs{ProvidesExplPackage} line
% has run -- long before it defines its own colors; the reactive
% integration would otherwise access not-yet-existing colors at that
% point.}
% {\cs{LtxtalkUsesOsgstylerNatively}}{\cs{RequirePackage}\Marg{osgstyler}}
% {\cs{DeclareOsgColorPalette}}{\cs{UseOsgColorPalette}}
\cs_if_exist:NF \LtxtalkUsesOsgstylerNatively
  {
    \AddToHook { package/ltxtalk-theme/after } [ osgstyler/lttheme ]
      { \__osgstyler_lttheme_integrate: }
    \IfPackageLoadedTF { ltxtalk-theme }
      { \__osgstyler_lttheme_integrate: } { }
  }

