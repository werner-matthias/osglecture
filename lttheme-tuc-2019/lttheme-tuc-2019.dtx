% \ldeen{Ein unbekannter Instanzname fiel bisher stillschweigend auf die
%   Rückfallzeilen (Titel/Untertitel/Institut, unabhängig von der
%   Zeilenzahl) zurück, was leicht als ignorierter Aufruf missverstanden
%   werden kann. Ungültige Werte werden deshalb jetzt zurückgewiesen.}{
%   An unrecognized instance name used to silently fall back to the
%   default lines (title/subtitle/institute, regardless of the row
%   count), which is easily mistaken for an ignored call. Invalid values
%   are therefore now rejected.}
\NewDocumentCommand \settucthemeheader {m}
  {
    \str_case:nnF {#1}
      {{title}{}{section}{}{teaching}{}{custom}{}}
      {
        \msg_error:nneee { tuc-2019 } { unknown-choice }
          { settucthemeheader } { title, section, teaching, custom } {#1}
      }
    \tl_gset:Nn \g__ltxtalk_tuc_header_instance_tl {#1}
  }
\NewDocumentCommand \settucthemeheaderlines {m m m}
  {
    \tl_gset:Nn \g__ltxtalk_tuc_header_instance_tl {custom}
    \tl_gset:Nn \g__ltxtalk_tuc_header_line_one_tl {#1}
    \tl_gset:Nn \g__ltxtalk_tuc_header_line_two_tl {#2}
    \tl_gset:Nn \g__ltxtalk_tuc_header_line_three_tl {#3}
  }
\NewDocumentCommand \settucthemetitle {m}
  {
    \tl_gset:Nn \g__ltxtalk_tuc_title_instance_tl {#1}
