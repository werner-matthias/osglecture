\dim_new:N \l__ltxtalk_tuc_crop_bottom_dim
\dim_new:N \l__ltxtalk_tuc_crop_top_dim
% \ldeen{Geometrische Grundmaße der Kopfzeile: die Zeilenhöhe von
%   \cs{footnotesize}\cs{sffamily} in dieser Klasse (gemessen als
%   \cs{baselineskip}), der horizontale Randabstand (Seitenrand zu Logo,
%   und Logo zu Trennstrich), der Abstand zwischen Trennstrich und Text
%   sowie die Strichstärke des Trennstrichs. Logo, Trennstrich und
%   Navigationstext werden ausschließlich aus diesen Maßen abgeleitet,
%   damit sie zwangsläufig konsistent zueinander stehen.}{
%   Basic header geometry: the line height of \cs{footnotesize}\cs{sffamily}
%   in this class (measured as \cs{baselineskip}), the horizontal margin
%   (page edge to logo, and logo to divider), the gap between the divider
%   and the text, and the divider's rule thickness. The logo, divider, and
%   navigation text are derived exclusively from these measures so they
%   are necessarily consistent with one another.}
\dim_const:Nn \c__ltxtalk_tuc_header_line_dim {11pt}
\dim_const:Nn \c__ltxtalk_tuc_header_margin_dim {0.4cm}
\dim_const:Nn \c__ltxtalk_tuc_header_text_gap_dim {0.4cm}
\dim_const:Nn \c__ltxtalk_tuc_header_rule_thickness_dim {0.4pt}
% \ldeen{Höhe des Navigationstextblocks: die Zeilenzahl mal die
%   Zeilenhöhe, ohne Zuschlag. Logo und Trennstrich übernehmen exakt diese
%   Höhe, damit ihre Ober- und Unterkante mit der obersten und untersten
%   Textzeile fluchten.}{
%   Height of the navigation text block: the line count times the line
%   height, with no further padding. The logo and divider take on exactly
%   this height, so that their top and bottom edges align with the
%   topmost and bottommost text line.}
\cs_new:Npn \__ltxtalk_tuc_header_content_height:
  {\dimexpr \c__ltxtalk_tuc_header_line_dim*\LTXTalkHeaderRows \relax}
% \ldeen{Der obere (und wegen der Zentrierung gleich große untere)
%   Abstand des Kopfzeilenmaterials zur tatsächlich sichtbaren
%   Kopfzeilenfläche. Diese ist um \cs{headsep} niedriger als
%   \cs{l__ltxtalk_header_height_dim}, da der Seitenstil die Kopfzeilenhöhe
%   der \pkg{geometry}-Kopfzone entnimmt.}{
%   The top (and, by centering, equally sized bottom) distance of the
%   header material from the actually visible header area. That area is
%   shorter than \cs{l__ltxtalk_header_height_dim} by \cs{headsep}, because
%   the page style derives the header height from \pkg{geometry}'s head
%   zone.}
\cs_new:Npn \__ltxtalk_tuc_header_margin_y:
  {
    \dimexpr
      (
        \l__ltxtalk_header_height_dim-\headsep
        -\__ltxtalk_tuc_header_content_height:
      )/2
    \relax
  }
% \ldeen{Y-Position von Logo, Trennstrich und oberster Textzeile innerhalb
%   der Kopfzeilenfläche. Deren interner Nullpunkt liegt um \cs{headsep}
%   \emph{oberhalb} des sichtbar bleibenden Bereichs (derselbe \cs{headsep},
%   der die sichtbare Fläche gegenüber \cs{l__ltxtalk_header_height_dim}
%   verkürzt); der obere Randabstand wird deshalb ab diesem verschobenen
%   Nullpunkt gezählt, nicht ab der sichtbaren Oberkante.}{
%   Y position of the logo, divider, and topmost text line within the
%   header area. That area's internal origin sits \cs{headsep}
%   \emph{above} the region that stays visible (the same \cs{headsep} that
%   shortens the visible area relative to \cs{l__ltxtalk_header_height_dim});
%   the top margin is therefore counted from that shifted origin, not from
%   the visible top edge.}
\cs_new:Npn \__ltxtalk_tuc_header_y_offset:
  {\dimexpr \headsep+\__ltxtalk_tuc_header_margin_y: \relax}
% \ldeen{Ermittelt die aktuell zu verwendende Logodatei (explizit gesetzt,
%   Jubiläumslogo oder Standardlogo) in \cs{l__ltxtalk_tuc_logo_file_tl}.
%   Sowohl die Anzeige des Logos als auch die Vermessung seiner Breite
%   nutzen diese eine Stelle, damit beide nie auseinanderlaufen.}{
%   Determines the logo file currently in effect (explicit override,
%   anniversary logo, or default logo) into \cs{l__ltxtalk_tuc_logo_file_tl}.
%   Both displaying the logo and measuring its width use this single
%   place so the two can never diverge.}
\tl_new:N \l__ltxtalk_tuc_logo_file_tl
\cs_new_protected:Npn \__ltxtalk_tuc_set_logo_file:
  {
    \tl_if_blank:VTF \g__ltxtalk_tuc_logo_tl
      {
        \bool_if:NTF \g_ltxtalk_chemnitz_bool
          {
            \str_if_eq:eeTF {\languagename}{english}
              {\tl_set:Nn \l__ltxtalk_tuc_logo_file_tl {tuckhseng_white.pdf}}
              {\tl_set:Nn \l__ltxtalk_tuc_logo_file_tl {tuckhs_white.pdf}}
          }
          {\tl_set:Nn \l__ltxtalk_tuc_logo_file_tl {tuc_white.pdf}}
      }
      {\tl_set_eq:NN \l__ltxtalk_tuc_logo_file_tl \g__ltxtalk_tuc_logo_tl}
  }
% \ldeen{Vermisst die Breite, mit der das aktuelle Logo bei der aktuellen
%   Höhe des Navigationstextblocks tatsächlich gesetzt wird, und legt sie
%   in \cs{g__ltxtalk_tuc_header_logo_width_dim} ab. Trennstrich, Text und
%   die linke Logospalte im schmalen Layout richten sich nach diesem Wert,
%   damit sie unabhängig vom Seitenverhältnis des jeweiligen Logos
%   zueinander passen.}{
%   Measures the width at which the current logo is actually set at the
%   current navigation-text-block height, and stores it in
%   \cs{g__ltxtalk_tuc_header_logo_width_dim}. The divider, the text, and
%   the left logo column in the narrow layout are all derived from this
%   value, so they stay consistent regardless of the aspect ratio of
%   whichever logo is in effect.}
\dim_new:N \g__ltxtalk_tuc_header_logo_width_dim
\cs_new_protected:Npn \__ltxtalk_tuc_measure_header_logo_width:
  {
    \__ltxtalk_tuc_set_logo_file:
    \hbox_set:Nn \l_tmpa_box
      {
        \file_if_exist:VTF \l__ltxtalk_tuc_logo_file_tl
          {
            \includegraphics
              [height=\__ltxtalk_tuc_header_content_height:,
               keepaspectratio]
              {\l__ltxtalk_tuc_logo_file_tl}
          }
          {\sffamily\bfseries TU~CHEMNITZ}
      }
    \dim_gset:Nn \g__ltxtalk_tuc_header_logo_width_dim {\box_wd:N \l_tmpa_box}
  }
% \ldeen{X-Position des Trennstrichs bzw.\ Startpunkt des Navigationstexts:
%   Randabstand, Logobreite, nochmals Randabstand (Trennstrich), dann noch
%   Strichstärke und Textabstand (Text). So ist der Abstand vom linken Rand
%   zum Logo per Konstruktion gleich dem Abstand vom Logo zum Trennstrich.}{
%   X position of the divider, and the starting point of the navigation
%   text: margin, logo width, margin again (divider), then also rule
%   thickness and text gap (text). This makes the distance from the left
%   edge to the logo equal, by construction, to the distance from the logo
%   to the divider.}
\cs_new:Npn \__ltxtalk_tuc_header_rule_x:
  {
    \dimexpr
      \c__ltxtalk_tuc_header_margin_dim
      +\g__ltxtalk_tuc_header_logo_width_dim
      +\c__ltxtalk_tuc_header_margin_dim
    \relax
  }
\cs_new:Npn \__ltxtalk_tuc_header_text_x:
  {
    \dimexpr
      \__ltxtalk_tuc_header_rule_x:
      +\c__ltxtalk_tuc_header_rule_thickness_dim
      +\c__ltxtalk_tuc_header_text_gap_dim
    \relax
  }
