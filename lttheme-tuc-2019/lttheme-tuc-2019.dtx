% \ldeen{Vermisst die Logobreite bei jeder Darstellung neu, statt sich auf
%   einen zuvor (etwa von \cs{tucnarrowframe}) eingetragenen Wert zu
%   verlassen: Titelseiten setzen Kopfzeilenhöhe und Zeilenzahl über einen
%   eigenen Mechanismus, ohne die Breite eigens neu zu berechnen. Ohne
%   diese Vermessung stünde der Trennstrich auf Titelseiten zu weit links
%   und würde in ein (bei drei Zeilen) breiteres Logo hineinragen.}{
%   Re-measures the logo width on every display instead of relying on a
%   value entered earlier (say, by \cs{tucnarrowframe}): title pages set
%   the header height and row count through their own mechanism, without
%   separately recomputing the width. Without this measurement, the
%   divider on title pages would sit too far left and intrude into a (with
%   three rows) wider logo.}
\cs_new_protected:Npn \__ltxtalk_tuc_logo:
  {
    \__ltxtalk_tuc_measure_header_logo_width:
    \file_if_exist:VTF \l__ltxtalk_tuc_logo_file_tl
      {
        \includegraphics
          [height=\__ltxtalk_tuc_header_content_height:,
           keepaspectratio]
          {\l__ltxtalk_tuc_logo_file_tl}
      }
      {\sffamily\bfseries TU~CHEMNITZ}
  }
\cs_new_protected:Npn \__ltxtalk_tuc_title_logo:
  {
    \file_if_exist:VTF \g__ltxtalk_tuc_title_logo_tl
      {
        \includegraphics[width=2.485cm]{\g__ltxtalk_tuc_title_logo_tl}
      }
      {}
  }
% \ldeen{Wie bei \code{section} entscheidet \cs{LTXTalkHeaderRows} über
%   zwei oder drei Zeilen; ohne diese Abfrage würde \code{title} bei
%   gesetztem Untertitel stets die dritte Zeile befüllen und sie damit
%   auch im Zweizeilenmodus über den unteren Rand der Kopfzeile
%   hinausschieben.}{
%   As with \code{section}, \cs{LTXTalkHeaderRows} decides between two and
%   three lines; without this check, \code{title} would always populate
%   the third line whenever a subtitle is set, pushing it past the
%   header's bottom edge even in two-line mode.}
\cs_new_protected:Npn \__ltxtalk_tuc_header_line:n #1
  {
    \str_case:VnF \g__ltxtalk_tuc_header_instance_tl
      {
        {title}
          {\int_compare:nNnTF {\LTXTalkHeaderRows} = {3}
            {\int_case:nnF {#1}
              {
                {1}{\UseLTXTalkMetadata[lines=1]{short-title}}
                {2}{\tl_if_blank:eTF{\LTXTalkMetadata{short-subtitle}}
                      {\UseLTXTalkMetadata[lines=1]{short-institute}}
                      {\UseLTXTalkMetadata[lines=1]{short-subtitle}}}
                {3}{\tl_if_blank:eF{\LTXTalkMetadata{short-subtitle}}
                      {\UseLTXTalkMetadata[lines=1]{short-institute}}}
              }{}}
            {\int_case:nnF {#1}
              {
                {1}{\UseLTXTalkMetadata[lines=1]{short-title}}
                {2}{\UseLTXTalkMetadata[lines=1]{short-subtitle}}
              }{}}}
        {section}
          {\int_compare:nNnTF {\LTXTalkHeaderRows} = {3}
            {\int_case:nn {#1}
              {{1}{\UseLTXTalkMetadata[lines=1]{short-title}}
               {2}{\UseLTXTalkMetadata[lines=1]{section}}
               {3}{\UseLTXTalkMetadata[lines=1]{subsection}}}}
            {\int_case:nn {#1}
              {{1}{\UseLTXTalkMetadata[lines=1]{section}}
               {2}{\UseLTXTalkMetadata[lines=1]{subsection}}}}}
        {teaching}{\__ltxtalk_tuc_teaching_header_line:n {#1}}
        {custom}
          {\int_case:nn {#1}
            {{1}{\tl_use:N \g__ltxtalk_tuc_header_line_one_tl}
             {2}{\tl_use:N \g__ltxtalk_tuc_header_line_two_tl}
             {3}{\tl_use:N \g__ltxtalk_tuc_header_line_three_tl}}}
      }
      {\int_case:nn {#1}
        {{1}{\UseLTXTalkMetadata[lines=1]{short-title}}
         {2}{\UseLTXTalkMetadata[lines=1]{short-subtitle}}
         {3}{\UseLTXTalkMetadata[lines=1]{short-institute}}}}
  }
\cs_new_protected:Npn \__ltxtalk_tuc_teaching_header_line:n #1
  {
    \int_compare:nNnTF {\LTXTalkHeaderRows} = {3}
      {\int_case:nn {#1}
        {{1}{\cs_if_exist:NTF \g__osglecture_metadata_course_tl
                {\tl_use:N \g__osglecture_metadata_course_tl}
                {\UseLTXTalkMetadata[lines=1]{short-title}}}
         {2}{\cs_if_exist:NTF \g__osglecture_unit_title_tl
                {\tl_use:N \g__osglecture_unit_title_tl}
                {\UseLTXTalkMetadata[lines=1]{section}}}
         {3}{\UseLTXTalkMetadata[lines=1]{subsection}}}}
      {\int_case:nn {#1}
        {{1}{\cs_if_exist:NTF \g__osglecture_metadata_course_tl
                {\tl_use:N \g__osglecture_metadata_course_tl}
                {\UseLTXTalkMetadata[lines=1]{short-title}}
              ~--~
              \cs_if_exist:NTF \g__osglecture_unit_title_tl
                {\tl_use:N \g__osglecture_unit_title_tl}
                {\UseLTXTalkMetadata[lines=1]{section}}}
         {2}{\UseLTXTalkMetadata[lines=1]{subsection}}}}
  }

\cs_new_protected:Npn \__ltxtalk_tuc_theme_setup:
  {
    \DeclareLTXTalkLayout{tuc-2019-wide}
      {left-margin=false}
    % \ldeen{Breite und Content-Einzug der schmalen Spalte folgen der
    %   vermessenen Logobreite (\cs{__ltxtalk_tuc_header_rule_x:} bzw.\
    %   \cs{__ltxtalk_tuc_header_text_x:}), damit die Logos der linken
    %   Spalte per Konstruktion links- und rechtsbündig zum Kopfzeilenlogo
    %   stehen.}{
    %   The narrow column's width and content inset follow the measured
    %   logo width (\cs{__ltxtalk_tuc_header_rule_x:} and
    %   \cs{__ltxtalk_tuc_header_text_x:} respectively), so the left
    %   column's logos are, by construction, left- and right-aligned with
    %   the header logo.}
    \DeclareLTXTalkLayout{tuc-2019-narrow}
      {
        left-margin=true,
        left-area-width=\__ltxtalk_tuc_header_rule_x:,
        content-inset-left=\__ltxtalk_tuc_header_text_x:
      }
    \DeclareLTXTalkLayout{tuc-2019-header-two}
      {header-height=1.45cm,header-rows=2}
    \DeclareLTXTalkLayout{tuc-2019-header-three}
      {header-height=2cm,header-rows=3}
    \ltxtalksetup
      {
        header = true,
        header-height = 1.45cm,
        header-rows = 2,
        left-margin = false,
        right-margin = false,
        footer = true,
        footer-height = 0.52cm
      }
    % \ldeen{Logo, Trennstrich und Navigationszeilen der Kopfzeile werden
    %   nicht mehr über ein Raster positioniert (siehe unten), aber
    %   \cs{MakeLTXTalkTitle} der Themenengine erwartet dennoch einen
    %   Eintrag für \code{header} in der internen Zeilenzahl-Property, um
    %   ihn für die Dauer der Titelseite zu sichern und danach
    %   wiederherzustellen. Ein einmaliger Platzhalterwert genügt dafür.}{
    %   The logo, divider, and navigation lines of the header are no
    %   longer positioned via a grid (see below), but the theme engine's
    %   \cs{MakeLTXTalkTitle} still expects a \code{header} entry in the
    %   internal row-count property, to save and restore it for the
    %   duration of the title page. A one-time placeholder value is
    %   sufficient for that.}
    \SetLTXTalkAreaGridRows{header}{2}
    \__ltxtalk_tuc_measure_header_logo_width:

    \setltxtalkcolors
      {
        secondary = {model=HTML,value=333333},
        accent = {model=HTML,value=F07D00},
        text = {model=RGB,value={0,0,0}},
        background = {model=RGB,value={255,255,255}}
      }

    \exp_args:Nne   \color_set:nn {ltxtalk-primary}   { tuccolor@ \g_ltxtalk_tuc_fak_color }
    \exp_args:Nne   \color_set:nn {tuccolor}          { tuccolor@ \g_ltxtalk_tuc_fak_color }
    \exp_args:Nne   \color_set:nn {ltxtalk-secondary} { tuccolor@scnd@ \g_ltxtalk_tuc_fak_color  }
    \exp_args:Nne   \color_set:nn { structure }       { tuccolor@ \g_ltxtalk_tuc_fak_color  }
    \exp_args:Nne   \color_set:nn { tuccolor@info }   { tuccolor@info@  \g_ltxtalk_tuc_func_color }
    \exp_args:Nne   \color_set:nn { tuccolor@warning }{ tuccolor@warning@  \g_ltxtalk_tuc_func_color }
    \exp_args:Nne   \color_set:nn { tuccolor@danger } { tuccolor@danger@  \g_ltxtalk_tuc_func_color }
    \color_set:nn {alert} {tuccolor@warning}
    \color_set:nn {example} {tuccolor@info}
    
    \setltxtalktitleplacement{frametitle=content,section=none}

    % \ldeen{Logo, Trennstrich und Navigationszeilen werden nicht mehr über
    %   ein Zeilenraster, sondern über explizite, aus der Logobreite und
    %   der Höhe des Textblocks berechnete Positionen gesetzt. Das erzwingt
    %   die fünf Ausrichtungsbedingungen (Ober-/Unterkante von Logo,
    %   Trennstrich und Text; horizontale Ränder; vertikale Zentrierung
    %   gegenüber der sichtbaren Kopfzeilenfläche) durch Konstruktion statt
    %   durch Annäherung.}{
    %   The logo, divider, and navigation lines are no longer positioned
    %   via a row grid but via explicit positions computed from the logo
    %   width and the text block's height. This enforces the five
    %   alignment requirements (top/bottom edges of the logo, divider, and
    %   text; horizontal margins; vertical centering against the visible
    %   header area) by construction rather than by approximation.}
    \defineltxtalkslot{tuc-header-logo}{header}{custom}{role=artifact}
    \setltxtalkslotcontent{tuc-header-logo}{\__ltxtalk_tuc_logo:}
    \positionltxtalkslot{tuc-header-logo}
      {\c__ltxtalk_tuc_header_margin_dim}
      {\__ltxtalk_tuc_header_y_offset:}
      {\g__ltxtalk_tuc_header_logo_width_dim}
      {\__ltxtalk_tuc_header_content_height:}
    \styleltxtalkslot{tuc-header-logo}{align=left,color=white}

    \defineltxtalkslot{tuc-header-rule}{header}{custom}{role=artifact}
    \setltxtalkslotcontent{tuc-header-rule}
      {\color{white}\rule{\c__ltxtalk_tuc_header_rule_thickness_dim}
        {\__ltxtalk_tuc_header_content_height:}}
    \positionltxtalkslot{tuc-header-rule}
      {\__ltxtalk_tuc_header_rule_x:}
      {\__ltxtalk_tuc_header_y_offset:}
      {\c__ltxtalk_tuc_header_rule_thickness_dim}
      {\__ltxtalk_tuc_header_content_height:}
    \styleltxtalkslot{tuc-header-rule}{align=center,color=white}

    \int_step_inline:nn {3}
      {
        \defineltxtalkslot{tuc-header-##1}{header}{custom}{role=navigation}
        \setltxtalkslotcontent{tuc-header-##1}
          {\__ltxtalk_tuc_header_line:n {##1}}
        \positionltxtalkslot{tuc-header-##1}
          {\__ltxtalk_tuc_header_text_x:}
          {\dimexpr
            \__ltxtalk_tuc_header_y_offset:
            +\c__ltxtalk_tuc_header_line_dim*(##1-1)
           \relax}
          {\dimexpr
            \paperwidth-\__ltxtalk_tuc_header_text_x:
            -\c__ltxtalk_tuc_header_margin_dim
           \relax}
          {\c__ltxtalk_tuc_header_line_dim}
        \styleltxtalkslot{tuc-header-##1}
          {align=left,color=white,font=\footnotesize\sffamily}
      }

    \DeclareLTXTalkTitleLayout{tuc-2019/osg}
      {header=true,header-height=2.4cm,header-rows=3,footer=false}
      {\__ltxtalk_tuc_title_osg:}
    \DeclareLTXTalkTitleLayout{tuc-2019/talk}
      {header=true,header-height=2.4cm,header-rows=3,footer=false}
      {\__ltxtalk_tuc_title_talk:}
    \DeclareLTXTalkTitleLayout{tuc-2019/image}
      {header=true,header-height=2.4cm,header-rows=3,footer=false}
      {\__ltxtalk_tuc_title_image:}
    \UseLTXTalkTitleLayout{tuc-2019/osg}

    \styleltxtalkslot{tuc-header-1}
      {align=left,color=white,font=\footnotesize\sffamily}

    \defineltxtalkslot{tuc-frametitle}{content}{frametitle}
      {role=heading,heading-level=2}
    \positionltxtalkslot{tuc-frametitle}{left}{top}{\textwidth}{0.9cm}
    \styleltxtalkslot{tuc-frametitle}
      {align=left,color=ltxtalk-primary,font=\Large\sffamily}

    \defineltxtalkslot{tuc-framesubtitle}{content}{framesubtitle}
      {role=heading,heading-level=3}
    \positionltxtalkslot{tuc-framesubtitle}{left}{top}{\textwidth}{0.55cm}
    \styleltxtalkslot{tuc-framesubtitle}
      {align=left,color=ltxtalk-secondary,font=\normalsize\sffamily}

    % \ldeen{Jedes Logo der linken Spalte wird auf die vermessene Breite des
    %   Kopfzeilenlogos gesetzt und dort mit demselben Randabstand
    %   platziert wie das Kopfzeilenlogo selbst, damit beide unabhängig vom
    %   Seitenverhältnis links- und rechtsbündig zueinander stehen.}{
    %   Every logo in the left column is set to the measured width of the
    %   header logo and placed there with the same margin as the header
    %   logo itself, so the two stay left- and right-aligned regardless of
    %   aspect ratio.}
    \defineltxtalkslot{tuc-left-logos}{left}{logo}{role=artifact,alt-text=Logos}
    \setltxtalkslotcontent{tuc-left-logos}
      {
        \seq_map_inline:Nn \g__ltxtalk_tuc_left_logos_seq
          {\file_if_exist:nT {##1}
            {\includegraphics[width=\g__ltxtalk_tuc_header_logo_width_dim]{##1}\\[0.3cm]}}
      }
    \positionltxtalkslot{tuc-left-logos}
      {\c__ltxtalk_tuc_header_margin_dim}{top}
      {\g__ltxtalk_tuc_header_logo_width_dim}{\textheight}
    \styleltxtalkslot{tuc-left-logos}{align=left}

    \defineltxtalkslot{tuc-author}{footer}{custom}{role=note}
    \setltxtalkslotcontent{tuc-author}{\LTXTalkMetadata{short-author}}
    \positionltxtalkslot{tuc-author}{0.4cm}{center}{0.36\paperwidth}{0.32cm}
    \styleltxtalkslot{tuc-author}
      {align=left,color=ltxtalk-secondary,font=\tiny\sffamily}

    \defineltxtalkslot{tuc-page}{footer}{custom}{role=navigation}
    \setltxtalkslotcontent{tuc-page}
      {N~--~\LTXTalkMetadata{framenumber}\ von~\LTXTalkMetadata{totalframes}}
    \positionltxtalkslot{tuc-page}{center}{center}{0.22\paperwidth}{0.32cm}
    \styleltxtalkslot{tuc-page}
      {align=center,color=ltxtalk-secondary,font=\tiny\sffamily}

    \defineltxtalkslot{tuc-url}{footer}{custom}{role=note}
    \setltxtalkslotcontent{tuc-url}{\tl_use:N \g__ltxtalk_tuc_url_tl}
    \positionltxtalkslot{tuc-url}
      {\dim_eval:n{\paperwidth-0.4cm-0.36\paperwidth}}
      {center}{0.36\paperwidth}{0.32cm}
    \styleltxtalkslot{tuc-url}
      {align=right,color=ltxtalk-secondary,font=\tiny\sffamily}

    \decorateltxtalkarea{header}
      {background=ltxtalk-primary,frame=none,artifact-type=layout}
    \decorateltxtalkarea{footer}
      {
        background=white,
        frame=top,
        rule-color=ltxtalk-secondary,
        rule-thickness=0.35pt,
        artifact-type=layout
      }
  }

% \ldeen{Der Abstand vor dem Textblock wird aus der Kopfzeilengeometrie
%   abgeleitet (Textstart minus Randabstand minus Logospaltenbreite), damit
%   der Titeltextblock exakt dort beginnt, wo auch der Navigationstext der
%   Kopfzeile beginnt (Vorgabe 4: Textblock linksbündig zur Logospalte,
%   analog zum schmalen Layout).}{
%   The gap before the text block is derived from the header geometry
%   (text start minus margin minus logo column width), so the title text
%   block starts exactly where the header's navigation text starts
%   (requirement 4: text block left-aligned with the logo column, matching
%   the narrow layout). This requires a fresh, synchronous measurement of
%   the logo width here: \cs{MakeLTXTalkTitle} sets the title's own
%   header-height and -rows synchronously, but the header itself (and thus
%   the deferred logo measurement inside \cs{__ltxtalk_tuc_logo:}) is only
%   built later, at shipout; without re-measuring here, this text block
%   would compute its gap from whichever width the previous frame's
%   header last left behind.}
\cs_new_protected:Npn \__ltxtalk_tuc_title_osg:
  {
    \__ltxtalk_tuc_measure_header_logo_width:
    \vspace*{2.75cm}\noindent
    \skip_horizontal:n
      {\dim_eval:n{\c__ltxtalk_tuc_header_margin_dim-\LTXTalkCurrentLeftMargin}}
    \begin{minipage}[t]{2.485cm}
      \vspace{0pt}\par\vspace{\dim_eval:n{-\g__ltxtalk_tuc_title_logo_raise_dim}}
      \centering\__ltxtalk_tuc_title_logo:
    \end{minipage}
    \skip_horizontal:n
      {
        \dim_eval:n
          {
            \__ltxtalk_tuc_header_text_x:
            -\c__ltxtalk_tuc_header_margin_dim-2.485cm
          }
      }
    \begin{minipage}[t]{0.62\paperwidth}
      \vspace{0pt}\sffamily
      \Large\bfseries \LTXTalkMetadata{title}\par\vspace{0.8cm}
      \color{ltxtalk-primary}\large \LTXTalkMetadata{subtitle}\par\vspace{0.75cm}
      \normalsize\color{ltxtalk-secondary}\LTXTalkMetadata{author}\par
      \small \LTXTalkMetadata{institute}
    \end{minipage}
  }
\cs_new_protected:Npn \__ltxtalk_tuc_title_talk:
  {
    \vspace*{1.55cm}\centering\sffamily
    {\LARGE\bfseries\color{ltxtalk-primary}\LTXTalkMetadata{title}\par}\medskip
    \tl_if_blank:eF{\LTXTalkMetadata{subtitle}}
      {{\Large\color{ltxtalk-secondary}\LTXTalkMetadata{subtitle}\par}\bigskip}
    {\large\LTXTalkMetadata{author}\par}\smallskip
    {\normalsize\LTXTalkMetadata{institute}\par}\medskip
    {\normalsize\LTXTalkMetadata{date}\par}\bigskip
    \__ltxtalk_tuc_title_logo:
  }
\cs_new_protected:Npn \__ltxtalk_tuc_title_image:
  {
    \vspace*{1.55cm}\raggedright\sffamily
    {\LARGE\bfseries\color{ltxtalk-primary}\LTXTalkMetadata{title}\par}\smallskip
    \tl_if_blank:eF{\LTXTalkMetadata{subtitle}}
      {{\Large\color{ltxtalk-secondary}\LTXTalkMetadata{subtitle}\par}\medskip}
    \file_if_exist:VTF \g__ltxtalk_tuc_title_image_tl
      {\par\nointerlineskip\noindent
       \skip_horizontal:n{-\LTXTalkCurrentLeftMargin}
       \makebox[0pt][l]{\__ltxtalk_tuc_cover_image:Vn
          \g__ltxtalk_tuc_title_image_tl
          {\dim_eval:n{\paperheight-4.55cm}}}
       \par}
      {}
  }
\cs_new_protected:Npn \__ltxtalk_tuc_cover_image:nn #1#2
  {
    \hbox_set:Nn \l_tmpa_box {\includegraphics[width=\paperwidth]{#1}}
    \dim_compare:nNnT
      {\box_ht:N\l_tmpa_box+\box_dp:N\l_tmpa_box} < {#2}
      {\hbox_set:Nn \l_tmpa_box {\includegraphics[height=#2]{#1}}}
    \dim_set:Nn \l__ltxtalk_tuc_crop_x_dim
      {\dim_max:nn{0pt}{(\box_wd:N\l_tmpa_box-\paperwidth)/2}}
    \dim_set:Nn \l_tmpa_dim
      {\dim_max:nn{0pt}
        {\box_ht:N\l_tmpa_box+\box_dp:N\l_tmpa_box-(#2)}}
    \str_case:VnF \g__ltxtalk_tuc_title_image_crop_tl
      {
        {top}
          {\dim_zero:N \l__ltxtalk_tuc_crop_bottom_dim
           \dim_set_eq:NN \l__ltxtalk_tuc_crop_top_dim \l_tmpa_dim}
        {bottom}
          {\dim_set_eq:NN \l__ltxtalk_tuc_crop_bottom_dim \l_tmpa_dim
           \dim_zero:N \l__ltxtalk_tuc_crop_top_dim}
        {center}
          {\dim_set:Nn \l__ltxtalk_tuc_crop_bottom_dim {.5\l_tmpa_dim}
           \dim_set_eq:NN \l__ltxtalk_tuc_crop_top_dim
             \l__ltxtalk_tuc_crop_bottom_dim}
      }
      {\dim_set:Nn \l__ltxtalk_tuc_crop_bottom_dim {.5\l_tmpa_dim}
       \dim_set_eq:NN \l__ltxtalk_tuc_crop_top_dim
         \l__ltxtalk_tuc_crop_bottom_dim}
    \raisebox{-#2}[0pt][0pt]{%
    \begin{tikzpicture}[baseline=0pt]
      \clip (0,0) rectangle (\paperwidth,#2);
      \str_case:VnF \g__ltxtalk_tuc_title_image_crop_tl
        {
          {top}{\node[anchor=south,inner~sep=0pt]
            at (\dim_eval:n{\paperwidth/2},0pt) {\box_use:N \l_tmpa_box};}
          {bottom}{\node[anchor=north,inner~sep=0pt]
            at (\dim_eval:n{\paperwidth/2},#2) {\box_use:N \l_tmpa_box};}
          {center}{\node[anchor=center,inner~sep=0pt]
            at (\dim_eval:n{\paperwidth/2},\dim_eval:n{(#2)/2})
            {\box_use:N \l_tmpa_box};}
        }
        {\node[anchor=center,inner~sep=0pt]
          at (\dim_eval:n{\paperwidth/2},\dim_eval:n{(#2)/2})
          {\box_use:N \l_tmpa_box};}
      \pgfresetboundingbox
      \path[use~as~bounding~box] (0,0) rectangle (\paperwidth,#2);
    \end{tikzpicture}}
  }
\cs_generate_variant:Nn \__ltxtalk_tuc_cover_image:nn {Vn}

\NewDocumentCommand \maketuctitle {}
  {\MakeLTXTalkTitle}

\RenewDocumentCommand \maketitle {O{}}
  {\tl_if_blank:nTF {#1}{\MakeLTXTalkTitle}
    {\MakeLTXTalkTitle[tuc-2019/#1]}}

\RegisterLTXTalkTheme{tuc-2019}{\__ltxtalk_tuc_theme_setup:}
%</pkg>
