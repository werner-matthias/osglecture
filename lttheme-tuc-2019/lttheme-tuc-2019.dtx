\section{\ldeen{Kopfzeile konfigurieren}{Configuring the header}}

\ldeen{Zuerst wird eine Inhaltsinstanz gewählt, danach die Zeilenzahl. Beide
Befehle können unmittelbar vor einem Frame stehen.}{First select a content
instance, then the number of lines. Both commands may appear immediately
before a frame.}

\begin{center}
\begin{tabular}{@{}lll@{}}
\textbf{Instanz} & \textbf{zwei Zeilen} & \textbf{drei Zeilen}\\\hline
\code{title} & Titel / Untertitel & Titel / Untertitel / Institut\\
\code{section} & Section / Subsection & Titel / Section / Subsection\\
\code{teaching} & Kurs--Vorlesung / Section & Kurs / Vorlesung / Section\\
\code{custom} & Zeile 1 / Zeile 2 & Zeile 1 / Zeile 2 / Zeile 3
\end{tabular}
\end{center}

\begin{sourcecode}
  \settucthemeheader{section}
  \tucthreeheader
  \begin{frame}
    \frametitle{Dreizeiliger Section-Header}
  \end{frame}

  \settucthemeheaderlines{Projektname}{Arbeitspaket 2}{Statusbericht}
  \tucthreeheader
  \begin{frame}
    \frametitle{Explizite Kopfzeilen}
  \end{frame}
\end{sourcecode}

\tucdocslide{3}

\section{\ldeen{Inhaltsbreite und linke Logos}{Content width and left logos}}

\ldeen{\cs*{tucwideframe} aktiviert die volle Breite. Mit
\cs*{tucnarrowframe} beginnt der Inhalt auf der Fluchtlinie des Titelblocks.
Die Logos für die linke Fläche werden als kommaseparierte Dateiliste gesetzt;
\cs*{addtucthemeleftlogo} ergänzt ein einzelnes Logo.}{Use
\cs*{tucwideframe} for full width. With \cs*{tucnarrowframe}, content starts
on the title block's alignment line. Set left-area logos as a comma-separated
file list; \cs*{addtucthemeleftlogo} appends one logo.}

\begin{sourcecode}
  \settucthemeleftlogos{
    images/logos/osg.png,
    images/logos/project.pdf
  }
  \tucnarrowframe
  \begin{frame}
    \frametitle{Projektfolie mit Logos}
    Schmaler Inhalt
  \end{frame}

  \tucwideframe
  \begin{frame}
    \frametitle{Die nächste Folie nutzt wieder die volle Breite}
  \end{frame}
\end{sourcecode}

\tucdocslide{4}

\section{\ldeen{Logos und Fußzeile}{Logos and footer}}

\ldeen{Ohne \cs*{settucthemelogo} wählt das Theme das Universitätslogo aus
der Paketoption und der Dokumentsprache. Ein explizit gesetztes Logo hat
Vorrang. Dateipfade sind relativ zur Hauptdatei.}{Without
\cs*{settucthemelogo}, the theme selects the university
logo from the package option and document language. An explicit logo takes
precedence. Paths follow \cs*{includegraphics} and are relative to the main
document.}

\begin{sourcecode}
  \settucthemelogo{images/logos/eigenes-headerlogo.pdf}
  \settucthemetitlelogo{images/logos/veranstaltung.pdf}
  \settucthemetitlelogoraise{0pt}
  \settucthemeurl{\url{https://www.tu-chemnitz.de/}}
\end{sourcecode}

\section{\ldeen{Titelseiten}{Title pages}}

\ldeen{Die Instanz kann dauerhaft mit \cs*{settucthemetitle} oder direkt im
optionalen Argument von \cs*{maketitle} gewählt werden. \cs*{maketitle} steht
außerhalb einer \code{frame}-Umgebung.}{Select the instance persistently with
\cs*{settucthemetitle}, or directly through the optional argument of
\cs*{maketitle}. Use \cs*{maketitle} outside a \code{frame} environment.}

\subsection{\code{osg}}
\begin{sourcecode}
  \settucthemetitlelogo{images/logos/osg.png}
  \settucthemetitlelogoraise{0.21cm}
  \maketitle[osg]
\end{sourcecode}
\tucdocslide{1}

\subsection{\code{talk}}
\begin{sourcecode}
  \settucthemetitlelogo{images/logos/conference.pdf}
  \maketitle[talk]
\end{sourcecode}
\tucdocslide{5}

\subsection{\code{image}}
\begin{sourcecode}
  % top, center oder bottom bestimmt die vertikale Beschnittkante
  \settucthemetitleimage[center]{images/title-photo.jpg}
  \maketitle[image]
\end{sourcecode}
\tucdocslide{6}

\section{\ldeen{Befehlsreferenz}{Command reference}}

\begin{commands}
  \command{settucthemelogo}[\marg{Datei}]
  \ldeen{Überschreibt die automatische Logoauswahl. Weglassen, wenn
    \code{chemnitz2025} und die Dokumentsprache das Logo bestimmen sollen.}
    {Overrides automatic logo selection. Omit it when \code{chemnitz2025}
    and the document language should select the logo.}

  \command{settucthemetitlelogo}[\marg{Datei}]
  \ldeen{Legt das zusätzliche Logo für die Instanzen \code{osg} und
    \code{talk} fest.}{Sets the additional logo for the \code{osg} and
    \code{talk} instances.}

  \command{settucthemetitlelogoraise}[\marg{Länge}]
  \ldeen{Korrigiert transparente Ränder einer Logodatei. Für das OSG-Logo ist
    \code{0.21cm}, für eng beschnittene Dateien gewöhnlich \code{0pt}
    passend.}{Compensates for transparent margins in a logo file. Use
    \code{0.21cm} for the OSG logo and usually \code{0pt} for tightly cropped
    files.}

  \command{settucthemeurl}[\marg{Webadresse}]
  \ldeen{Konfiguriert die Webadresse. Für einen anklickbaren Link
    \cs*{url}\marg{Adresse} übergeben.}{Configures the web address. Pass
    \cs*{url}\marg{address} to make it clickable.}

  \command{maketitle}[\oarg{osg|talk|image}]
  \command{maketuctitle}
  \ldeen{Außerhalb einer \code{frame}-Umgebung aufrufen. Das optionale
    Argument wählt die Instanz. Der Kompatibilitätsbefehl verwendet die zuvor
    gewählte Instanz.}{Use outside a \code{frame} environment. The optional
    argument selects the instance. The compatibility command uses the
    previously selected instance.}

  \command{settucthemeheader}[\marg{Instanz}]
  \command{settucthemeheaderlines}[\marg{Zeile 1}\marg{Zeile 2}\marg{Zeile 3}]
  \ldeen{\code{title}, \code{section}, \code{teaching} oder explizite
    Kopfzeilen mit der Instanz \code{custom}.}{Selects the header instance or
    sets the three lines of the \code{custom} instance.}

  \command{tuctwoheader}
  \command{tucthreeheader}
  \ldeen{Schaltet unmittelbar vor einem Frame zwischen zwei und drei
    Kopfzeilen um.}{Switches between two and three header lines before a frame.}

  \command{tucwideframe}
  \command{tucnarrowframe}
  \command{settucthemeleftlogos}[\marg{kommaseparierte Dateien}]
  \ldeen{Schaltet den Inhaltsbereich um und belegt die linke Fläche der
    schmalen Variante mit einem oder mehreren Logos.}{Switches the content
    width and fills the narrow layout's left area with one or more logos.}

  \command{settucthemetitle}[\marg{Instanz}]
  \command{settucthemetitleimage}[\oarg{Beschnitt}\marg{Datei}]
  \ldeen{Wählt \code{osg}, \code{talk} oder \code{image}. Alternativ kann die
    Instanz auch direkt im optionalen Argument von \cs*{maketitle} gewählt
    werden. Für \code{Beschnitt} sind \code{top}, \code{center} und
    \code{bottom} zulässig.}{Selects the
    \code{osg}, \code{talk}, or \code{image} title page. The optional image
    argument controls vertical cropping.}
\end{commands}


