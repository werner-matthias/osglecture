% \ldeen{Die Logobreite wird neu vermessen, bevor das schmale Layout die
%   linke Spaltenbreite aus \cs{g__ltxtalk_tuc_header_logo_width_dim}
%   übernimmt, damit sie auch bei einer zwischenzeitlich gewechselten
%   Kopfzeilenhöhe oder einem anderen Logo aktuell ist.}{
%   The logo width is re-measured before the narrow layout adopts the
%   left column width from \cs{g__ltxtalk_tuc_header_logo_width_dim}, so it
%   is current even after an intervening header-height or logo change.}
\NewDocumentCommand \tucnarrowframe {}
  {
    \__ltxtalk_tuc_measure_header_logo_width:
    \UseLTXTalkLayout{tuc-2019-narrow}
  }
