\section{\ldeen{Schnellstart}{Quick start}}

\ldeen{Das Theme wird nach der Klasse geladen und anschließend aktiviert.
Paketoptionen gehören an \cs*{usepackage}; alle späteren Umschaltungen gelten
ab dem jeweils folgenden Frame.}{Load the theme after the class and activate
it. Package options belong on \cs*{usepackage}; subsequent switches apply to
the next frame.}

\begin{sourcecode}
  \DocumentMetadata{}
  \documentclass{ltx-talk}
  \usepackage[fakcolor=if,funccolor=adapted]{ltxtalk-theme-tuc-2019}
  \useltxtalktheme{tuc-2019}

  \title[Kurztitel]{Titel der Präsentation}
  \subtitle{Untertitel}
  \author{Vorname Nachname}
  \institute{Institut oder Professur}
  \date{5. August 2026}

  \begin{document}
  \maketitle[osg]
  \begin{frame}
    \frametitle{Erste Folie}
    Inhalt
  \end{frame}
  \end{document}
\end{sourcecode}

\subsection{\ldeen{Paketoptionen}{Package options}}

\begin{description}[style=nextline,leftmargin=3.5cm]
  \item[\code{fakcolor=...}] \code{tuc}, \code{natwi}, \code{ma},
    \code{mb}, \code{etit}, \code{if}, \code{wiwi}, \code{phil} oder
    \code{hsw}; Vorgabe ist \code{tuc}.
  \item[\code{funccolor=...}] \code{original}, \code{adapted} oder
    \code{uniq}; Vorgabe ist \code{adapted}.
  \item[\code{chemnitz2025}] Verwendet das Jubiläumslogo. Bei englischer
    Dokumentsprache wird automatisch \code{tuckhseng\_white} gewählt.
\end{description}

\begin{sourcecode}
  % Fakultät Informatik, angepasste Funktionsfarben, Jubiläumslogo
  \usepackage[
    fakcolor=if,
    funccolor=adapted,
    chemnitz2025
  ]{ltxtalk-theme-tuc-2019}
\end{sourcecode}

