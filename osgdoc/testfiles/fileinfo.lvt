\input regression-test
\documentclass{article}
\usepackage{osgdoc}
\usepackage{hyperref}
\begin{document}
\START
\UseVersionOf{fixture-expl.sty}\quad\UseDateOf{fixture-expl.sty}

\edef\ExplVersion{\UseVersionOf{fixture-expl.sty}}
\edef\ClassicDate{\UseDateOf{fixture-classic.sty}}
\pdfstringdef\FileMetadata
  {\UseVersionOf{fixture-classic.sty}, \UseDateOf{fixture-expl.sty}}
\TYPE{expanded-version=\ExplVersion}
\TYPE{expanded-classic-date=\ClassicDate}

\directlua{
  local function report(key, value)
    texio.write_nl("log", key .. "=" .. tostring(value))
  end

  local expl = fileinfo.getinfo("fixture-expl.sty")
  report("expl-name", expl.name)
  report("expl-date", expl.date)
  report("expl-version", expl.version)
  report("expl-type", expl.type)

  local classic = fileinfo.getinfo("fixture-classic.sty")
  report("classic-name", classic.name)
  report("classic-date", classic.date)
  report("classic-version", classic.version)
  report("classic-type", classic.type)
}
\END
\end{document}
