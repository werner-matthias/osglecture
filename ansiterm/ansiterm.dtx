\section{\ldeen{Nutzung}{Usage}}

\begin{warnbox}{\ldeen{Achtung, Sicherheitsrisiko!}{Attention, Security Risk!}}
\ldee*{Die Umgebung @1 benötigt zur Ausführung die Übersetzung mit @2.
  Dies stellt ein Sicherheitrisiko dar, da damit @3 beliebigen Code auf ihrem System
  ausführen kann. Stellen Sie sicher, dass Sie nur unkritischen Code in den
  Body der Umgebung schreiben.
  }{
  Environment @1 requires the translation with @2 to run.
  This poses a security risk, as it allows @3 to execute arbitrary code on your system.
  Make sure to write only non-critical code in the
  body of the environment.
  }{\code{ansitermexec}}{\texttt{--shell-escape}}{\LuaLaTeX}
\end{warnbox}

\subsection{\ldeen{Beispiele}{Examples}}
\begin{example}%[compile,program=lualatex,exe-with=--shell-escape,
  [side-by-side=true,code-left=true]
    \begin{ansiterm}[escape-char=§]
      §[1;31mred bold text§[0m
    \end{ansiterm}
\end{example}

\begin{example}[compile,program=lualatex,exe-with=--shell-escape]
  \documentclass{article}
  \usepackage{ansiterm}
  \begin{document}
    \begin{ansitermexec}[
      shell=/bin/sh,
      cache=true,
      sandbox=true,
      show-input=true,
      %lines={1-8,12-}
    ]
      printf '\033[1;32mHello\033[0m\n'
      grep --color=always bar <<< 'foo bar baz'
    \end{ansitermexec}
  \end{document}
\end{example}

