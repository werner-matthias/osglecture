\section{\ldeen{Nutzung}{Usage}}

\begin{warnbox}{\ldeen{Achtung, Sicherheitsrisiko!}{Attention, Security Risk!}}
\ldeen*{Die Umgebung @1 benötigt zur Ausführung die Übersetzung mit @2.
  Dies stellt ein Sicherheitrisiko dar, da damit @3 beliebigen Code auf ihrem System
  ausführen kann. Stellen Sie sicher, dass Sie nur unkritischen Code in den
  Body der Umgebung schreiben.
  }{
  Environment @1 requires the translation with @2 to run.
  This poses a security risk, as it allows @3 to execute arbitrary code on your system.
  Make sure to write only non-critical code in the
  body of the environment.
  }{\code{ansitermexec}}{\texttt{--shell-escape}}{Lua\LaTeX}
\end{warnbox}

\ldeen{Laden Sie das Paket auf dem üblichen Weg mit \cs{usepackage}\Marg{ansiterm}. Es gibt keine Paketoptionen.
Das Paket stellt zwei Umgebungen zur Verfügung und benötigt Lua\LaTeX.}{Load the package in the usual way with \cs{usepackage}\Marg{ansiterm}. There are no package options.
The package provides two environments and needs Lua\LaTeX.}

\begin{environments}
  \environment{ansiterm}[\oarg{\ldeen{Optionen}{options}}]\ldeen{Gibt den Inhalt innerhalb eines Terminalfensters aus.}{Displays the content within a terminal window.}
  \environment{ansitermexec}[\oarg{\ldeen{Optionen}{options}}]\ldeen{Gibt den Inhalt zeilenweise an eine zur Ausführung Shell weiter und setzt gibt die Ein- und Ausgabe in einem Terminalfenster aus.}{Passes the content line by line to a shell for execution and displays the input and output in a terminal window. Benötigt zur Übersetzung \option{-{}-shell-escape}} 
\end{environments}

\subsection{\ldeen{Beispiele}{Examples}}
\begin{example}[compile,program=lualatex,exe-with=--shell-escape,
  graphics={trim=30mm 220mm 30mm 40mm,clip,scale=1.2}]
    \documentclass{article}
    \usepackage{ansiterm}
    \begin{document}
      \begin{ansiterm}[escape-char=§]
        §[1;31mred bold text§[0m
      \end{ansiterm}
    \end{document}
\end{example}

\begin{example}[compile,program=lualatex,exe-with=--shell-escape,
  graphics={trim=30mm 200mm 30mm 30mm,clip,scale=1.2}]
  \documentclass{article}
  \usepackage{ansiterm}
  \begin{document}
    \begin{ansitermexec}[
      shell=/bin/sh,
      cache=true,
      sandbox=true,
      show-input=true,
    ]
      printf '\033[1;32mHello\033[0m\n'
      grep --color=always bar <<< 'foo bar baz'
    \end{ansitermexec}
  \end{document}
\end{example}

\subsection{\ldeen{Optionen}{Options}}
\newnote{\xo}{\normalfont\env{ansitermexec}}
\begin{options}
  \keyval{title}{\ldeen{Überschrift des Terminals}{Terminal title}}\Default*{terminal}
  \keyval{fontsize}{\ldeen{Schriftgrößenbefehl}{font size command}}\Default*{\cs{small}}
  \keyval{shell}{\ldeen{Shell}{shell}\xo}\Default{/bin/sh}
  \ldeen{Shell zur Ausführung}{shell for execution}
  \keyval{cwd}{\ldeen{Verzeichnis}{directory}\xo}\Default{.}
  \ldeen{Arbeitsverzeichnis für die Ausführung}{working directory for execution}
  \keychoice{cache}{true, false, refresh}\Default{\xo{}true}
  {\ldeen{Legt fest, ob Ergebnis bei erneuter Übersetzung wiederverwendet wird. 
  \code{refresh} erneuert den Cache.}{Specifies whether the result is reused when the translation is performed again.
  \code{refresh} renews the cache.}}

  \keybool{sandbox}\Default{\xo{}true}
  {\ldeen{Wenn der Schlüssel gesetzt (true) ist, wird der in einem neu angelegten Verzeichnis ausgeführt, das anschließend wieder gelöscht wird. Die Ergebnisse werden trotzdem ggf.\ im Cache behalten.}{If the key is true, the command is executed in a newly created directory, which is then deleted. The results are still cached, if applicable.}}

  \keybool{show-input\xo}\Default{true}
  {\ldeen{Bei \code{false} wird nur die Ausgabe gezeigt.}{If \code{false},  only the output is displayed.}}
  \keyval{prompt}{\ldeen{Prompt}{prompt}\xo}\Default*{\code{\textdollar\textasciitilde}}
  \keyval{escape-char}{\ldeen{Zeichen für ESC}{escape character}}\Default*{\S}
  \keyval{lines}{\ldeen{Zeilenbereich}{line range}}\Default{-}
  {\ldeen{Auswahl der Zeilen, die dargestellt werden.}{Range of lines to display.}}

  \keybool{ellipsis}\Default{true}
  {\ldeen*{Zeigt Auslassungszeichen "`@1"' für übersprungene Zeilen}{Displays ellipsis “`@1”' for skipped lines}{⋮}}

  \keybool{fail-on-error\xo}\Default{true}
  {\ldeen{Erzeugt Fehlermeldung, wenn die die Ausführung einen Fehlerstatus zurück gibt.}{Generates an error message if the execution returns an error status.}}
\end{options}
